{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useGenericFontNames": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn"
			},
			"style": {
				"noDescendingSpecificity": "off"
			},
			"suspicious": {
				"useIterableCallbackReturn": "off"
			}
		}
	}
}
