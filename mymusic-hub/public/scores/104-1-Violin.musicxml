        <pitch>
          <step>C</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>


  
      <!-- B4 (Achtung: Das deutsche 'H' ist in MusicXML immer ein 'B') -->
      <note>
        <pitch>
          <step>B</step>
          <octave>4</octave>
        </pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>
      <!-- A4 -->
      <note>
        <pitch>
