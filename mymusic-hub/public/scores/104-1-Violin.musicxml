  <part id="P1">
    
    <!-- TAKT 1 -->
    <measure number="">
      <attributes>
        <!-- 1 Division = 1 Viertelnote (da beat-type = 4) -->
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats></beats>
          <beat-type></beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      
      <!-- F5 (Oberste Linie) -->
      <note>
        <pitch>
          <step>F</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>
      <!-- E5 -->
      <note>
        <pitch>
          <step>E</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>
      <!-- D5 -->
      <note>
        <pitch>
          <step>D</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <type>quarter</type>
      </note>
      <!-- C5 -->
