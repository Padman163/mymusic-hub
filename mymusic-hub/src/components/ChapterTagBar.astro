---
export interface Props {
  tags?: string[];
  difficulty?: string;
  dLevel?: string;
  xp?: number;
  filterMode?: boolean;
}

const {
  tags = [],
  difficulty,
  dLevel,
  xp,
  filterMode = false
} = Astro.props;

const difficultyColors: Record<string, string> = {
  'Basis': '#4CAF50',
  'Mittel': '#FFC107',
  'Fortgeschritten': '#FF9800',
  'Master': '#F44336'
};

const dLevelColors: Record<string, string> = {
  'D1': '#2196F3',
  'D2': '#1976D2',
  'D3': '#0D47A1',
  'Produktion': '#6A1B9A'
};

const filterOptions = {
  instrument: ['Gitarre', 'Allgemein'],
  dLevel: ['D1-relevant', 'D2-relevant', 'D3-relevant'],
  difficulty: ['Basis', 'Mittel', 'Fortgeschritten', 'Master']
};
---

{filterMode ? (
  <div class="tag-bar filter-mode">
    <div class="filter-section">
      <button class="filter-btn active" data-filter="all">Alle</button>
      {filterOptions.instrument.map((opt) => (
        <button class="filter-btn" data-filter={opt}>{opt}</button>
      ))}
    </div>
    <div class="filter-section">
      <span class="filter-label">Prüfung:</span>
      {filterOptions.dLevel.map((opt) => (
        <button class="filter-btn" data-filter={opt}>{opt}</button>
      ))}
    </div>
    <div class="filter-section">
      <span class="filter-label">Schwierigkeit:</span>
      {filterOptions.difficulty.map((opt) => (
        <button class="filter-btn" data-filter={opt}>{opt}</button>
      ))}
    </div>
  </div>
) : (
  <div class="tag-bar display-mode">
    {tags.length > 0 && (
      <div class="chip-group">
        {tags.map((tag) => (
          <span class="chip" key={tag}>
            {tag === 'Gitarre' && '🎸 '}
            {tag === 'Allgemein' && '📚 '}
            {tag.includes('D1') && '🔵 '}
            {tag.includes('D2') && '🟢 '}
            {tag.includes('D3') && '🔴 '}
            {tag}
          </span>
        ))}
      </div>
    )}
    {difficulty && (
      <div class="chip-group">
        <span class="chip difficulty" style={{ backgroundColor: difficultyColors[difficulty] || '#999' }}>
          📊 {difficulty}
        </span>
      </div>
    )}
    {dLevel && (
      <div class="chip-group">
        <span class="chip d-level" style={{ backgroundColor: dLevelColors[dLevel] || '#999' }}>
          🎯 {dLevel}
        </span>
      </div>
    )}
    {xp && (
      <div class="chip-group">
        <span class="chip xp">
          ⭐ {xp} XP
        </span>
      </div>
    )}
  </div>
)}

<script>
  if (document.body.querySelector('.tag-bar.filter-mode')) {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const filterableItems = document.querySelectorAll('[data-tags]');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter');

        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (filterValue === 'all') {
          filterableItems.forEach((item) => {
            (item as HTMLElement).style.display = '';
          });
        } else {
          filterableItems.forEach((item) => {
            const itemTags = (item as HTMLElement).getAttribute('data-tags')?.split(',') || [];
            if (itemTags.includes(filterValue)) {
              (item as HTMLElement).style.display = '';
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });
        }
      });
    });
  }
</script>

<style>
  .tag-bar {
    margin: 16px 0;
    padding: 12px;
    background-color: #f6f8fa;
    border-radius: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .tag-bar.display-mode {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
  }

  .tag-bar.filter-mode {
    background-color: #f6f8fa;
    flex-direction: column;
    align-items: flex-start;
  }

  .filter-section {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .filter-label {
    font-weight: 600;
    color: #24292e;
    font-size: 0.875rem;
  }

  .filter-btn {
    padding: 6px 12px;
    border: 1px solid #d1d5da;
    border-radius: 4px;
    background-color: #ffffff;
    color: #24292e;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background-color: #e1e4e8;
    border-color: #bbbfc3;
  }

  .filter-btn.active {
    background-color: #0366d6;
    color: #ffffff;
    border-color: #0366d6;
  }

  .chip-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 16px;
    background-color: #f1f3f5;
    color: #24292e;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #d1d5da;
    white-space: nowrap;
  }

  .chip.difficulty,
  .chip.d-level,
  .chip.xp {
    color: #ffffff;
    border: none;
  }

  .chip.xp {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: #333;
  }
</style>
