---
export interface ChordPosition {
  stringIndex: number;
  stringName: string;
  fret: number;
  note: string;
  octave: number;
  role: "root" | "third" | "fourth" | "fifth" | "seventh" | "octave" | "ninth";
}

export interface ChordDiagram {
  bar?: number;
  chord: string;
  degree: string;
  function: string;
  contextLabel?: string;
  positions: ChordPosition[];
}

export interface Props {
  chords: ChordDiagram[];
  keyLabel: string;
  showLegend?: boolean;
  gallery?: boolean;
  compact?: boolean; // NEU: Aktiviert die reine Grid-Ansicht ohne Details
}

const {
  chords,
  keyLabel,
  showLegend = true,
  gallery = false,
  compact = false // Standardmäßig aus
} = Astro.props;

const tuning = ["e", "B", "G", "D", "A", "E"];
const stringY = (index: number) => 22 + index * 18;
const nutX = 58;
const fretWidth = 62;
const colors = {
  root: "#f87171",
  third: "#c084fc",
  fourth: "#f472b6", 
  fifth: "#60a5fa",
  seventh: "#4ade80",
  octave: "#fbbf24",
  ninth: "#2dd4bf"  
};

const roleLabels = {
  root: "Grundton",
  third: "Terz",
  fourth: "Quarte",  
  fifth: "Quinte",
  seventh: "kleine Septime",
  octave: "Oktave",
  ninth: "None"      
};

// 1. Alle verwendeten Rollen sammeln
const usedRoles = new Set<ChordPosition["role"]>();
chords.forEach(chord => {
  chord.positions.forEach(pos => usedRoles.add(pos.role));
});

// 2. Gewünschte Reihenfolge für die Legende festlegen
const roleOrder: ChordPosition["role"][] = ["root", "third", "fourth", "fifth", "seventh", "octave", "ninth"];

// 3. Nur die Rollen behalten, die auch wirklich in den Akkorden vorkommen
const activeLegendRoles = roleOrder.filter(role => usedRoles.has(role));

if (chords.length === 0) {
  throw new Error("Mindestens ein Akkorddiagramm ist erforderlich.");
}

for (const chord of chords) {
  if (chord.positions.length < 2 || !chord.positions.some(({ fret }) => fret > 0) ||
    chord.positions.some(({ stringIndex, fret }) =>
    !Number.isInteger(stringIndex) || stringIndex < 0 || stringIndex >= tuning.length ||
    !Number.isInteger(fret) || fret < 0
    )) {
    throw new Error(`Ungültige Griffbrettpositionen für ${chord.chord}.`);
  }
}
---

<!-- Klasse 'is-compact' wird hinzugefügt, wenn der compact-Prop true ist -->
<div class:list={["chord-gallery", { "is-gallery": gallery, "is-compact": compact }]}>
  {gallery && !compact && (
    <nav
      class="chord-gallery-nav"
      aria-label={`Akkorde in ${keyLabel}`}
      style={`--chord-count: ${chords.length};`}
    >
      {chords.map((chord, index) => (
        <button
          class="gallery-button"
          type="button"
          data-chord-index={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {chord.chord}
        </button>
      ))}
    </nav>
  )}

  <div class="chord-diagrams" aria-label={`Gitarrengriffe in ${keyLabel}`}>
  {chords.map((chord, index) => {
    const frettedPositions = chord.positions.filter(({ fret }) => fret > 0);
    const firstPlayedFret = Math.min(...frettedPositions.map(({ fret }) => fret));
    const lastPlayedFret = Math.max(...frettedPositions.map(({ fret }) => fret));
    const visibleFirstFret = lastPlayedFret - firstPlayedFret + 1 < 2
      ? Math.max(1, firstPlayedFret - 1)
      : firstPlayedFret;
    const fretCount = lastPlayedFret - visibleFirstFret + 1;
    const playedStrings = new Set(chord.positions.map(({ stringIndex }) => stringIndex));

    return (
        <article
          class="chord-card"
          aria-label={`${chord.chord}${!compact ? `: ${chord.degree} ${chord.function}` : ""}`}
          hidden={gallery && !compact && index !== 0}
          style={gallery && !compact ? "grid-area: 1 / 1;" : undefined}
        >
          <header class="chord-heading">
            {/* Stufe und Funktion nur anzeigen, wenn NICHT compact */}
            {!compact && <span class="degree-label">{chord.degree} · {chord.function}</span>}
            <h4>{chord.chord}</h4>
          </header>

        <svg
          class="fretboard"
          viewBox="0 0 320 168"
          role="img"
          aria-label={`${chord.chord}: ${chord.positions.map(({ note, octave, stringName, fret }) =>
            `${note}${octave} auf ${stringName}-Saite, ${fret === 0 ? "offen" : `Bund ${fret}`}`
          ).join(" und ")}`}
        >
          <rect
            x={nutX}
            y="13"
            width={fretCount * fretWidth}
            height="108"
            rx="3"
            fill="#18181b"
            stroke="#3f3f46"
            stroke-width="1"
          />
          {tuning.map((stringName, stringIndex) => (
            <>
              <text class="string-label" x="14" y={stringY(stringIndex) + 4}>{stringName}</text>
              <line
                x1={nutX}
                y1={stringY(stringIndex)}
                x2={nutX + fretCount * fretWidth}
                y2={stringY(stringIndex)}
                stroke="#a1a1aa"
                stroke-width={stringIndex === 5 ? 2.4 : 1.4}
              />
              {!playedStrings.has(stringIndex) && (
                <text class="muted-string" x="38" y={stringY(stringIndex) + 4}>×</text>
              )}
            </>
          ))}
          {Array.from({ length: fretCount + 1 }, (_, index) => {
            const x = nutX + index * fretWidth;
            return (
              <line
                x1={x}
                y1="13"
                x2={x}
                y2="121"
                stroke={visibleFirstFret === 1 && index === 0 ? "#f4f4f5" : "#52525b"}
                stroke-width={visibleFirstFret === 1 && index === 0 ? 4 : 2}
              />
            );
          })}
          {Array.from({ length: fretCount }, (_, index) => {
            const fret = visibleFirstFret + index;
            const x = nutX + (index + 0.5) * fretWidth;
            return <text class="fret-label" x={x} y="143">{fret}</text>;
          })}
          {chord.positions.map(({ stringIndex, fret, note, role }) => {
            const x = fret === 0
              ? 38
              : nutX + (fret - visibleFirstFret + 0.5) * fretWidth;
            const y = stringY(stringIndex);
            return (
              <g>
                <circle cx={x} cy={y} r="12" fill={colors[role]} />
                <text class="note-label" x={x} y={y + 4}>{note}</text>
              </g>
            );
          })}
        </svg>

          {/* Detail-Toggle-Button nur anzeigen, wenn NICHT compact */}
          {!compact && (
            <button
              class="detail-toggle"
              type="button"
              aria-expanded="false"
              aria-controls={`chord-notes-${keyLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${index}`}
              data-chord-index={index}
              aria-label={`Griffdetails für ${chord.chord}`}
            >
              <span>Töne und Griffdetails</span>
              <svg class="disclosure-icon" viewBox="0 0 20 20" aria-hidden="true">
                <path d="m5 7.5 5 5 5-5" />
              </svg>
            </button>
          )}
        </article>
    );
  })}
  </div>
  
  {/* Detail-Panels nur generieren, wenn NICHT compact */}
  {!compact && chords.map((chord, index) => (
    <div
      class="tone-panel"
      id={`chord-notes-${keyLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${index}`}
      data-chord-index={index}
      hidden
    >
      <ul class="tone-list">
        {chord.positions.map(({ stringName, fret, note, octave, role }) => (
          <li>
            <span class={`tone-dot ${role}`} aria-hidden="true"></span>
            <span>{roleLabels[role]}: {note}{octave} · {stringName}-Saite, {fret === 0 ? "offen (0)" : `Bund ${fret}`}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

{showLegend && (
  <p class="diagram-legend">
    {activeLegendRoles.map((role) => (
      <span><i class={`legend-dot ${role}`}></i>{roleLabels[role]}</span>
    ))}
    <span>× = nicht spielen</span>
  </p>
)}

<script>
  // Script bleibt exakt gleich, da der Detail-Toggle Button im Compact-Modus nicht existiert
  // und somit die Klick-Events sicher ignoriert werden.
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const detailToggle = target.closest<HTMLButtonElement>(".detail-toggle");
    if (detailToggle) {
      const gallery = detailToggle.closest<HTMLElement>(".chord-gallery");
      const group = gallery?.querySelector<HTMLElement>(".chord-diagrams");
      const chordIndex = detailToggle.dataset.chordIndex;
      const panel = gallery?.querySelector<HTMLElement>(`.tone-panel[data-chord-index="${chordIndex}"]`);
      if (!gallery || !group || chordIndex === undefined || !panel) {
        throw new Error("Die Griffdetails-Karte ist unvollständig.");
      }

      const shouldOpen = detailToggle.getAttribute("aria-expanded") !== "true";
      group.querySelectorAll<HTMLButtonElement>(".detail-toggle[aria-expanded='true']").forEach((otherToggle) => {
        if (otherToggle === detailToggle) return;
        otherToggle.setAttribute("aria-expanded", "false");
        const otherPanel = gallery.querySelector<HTMLElement>(`.tone-panel[data-chord-index="${otherToggle.dataset.chordIndex}"]`);
        if (otherPanel) otherPanel.hidden = true;
      });

      detailToggle.setAttribute("aria-expanded", String(shouldOpen));
      panel.hidden = !shouldOpen;
      return;
    }

    const button = target.closest<HTMLButtonElement>(".gallery-button");
    const gallery = button?.closest(".chord-gallery.is-gallery");
    if (!button || !gallery) return;

    const selectedIndex = Number(button.dataset.chordIndex);
    if (!Number.isInteger(selectedIndex) || selectedIndex < 0) {
      throw new Error("Akkord-Galerie-Schaltfläche hat keinen gültigen Index.");
    }

    const cards = gallery.querySelectorAll<HTMLElement>(".chord-card");
    if (selectedIndex >= cards.length) {
      throw new Error("Akkord-Galerie-Schaltfläche verweist auf keinen Akkord.");
    }

    gallery.querySelectorAll<HTMLButtonElement>(".gallery-button").forEach((item) => {
      const selected = Number(item.dataset.chordIndex) === selectedIndex;
      item.setAttribute("aria-pressed", String(selected));
    });
    cards.forEach((card, index) => {
      card.hidden = index !== selectedIndex;
      const detailToggle = card.querySelector<HTMLButtonElement>(".detail-toggle");
      detailToggle?.setAttribute("aria-expanded", "false");
    });
    gallery.querySelectorAll<HTMLElement>(".tone-panel").forEach((panel) => {
      panel.hidden = true;
    });
  });
</script>

