      { id: "3-4-8-mixed", answer: "Anschläge liegen auf „1“, „2&“ und „3&“.", options: ["Anschläge liegen auf „1“, „2&“ und „3&“.", "Anschläge liegen auf „1“, „2“ und „3&“.", "Anschläge liegen auf „1&“, „2&“ und „3&“."], timeSignature: "3/4", resolution: "1/8", steps: 6, activeSteps: [0, 3, 5] },
      { id: "2-4-16-mixed", answer: "Anschläge liegen auf „1e“, „1a“ und „2&“.", options: ["Anschläge liegen auf „1e“, „1a“ und „2&“.", "Anschläge liegen auf „1e“, „1a“ und „2“.", "Anschläge liegen auf „1e“, „1&“ und „2&“."], timeSignature: "2/4", resolution: "1/16", steps: 8, activeSteps: [1, 3, 6] },
      { id: "2-4-8-offbeats", answer: "Je ein Anschlag liegt auf „1&“ und „2&“.", options: ["Je ein Anschlag liegt auf „1&“ und „2&“.", "Je ein Anschlag liegt auf „1&“ und „2“.", "Je ein Anschlag liegt auf „1“ und „2&“."], timeSignature: "2/4", resolution: "1/8", steps: 4, activeSteps: [1, 3] },
      { id: "6-8-16-mixed", answer: "Anschläge liegen auf „1“, „2&“, „4“ und „6&“.", options: ["Anschläge liegen auf „1“, „2&“, „4“ und „6&“.", "Anschläge liegen auf „1“, „2&“, „4&“ und „6&“.", "Anschläge liegen auf „1“, „2“, „4“ und „6&“."], timeSignature: "6/8", resolution: "1/16", steps: 12, activeSteps: [0, 3, 6, 11] },
      { id: "6-8-8-mixed", answer: "Drei Achtelanschläge liegen auf den Positionen 1, 3 und 5.", options: ["Drei Achtelanschläge liegen auf den Positionen 1, 3 und 5.", "Drei Achtelanschläge liegen auf den Positionen 1, 3 und 6.", "Drei Achtelanschläge liegen auf den Positionen 1, 4 und 5."], timeSignature: "6/8", resolution: "1/8", steps: 6, activeSteps: [0, 2, 4] }
    ]
  }
};

function rhythmLayoutId(timeSignature: string, resolution: string): string {
  return `${timeSignature.replace("/", "-")}-${resolution.replace("/", "-")}`;
}

const patternLayouts = Array.from(new Map(
  Object.values(questionBanks).flatMap(({ patterns }) => patterns.map((pattern) => {
    const id = rhythmLayoutId(pattern.timeSignature, pattern.resolution);
    return [id, {
      id,
      timeSignature: pattern.timeSignature,
      resolution: pattern.resolution,
      steps: pattern.steps
    }] as const;
  }))
).values());

const totalPoints = 21;
const passingPoints = Math.ceil(totalPoints * 0.8);

---

<div
  class="level-100-quiz"
  data-level-100-quiz
  data-question-bank={JSON.stringify(questionBanks).replaceAll("<", "\\u003c")}
  data-total-points={totalPoints}
  data-passing-points={passingPoints}
>
  <p>
    Jede Runde stellt zufällig ausgewählte Fragen aus einem größeren Level-100-Fragenkatalog.
    Die Aufgabe zum Rhythmuspattern zählt als eine Frage. Zum Bestehen brauchst du mindestens
    <strong><span class="passing-points">{passingPoints}</span> richtige Punkte (80 %)</strong> von
    <strong><span class="total-points">{totalPoints}</span> Punkten</strong>. Nicht beantwortete Aufgaben zählen als falsch.
  </p>

  <div class="difficulty-controls" role="group" aria-label="Quizschwierigkeit">
    <button class="difficulty-button" type="button" data-difficulty="1" aria-pressed="true">Schwierigkeit 1</button>
    <button class="difficulty-button" type="button" data-difficulty="2" aria-pressed="false" disabled>
      Schwierigkeit 2 (nach bestandenem Quiz)
    </button>
    <p class="difficulty-status" aria-live="polite">Schwierigkeit 1: Grundlagen</p>
  </div>

  <form>
    <section class="quiz-stage">
      <h2>Teil 1: Grundlagen</h2>
      <p>Wähle jeweils eine Antwort aus.</p>
      <div class="basics-list"></div>
    </section>

    <section class="quiz-stage">
      <h2>Teil 2: Töne auf dem Griffbrett</h2>
      <p>Ziehe die fünf Noten auf eine passende Stelle im Griffbrett. Ein Ton kann an mehreren Stellen liegen. Die tiefe E-Saite ist unten, die hohe e-Saite oben.</p>
      <figure class="fretboard-figure">
        <FretboardClickable readOnly showNoteNames={false} fixedPositions={[]} dropTargets={true} />
        <figcaption>Ziehe eine Note auf einen Bund oder wähle die Note und anschließend eine Stelle. Die farbigen Bundmarkierungen sind eine Orientierungshilfe.</figcaption>
      </figure>
      <div class="fretboard-note-tray" role="group" aria-label="Noten zum Platzieren"></div>
      <p class="fretboard-feedback" aria-live="polite"></p>
    </section>

    <section class="quiz-stage">
      <h2>Teil 3: Rhythmus und Takt</h2>
      <p>Wähle jeweils eine Antwort aus.</p>
      <div class="rhythm-list"></div>
    </section>

    <section class="quiz-stage">
      <h2>Rhythmus erkennen</h2>
      <p>Sieh dir das Pattern an und wähle die passende Aussage aus.</p>
      <div class="rhythm-patterns" role="img" aria-label="Rhythmuspattern">
        {patternLayouts.map((layout, index) => (
          <div
            class="pattern-candidate"
            data-layout={layout.id}
            hidden={index !== 0}
          >
            <DrumPattern
              steps={layout.steps}
              timeSignature={layout.timeSignature}
              resolution={layout.resolution}
              interactive={false}
              showTrackNote={false}
              useTrackColors={true}
              keepEmptyTracks={true}
              stepLabels={Array.from({ length: layout.steps }, () => '')}
              patternData={[
                { name: 'Rhythmus', note: '', color: '#38bdf8', activeSteps: [] }
              ]}
            />
          </div>
        ))}
      </div>
      <div class="pattern-question"></div>
    </section>

    <section class="quiz-stage">
      <h2>Teil 4: Notation in fünf zufälligen Beispielen</h2>
      <p>Pro Runde wird aus fünf Bereichen je ein MusicXML-Beispiel ausgewählt. Lies die Standardnotation oder Tabulatur und beantworte die Frage.</p>
      <div class="notation-list">
        <div class="musicxml-question-bank">
          {questionBanks["1"].notation.map((item) => (
            <fieldset class="quiz-question notation-question musicxml-question" data-question-id={item.id} data-answer={item.answer} hidden>
              <legend>{item.prompt}</legend>
              {item.musicXmlUrl && <SheetMusicPlayer musicXmlUrl={item.musicXmlUrl} showControls={false} />}
              <div class="answer-options">
                {item.options.map((option) => (
                  <label class="answer-option">
                    <input type="radio" name={`musicxml-${item.id}`} value={option} />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
              <p class="question-feedback" aria-live="polite"></p>
            </fieldset>
          ))}
        </div>
        <div class="advanced-notation-list" hidden></div>
      </div>
    </section>

    <div class="quiz-actions">
      <button class="submit-quiz" type="submit">Quiz auswerten</button>
      <button class="reset-quiz" type="button">Neu starten</button>
    </div>
    <p class="quiz-result" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
