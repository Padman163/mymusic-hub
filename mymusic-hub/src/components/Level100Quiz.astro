<script>
  type QuizQuestion = { id: string; prompt: string; options: string[]; answer: string };
  type FretboardQuestion = QuizQuestion & { stringIndex: number; fret: number };
  type Diagram =
    | { type: 'staff-note'; step: number }
    | { type: 'note-value'; value: 'whole' | 'half' | 'quarter' | 'eighth' | 'sixteenth'; dotted?: boolean }
    | { type: 'time-signature'; numerator: number; denominator: number }
    | { type: 'repeat' };
  type NotationQuestion = QuizQuestion & { diagram: Diagram };
  type Pattern = {
    id: string;
    answer: string;
    options: string[];
    timeSignature: string;
    resolution: '1/8' | '1/16';
    steps: number;
    activeSteps: number[];
  };
  type QuestionBank = {
    basics: QuizQuestion[];
    fretboard: FretboardQuestion[];
    rhythm: QuizQuestion[];
    notation: NotationQuestion[];
    patterns: Pattern[];
  };
  type Difficulty = '1' | '2';

  const svgNamespace = 'http://www.w3.org/2000/svg';

  function shuffle<T>(items: T[]): T[] {
    for (let index = items.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1));
      [items[index], items[swapIndex]] = [items[swapIndex], items[index]];
    }
    return items;
  }

  function createSvgElement(tag: string, attributes: Record<string, string>): SVGElement {
    const element = document.createElementNS(svgNamespace, tag);
    Object.entries(attributes).forEach(([name, value]) => element.setAttribute(name, value));
    return element;
  }

  function renderNotationDiagram(diagram: NotationDiagram, index: number): HTMLElement {
    const figure = document.createElement('figure');
    figure.className = 'notation-diagram';
    const svg = createSvgElement('svg', {
      viewBox: '0 0 240 110',
      role: 'img',
      'aria-label': `Schaubild ${index + 1} zur Notationsfrage`
    });

    const addLine = (x1: number, y1: number, x2: number, y2: number, width = 1) => {
      svg.append(createSvgElement('line', {
        x1: String(x1), y1: String(y1), x2: String(x2), y2: String(y2),
        stroke: 'currentColor', 'stroke-width': String(width)
      }));
    };

    if (diagram.type === 'staff-note' || diagram.type === 'note-value') {
      [24, 39, 54, 69, 84].forEach((y) => addLine(35, y, 205, y));
    }

    if (diagram.type === 'staff-note') {
      const y = 84 - diagram.step * 7.5;
      if (diagram.step < 0 || diagram.step > 8) addLine(132, y, 162, y);
      svg.append(createSvgElement('ellipse', {
        cx: '150', cy: String(y), rx: '9', ry: '6', fill: 'currentColor',
        transform: `rotate(-20 150 ${y})`
      }));
      addLine(158, y, 158, y - 42, 2.5);
    } else if (diagram.type === 'note-value') {
      const isUnfilled = diagram.value === 'whole' || diagram.value === 'half';
      const notePositions = diagram.dotted ||
        diagram.value === 'whole' || diagram.value === 'half' ? [120] : [88, 150];
      notePositions.forEach((x) => {
        svg.append(createSvgElement('ellipse', {
          cx: String(x), cy: '68', rx: '10', ry: '6',
          fill: isUnfilled ? 'none' : 'currentColor',
          stroke: 'currentColor',
          'stroke-width': isUnfilled ? '2.5' : '1',
          transform: `rotate(-20 ${x} 68)`
        }));
        if (diagram.value !== 'whole') addLine(x + 9, 67, x + 9, 25, 2.5);
        if (diagram.value === 'eighth' || diagram.value === 'sixteenth') {
          const beamCount = diagram.value === 'eighth' ? 1 : 2;
          for (let beam = 0; beam < beamCount; beam += 1) {
            addLine(x + 9, 27 + beam * 9, x + 71, 42 + beam * 9, 4);
          }
        }
      });
      if (diagram.dotted) {
        svg.append(createSvgElement('circle', {
          cx: diagram.value === 'whole' || diagram.value === 'half' ? '138' : '106',
          cy: '62', r: '2.5', fill: 'currentColor'
        }));
      }
    } else if (diagram.type === 'time-signature') {
      const top = document.createElementNS(svgNamespace, 'text');
      top.textContent = String(diagram.numerator);
      top.setAttribute('x', '120');
      top.setAttribute('y', '54');
      top.setAttribute('text-anchor', 'middle');
      top.setAttribute('font-size', '42');
      top.setAttribute('font-weight', '700');
      top.setAttribute('fill', 'currentColor');
      const bottom = top.cloneNode(true) as SVGTextElement;
      bottom.textContent = String(diagram.denominator);
      bottom.setAttribute('y', '94');
      svg.append(top, bottom);
    } else if (diagram.type === 'repeat') {
      addLine(48, 20, 48, 90, 2);
      addLine(55, 20, 55, 90, 5);
      addLine(188, 20, 188, 90, 5);
      addLine(195, 20, 195, 90, 2);
      [48, 63].forEach((y) => {
        svg.append(createSvgElement('circle', { cx: '72', cy: String(y), r: '3.5', fill: 'currentColor' }));
        svg.append(createSvgElement('circle', { cx: '171', cy: String(y), r: '3.5', fill: 'currentColor' }));
      });
    }

    figure.append(svg);
    return figure;
  }

  function setupLevel100Quiz() {
    document.querySelectorAll<HTMLElement>('[data-level-100-quiz]').forEach((quiz) => {
      if (quiz.dataset.initialized === 'true') return;
      quiz.dataset.initialized = 'true';

      const form = quiz.querySelector('form');
      const result = quiz.querySelector<HTMLElement>('.quiz-result');
      const resetButton = quiz.querySelector<HTMLButtonElement>('.reset-quiz');
      const patternQuestion = quiz.querySelector<HTMLElement>('.pattern-question');
      const patternCandidates = quiz.querySelectorAll<HTMLElement>('.pattern-candidate');
      const fretboard = quiz.querySelector<HTMLElement>('.fretboard-container');
      const fretboardTray = quiz.querySelector<HTMLElement>('.fretboard-note-tray');
      const fretboardFeedback = quiz.querySelector<HTMLElement>('.fretboard-feedback');
      const difficultyStatus = quiz.querySelector<HTMLElement>('.difficulty-status');
      const totalPointsLabel = quiz.querySelector<HTMLElement>('.total-points');
      const passingPointsLabel = quiz.querySelector<HTMLElement>('.passing-points');
      const difficultyButtons = quiz.querySelectorAll<HTMLButtonElement>('.difficulty-button');
      const basicsList = quiz.querySelector<HTMLElement>('.basics-list');
      const rhythmList = quiz.querySelector<HTMLElement>('.rhythm-list');
      const notationList = quiz.querySelector<HTMLElement>('.notation-list');
      const musicXmlQuestionBank = quiz.querySelector<HTMLElement>('.musicxml-question-bank');
      const advancedNotationList = quiz.querySelector<HTMLElement>('.advanced-notation-list');
      if (!form || !result || !resetButton || !patternQuestion || !patternCandidates.length ||
        !fretboard || !fretboardTray || !fretboardFeedback || !difficultyStatus ||
        !totalPointsLabel || !passingPointsLabel || !basicsList || !rhythmList || !notationList ||
        !musicXmlQuestionBank || !advancedNotationList) return;

      const banks = JSON.parse(quiz.dataset.questionBank ?? '{}') as Record<Difficulty, QuestionBank>;
      const unlockKey = 'mymusic-hub-level-100-difficulty-2';
      let unlocked = localStorage.getItem(unlockKey) === 'true';
      let difficulty: Difficulty = '1';
      let activeFretboardNotes: string[] = [];
      let selectedFretboardNote: string | undefined;
      const placedFretboardNotes = new Map<string, SVGGElement>();
      const fretboardNodes = [...fretboard.querySelectorAll<SVGGElement>('.note-node')];
      const previousQuestionIds = new Map<string, Set<string>>();
      const previousPatternIds = new Map<Difficulty, string>();

      const updateFretboardTokens = () => {
        fretboardTray.querySelectorAll<HTMLButtonElement>('.fretboard-note-token').forEach((token) => {
          const note = token.dataset.note;
          if (!note) return;
          const placed = placedFretboardNotes.has(note);
          token.hidden = placed;
          token.textContent = note;
          token.dataset.placed = String(placed);
          token.setAttribute('aria-pressed', String(note === selectedFretboardNote));
          token.setAttribute('aria-label', `Note ${note} zum Platzieren auswählen`);
        });
      };

      const clearFretboardNode = (node: SVGGElement) => {
        const placedNote = node.dataset.placedNote;
        if (placedNote) placedFretboardNotes.delete(placedNote);
        delete node.dataset.placedNote;
        node.removeAttribute('data-correct');
        node.classList.remove('active');
        const label = node.querySelector<SVGTextElement>('.note-text-active');
        if (label) label.textContent = node.dataset.note ?? '';
        node.setAttribute('aria-label', node.dataset.originalAriaLabel ?? 'Griffbrettposition');
      };

      const placeFretboardNote = (note: string, node: SVGGElement) => {
        if (!activeFretboardNotes.includes(note) || !fretboardNodes.includes(node)) return;
        const displacedNote = node.dataset.placedNote;
        if (displacedNote && displacedNote !== note) clearFretboardNode(node);
        const previousNode = placedFretboardNotes.get(note);
        if (previousNode && previousNode !== node) clearFretboardNode(previousNode);

        node.dataset.placedNote = note;
        node.classList.add('active');
        const label = node.querySelector<SVGTextElement>('.note-text-active');
        if (label) label.textContent = note;
        node.setAttribute('aria-label', `Abgelegte Note ${note}, Saite ${node.dataset.string}, Bund ${node.dataset.fret}`);
        placedFretboardNotes.set(note, node);
        selectedFretboardNote = undefined;
        updateFretboardTokens();
        clearFeedback();
      };

      fretboardNodes.forEach((node) => {
        node.dataset.originalAriaLabel = node.getAttribute('aria-label') ?? 'Griffbrettposition';
        node.addEventListener('dragover', (event) => {
          event.preventDefault();
          node.classList.add('drag-over');
        });
        node.addEventListener('dragleave', (event) => {
          if (event.relatedTarget instanceof Node && node.contains(event.relatedTarget)) return;
          node.classList.remove('drag-over');
        });
        node.addEventListener('drop', (event) => {
          event.preventDefault();
          node.classList.remove('drag-over');
          const note = event.dataTransfer?.getData('text/plain') || selectedFretboardNote;
          if (note) placeFretboardNote(note, node);
        });
        node.addEventListener('click', () => {
          if (node.dataset.placedNote) {
            clearFretboardNode(node);
            selectedFretboardNote = undefined;
            updateFretboardTokens();
            clearFeedback();
            return;
          }
          if (selectedFretboardNote) placeFretboardNote(selectedFretboardNote, node);
        });
        node.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            if (node.dataset.placedNote) {
              clearFretboardNode(node);
              selectedFretboardNote = undefined;
              updateFretboardTokens();
              clearFeedback();
            } else if (selectedFretboardNote) {
              placeFretboardNote(selectedFretboardNote, node);
            }
          }
        });
      });

      const selectQuestions = <T extends QuizQuestion>(category: string, pool: T[]): T[] => {
        const key = `${difficulty}:${category}`;
        const previous = previousQuestionIds.get(key) ?? new Set<string>();
        let candidates = pool.filter((item) => !previous.has(item.id));
        if (candidates.length < 5) candidates = pool;
        const selected = shuffle([...candidates]).slice(0, 5);
        previousQuestionIds.set(key, new Set(selected.map((item) => item.id)));
        return selected;
      };

      const selectGroupedNotation = (pool: NotationQuestion[]): NotationQuestion[] =>
        [1, 2, 3, 4, 5].map((group) => {
          const groupPool = pool.filter((item) => item.group === group);
          if (!groupPool.length) throw new Error(`MusicXML-Fragenpool ${group} ist leer.`);
          const key = `${difficulty}:notation-group-${group}`;
          const previous = previousQuestionIds.get(key) ?? new Set<string>();
          let candidates = groupPool.filter((item) => !previous.has(item.id));
          if (!candidates.length) {
            previous.clear();
            candidates = groupPool;
          }
          const selected = shuffle(candidates)[0];
          previous.add(selected.id);
          previousQuestionIds.set(key, previous);
          return selected;
        });

      const createQuestion = (item: QuizQuestion, category: string, index: number, diagram?: NotationDiagram) => {
        const fieldset = document.createElement('fieldset');
        fieldset.className = `quiz-question${diagram ? ' notation-question' : ''}`;
        fieldset.dataset.answer = item.answer;
        fieldset.dataset.active = 'true';

        const legend = document.createElement('legend');
        legend.textContent = `${index + 1}. ${item.prompt}`;
        fieldset.append(legend);

        if (diagram) fieldset.append(renderNotationDiagram(diagram, index));

        const options = document.createElement('div');
        options.className = 'answer-options';
        shuffle([...item.options]).forEach((option) => {
          const label = document.createElement('label');
          label.className = 'answer-option';
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `${difficulty}-${category}-${index}`;
          input.value = option;
          const text = document.createElement('span');
          text.textContent = option;
          label.append(input, text);
          options.append(label);
        });
        fieldset.append(options);

        const feedback = document.createElement('p');
        feedback.className = 'question-feedback';
        feedback.setAttribute('aria-live', 'polite');
        fieldset.append(feedback);
        return fieldset;
      };

      const clearFeedback = () => {
        result.textContent = '';
        result.removeAttribute('data-passed');
        quiz.querySelectorAll<HTMLElement>('.quiz-question').forEach((question) => {
          question.removeAttribute('data-correct');
          const feedback = question.querySelector<HTMLElement>('.question-feedback');
          if (feedback) feedback.textContent = '';
        });
        quiz.querySelectorAll<HTMLElement>('.pattern-candidate .step-cell').forEach((cell) => {
          cell.removeAttribute('data-correct');
        });
        fretboardNodes.forEach((node) => node.removeAttribute('data-correct'));
        fretboardTray.querySelectorAll<HTMLElement>('.fretboard-note-token').forEach((token) => {
          token.removeAttribute('data-correct');
        });
        fretboardFeedback.textContent = '';
      };

      const renderQuiz = () => {
        const bank = banks[difficulty];
        const basics = selectQuestions('basics', bank.basics);
        const rhythm = selectQuestions('rhythm', bank.rhythm);
        const notation = difficulty === '1'
          ? selectGroupedNotation(bank.notation)
          : selectQuestions('notation', bank.notation);
        basicsList.replaceChildren(...basics.map((item, index) => createQuestion(item, 'basics', index)));
        rhythmList.replaceChildren(...rhythm.map((item, index) => createQuestion(item, 'rhythm', index)));
        activeFretboardNotes = shuffle([
          ...new Set(bank.fretboard.map((item) => item.answer.replace(/\d+$/, '')))
        ]).slice(0, 5);
        if (activeFretboardNotes.length !== 5) {
          throw new Error('Für das Griffbrettquiz werden fünf unterschiedliche Töne benötigt.');
        }
        placedFretboardNotes.clear();
        selectedFretboardNote = undefined;
        fretboardNodes.forEach(clearFretboardNode);
        fretboardTray.replaceChildren(...activeFretboardNotes.map((note) => {
          const token = document.createElement('button');
          token.type = 'button';
          token.className = 'fretboard-note-token';
          token.draggable = true;
          token.dataset.note = note;
          token.textContent = note;
          const matchingNode = fretboardNodes.find(
            (node) => node.dataset.note?.replaceAll('#', '♯') === note
          );
          if (!matchingNode?.dataset.color) {
            throw new Error(`Keine Griffbrettfarbe für den Ton ${note} gefunden.`);
          }
          token.style.setProperty('--note-color', matchingNode.dataset.color);
          token.setAttribute('aria-pressed', 'false');
          token.setAttribute('aria-label', `Note ${note} zum Platzieren auswählen`);
          token.addEventListener('click', () => {
            selectedFretboardNote = selectedFretboardNote === note ? undefined : note;
            clearFeedback();
            updateFretboardTokens();
          });
          token.addEventListener('dragstart', (event) => {
            if (!event.dataTransfer) return;
            selectedFretboardNote = note;
            event.dataTransfer.setData('text/plain', note);
            event.dataTransfer.effectAllowed = 'move';
            updateFretboardTokens();
          });
          token.addEventListener('dragend', () => {
            fretboardNodes.forEach((node) => node.classList.remove('drag-over'));
          });
          return token;
        }));
        if (difficulty === '1') {
          musicXmlQuestionBank.hidden = false;
          advancedNotationList.hidden = true;
          const cardsById = new Map(
            [...musicXmlQuestionBank.querySelectorAll<HTMLElement>('.musicxml-question')]
              .map((card) => [card.dataset.questionId, card] as const)
          );
          cardsById.forEach((card) => {
            card.hidden = true;
            card.dataset.active = 'false';
          });
          notation.forEach((item, index) => {
            const card = cardsById.get(item.id);
            if (!card || !item.musicXmlUrl) {
              throw new Error(`MusicXML-Frage ${item.id} ist nicht vollständig eingebunden.`);
            }
            card.hidden = false;
            card.dataset.active = 'true';
            const legend = card.querySelector('legend');
            if (legend) legend.textContent = `${index + 1}. ${item.prompt}`;
            const player = card.querySelector<HTMLElement>('[data-sheet-music-player]');
            if (player?.dataset.xml !== item.musicXmlUrl) {
              throw new Error(`MusicXML-Datei für Frage ${item.id} stimmt nicht mit der Einbindung überein.`);
            }
            card.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
              input.name = `1-notation-${index}`;
              input.checked = false;
            });
            card.removeAttribute('data-correct');
            const feedback = card.querySelector<HTMLElement>('.question-feedback');
            if (feedback) feedback.textContent = '';
          });
        } else {
          musicXmlQuestionBank.hidden = true;
          advancedNotationList.hidden = false;
          advancedNotationList.replaceChildren(
            ...notation.map((item, index) => createQuestion(item, 'notation', index, item.diagram))
          );
        }
        document.dispatchEvent(new Event('level100:notation-update'));
        const previousPatternId = previousPatternIds.get(difficulty);
        const patternCandidatesForDifficulty = bank.patterns.filter((pattern) => pattern.id !== previousPatternId);
        const pattern = shuffle(patternCandidatesForDifficulty.length ? patternCandidatesForDifficulty : bank.patterns)[0];
        previousPatternIds.set(difficulty, pattern.id);
        const layoutId = `${pattern.timeSignature.replace('/', '-')}-${pattern.resolution.replace('/', '-')}`;
        const activeCandidate = [...patternCandidates].find((candidate) => candidate.dataset.layout === layoutId);
        if (!activeCandidate) throw new Error(`Kein DrumPattern-Raster für ${layoutId} vorhanden.`);

        patternCandidates.forEach((candidate) => {
          candidate.hidden = candidate !== activeCandidate;
          candidate.querySelectorAll<HTMLElement>('.step-cell').forEach((cell) => {
            cell.classList.remove('active');
            cell.removeAttribute('data-correct');
            cell.style.backgroundColor = '';
          });
        });
        const patternRow = activeCandidate.querySelector<HTMLElement>('.track-row:not(.velocity-row)');
        const patternColor = patternRow?.dataset.color;
        if (!patternRow || !patternColor) throw new Error('Die Rhythmusspur konnte nicht geladen werden.');
        pattern.activeSteps.forEach((step) => {
          const cell = patternRow.querySelector<HTMLElement>(`.step-cell[data-step="${step}"]`);
          if (!cell) throw new Error(`Rhythmus-Step ${step} fehlt im Pattern.`);
          cell.classList.add('active');
          cell.style.backgroundColor = patternColor;
        });
        patternQuestion.replaceChildren(createQuestion({
          id: pattern.id,
          prompt: 'Welche Aussage trifft auf dieses Rhythmusmuster zu?',
          answer: pattern.answer,
          options: pattern.options
        }, 'rhythm-pattern', 0));
        activeCandidate.setAttribute(
          'aria-label',
          `DrumPattern ${pattern.timeSignature}, Auflösung ${pattern.resolution}`
        );
        const total = 21;
        const passing = Math.ceil(total * 0.8);
        quiz.dataset.totalPoints = String(total);
        quiz.dataset.passingPoints = String(passing);
        totalPointsLabel.textContent = String(total);
        passingPointsLabel.textContent = String(passing);
        result.textContent = '';
        result.removeAttribute('data-passed');
        difficultyButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.difficulty === difficulty));
        });
        difficultyStatus.textContent = `Schwierigkeit ${difficulty}: ${difficulty === '1' ? 'Grundlagen' : 'Vertiefung'}`;
      };

      difficultyButtons.forEach((button) => {
        if (button.dataset.difficulty === '2') {
          button.disabled = !unlocked;
          if (unlocked) button.textContent = 'Schwierigkeit 2';
        }
        button.addEventListener('click', () => {
          if (button.disabled || (button.dataset.difficulty !== '1' && button.dataset.difficulty !== '2')) return;
          difficulty = button.dataset.difficulty;
          renderQuiz();
        });
      });

      form.addEventListener('change', () => {
        clearFeedback();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        let score = 0;

        quiz.querySelectorAll<HTMLElement>('.quiz-question[data-active="true"]').forEach((question) => {
          const answer = question.dataset.answer;
          const selected = question.querySelector<HTMLInputElement>('input:checked');
          const isCorrect = selected?.value === answer;
          if (isCorrect) score += 1;
          question.dataset.correct = String(isCorrect);
          const feedback = question.querySelector<HTMLElement>('.question-feedback');
          if (feedback) {
            feedback.textContent = selected
              ? isCorrect
                ? 'Richtig.'
                : `Noch nicht richtig. Lösung: ${answer}`
              : `Nicht beantwortet. Lösung: ${answer}`;
          }
        });

        let correctFretboardNotes = 0;
        activeFretboardNotes.forEach((note) => {
          const node = placedFretboardNotes.get(note);
          const token = fretboardTray.querySelector<HTMLButtonElement>(`.fretboard-note-token[data-note="${note}"]`);
          const isCorrect = node?.dataset.note?.replaceAll('#', '♯') === note;
          if (isCorrect) {
            score += 1;
            correctFretboardNotes += 1;
          }
          if (node) node.dataset.correct = String(isCorrect);
          if (token) token.dataset.correct = String(isCorrect);
        });
        fretboardFeedback.textContent = `Griffbrett: ${correctFretboardNotes} von 5 Tönen richtig platziert.`;

        const total = Number(quiz.dataset.totalPoints);
        const passing = Number(quiz.dataset.passingPoints);
        const percentage = Math.round((score / total) * 100);
        const passed = score >= passing;
        result.dataset.passed = String(passed);
        result.textContent = passed
          ? `Bestanden! ${score} von ${total} Punkten (${percentage} %). Du hast die erforderlichen ${passing} Punkte erreicht.`
          : `Noch nicht bestanden: ${score} von ${total} Punkten (${percentage} %). Zum Bestehen brauchst du ${passing} Punkte.`;
        if (passed && difficulty === '1' && !unlocked) {
          unlocked = true;
          localStorage.setItem(unlockKey, 'true');
          const advancedButton = quiz.querySelector<HTMLButtonElement>('[data-difficulty="2"]');
          if (advancedButton) {
            advancedButton.disabled = false;
            advancedButton.textContent = 'Schwierigkeit 2 freigeschaltet';
          }
          difficultyStatus.textContent = 'Schwierigkeit 2 ist jetzt dauerhaft freigeschaltet.';
        }
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      resetButton.addEventListener('click', renderQuiz);

      renderQuiz();
    });
  }

  setupLevel100Quiz();
  document.addEventListener('astro:page-load', setupLevel100Quiz);
</script>
