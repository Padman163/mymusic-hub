---
export interface BassBar {
  chord: string;
  note: string;
  velocity?: number;
  noteLengthSteps?: number;
}

export interface Props {
  bars: BassBar[];
  keyRoot?: string;
  scale?: "major" | "naturalMinor";
  stepsPerBar?: number;
  timeSignature?: string;
  resolution?: string;
  startBar?: number;
}

const {
  bars,
  keyRoot = "E",
  scale = "naturalMinor",
  stepsPerBar = 8,
  timeSignature = "4/4",
  resolution = "1/8",
  startBar = 1
} = Astro.props;

const totalSteps = bars.length * stepsPerBar;
const stepLabels = Array.from({ length: stepsPerBar }, (_, step) => (
  step % 2 === 0 ? `${step / 2 + 1}` : "+"
));
const pitchClasses = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
const notePattern = /^([A-G])(#?)(-?\d+)$/;
const parseNote = (note: string) => {
  const match = note.match(notePattern);
  if (!match) {
    throw new Error(`Ungültige Bassnote "${note}". Erwartet wird z. B. E1 oder F#2.`);
  }

  const [, letter, accidental, octaveText] = match;
  const pitchClass = `${letter}${accidental}`;
  const midi = (Number(octaveText) + 1) * 12 + pitchClasses.indexOf(pitchClass);
  return { midi, pitchClass, octave: Number(octaveText) };
};
const rootMatch = keyRoot.match(/^([A-G])(#?)$/);
if (!rootMatch) {
  throw new Error(`Ungültiger Tonart-Grundton "${keyRoot}". Erwartet wird z. B. E oder F#.`);
}

const rootPitchClass = pitchClasses.indexOf(`${rootMatch[1]}${rootMatch[2]}`);
const scaleIntervals = scale === "major" ? [0, 2, 4, 5, 7, 9, 11] : [0, 2, 3, 5, 7, 8, 10];
const romanDegrees = scale === "major"
  ? ["I", "ii", "iii", "IV", "V", "vi", "vii°"]
  : ["i", "ii°", "III", "iv", "v", "VI", "VII"];
const scalePitchClasses = new Set(scaleIntervals.map((interval) => (rootPitchClass + interval) % 12));
const chordLabel = (chord: string) => {
  const match = chord.match(/^([A-G])(#?)/);
  if (!match) return chord;
  const chordRoot = pitchClasses.indexOf(`${match[1]}${match[2]}`);
  const degree = scaleIntervals.findIndex((interval) => (rootPitchClass + interval) % 12 === chordRoot);
  return degree < 0 ? chord : `${chord} · ${romanDegrees[degree]}`;
};
const parsedBars = bars.map((bar) => {
  const noteLengthSteps = bar.noteLengthSteps ?? 1;
  if (!Number.isInteger(noteLengthSteps) || noteLengthSteps < 1 || noteLengthSteps > stepsPerBar) {
    throw new Error(`Ungültige Notenlänge ${noteLengthSteps} für "${bar.note}". Erlaubt sind 1 bis ${stepsPerBar} Steps.`);
  }
  return { ...bar, parsedNote: parseNote(bar.note) };
});
const lowestMidi = Math.min(...parsedBars.map(({ parsedNote }) => parsedNote.midi));
const highestMidi = Math.max(...parsedBars.map(({ parsedNote }) => parsedNote.midi));
const pitches = Array.from({ length: highestMidi - lowestMidi + 1 }, (_, index) => {
  const midi = lowestMidi + index;
  const pitchClass = pitchClasses[midi % 12];
  return scalePitchClasses.has(midi % 12)
    ? { midi, label: `${pitchClass}${Math.floor(midi / 12) - 1}`, pitchClass }
    : null;
}).filter((pitch) => pitch !== null).reverse();
const keyLabel = `${keyRoot} ${scale === "major" ? "Dur" : "Moll"}`;
const pitchColors: Record<string, string> = {
  C: "#ef4444",
  D: "#eab308",
  E: "#22c55e",
  G: "#3b82f6"
};
const colorForPitch = (pitchClass: string) => pitchColors[pitchClass] ?? "#a78bfa";
const velocities = [...new Set(bars.map(({ velocity }) => velocity ?? 102))];
---

<div
  class="bass-pattern"
  style={`--total-steps: ${totalSteps}; --steps-per-bar: ${stepsPerBar};`}
  aria-label={`Basspattern in ${keyLabel}, ${bars.length} Takte, ${timeSignature}, ${resolution}`}
>
  <div class="bar-header">
    <div class="bar-spacer" aria-hidden="true"></div>
    {bars.map((bar, index) => (
      <div
        class={`bar-label ${index % 2 === 1 ? "alternate-bar" : ""}`}
        style={`grid-column: span ${stepsPerBar};`}
      >
        {chordLabel(bar.chord)}
      </div>
    ))}
  </div>

  <div class="step-header">
    <div aria-hidden="true"></div>
    {bars.flatMap((_, barIndex) => stepLabels.map((label, stepIndex) => (
      <div class={`step-label ${barIndex % 2 === 1 ? "alternate-bar" : ""}`}>
        {label}
      </div>
    )))}
  </div>

  <div class="piano-roll">
    {pitches.map((pitch) => (
      <div class="pitch-row">
        <div class="pitch-label" style={`--note-color: ${colorForPitch(pitch.pitchClass)};`}>
          {pitch.label}
        </div>
        {bars.flatMap((bar, barIndex) =>
          Array.from({ length: stepsPerBar }, (_, stepIndex) => {
            const step = barIndex * stepsPerBar + stepIndex;
            const isActive = parsedBars[barIndex].parsedNote.midi === pitch.midi;
            const velocity = bar.velocity ?? 102;
            const noteLengthSteps = bar.noteLengthSteps ?? 1;
            const startsNote = stepIndex % noteLengthSteps === 0;
            const noteSpans = Math.min(noteLengthSteps, stepsPerBar - stepIndex);

            if (isActive && !startsNote) return null;

            return (
              <div
                class={`note-cell ${barIndex % 2 === 1 ? "alternate-bar" : ""}`}
                style={isActive
                  ? `grid-column: ${step + 2} / span ${noteSpans}; --note-color: ${colorForPitch(pitch.pitchClass)};`
                  : `grid-column: ${step + 2};`}
                aria-label={isActive
                  ? `Takt ${startBar + barIndex}, ${bar.chord}, ${pitch.label}, Schritt ${stepIndex + 1}, Anschlag ${velocity}`
                  : undefined}
              >
                {isActive && startsNote && (
                  <span
                    class="note-block"
                  >
                    {pitch.label}
                  </span>
                )}
              </div>
            );
          })
        )}
      </div>
    ))}
  </div>

  <div class="pattern-footer">
    <span>Taktart: <strong>{timeSignature}</strong></span>
    <span>Auflösung: <strong>{resolution}</strong></span>
    <span>Achtel pro Takt: <strong>{stepsPerBar}</strong></span>
    <span>Anschlagstärke: <strong>{velocities.join(" / ")}</strong></span>
  </div>
</div>

<style>
  .bass-pattern {
    --pitch-label-width: 42px;
    --step-size: 32.5px;
    --step-gap: 2.5px;
    width: 100%;
    max-width: 100%;
    margin: 1rem 0;
    overflow: auto hidden;
    border: 1px solid #27272a;
    border-radius: 6px;
    background: #121212;
    color: #d1d5db;
    font-family: system-ui, -apple-system, sans-serif;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
  }

  .pattern-footer {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 36px;
    white-space: nowrap;
    font-size: 12px;
  }

  .pattern-footer {
    padding: 0 8px;
    color: #9ca3af;
  }

  .bar-header,
  .step-header,
  .pitch-row {
    display: grid;
    grid-template-columns: var(--pitch-label-width) repeat(var(--total-steps), var(--step-size));
    column-gap: var(--step-gap);
    width: max-content;
    padding: 0 8px;
    box-sizing: border-box;
  }

  .bar-header {
    height: calc(var(--step-size) + var(--step-gap) + 1px);
    min-height: calc(var(--step-size) + var(--step-gap) + 1px);
    box-sizing: border-box;
    align-items: center;
    background: #121212;
    font-size: 12px;
    font-weight: 600;
    padding: 0 8px var(--step-gap);
  }

  .bar-spacer {
    grid-column: 1;
    grid-row: 1;
  }

  .pitch-heading,
  .bar-label {
    color: #aeb4bd;
    text-align: center;
    white-space: nowrap;
  }

  .bar-label {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    grid-row: 1;
    min-width: 0;
    height: var(--step-size);
    box-sizing: border-box;
    padding: 0 4px;
    border: 1px solid #27272a;
    border-radius: 2px;
    background: #18181b;
    color: #9ca3af;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: left;
  }

  .bar-label.alternate-bar {
    background: #242428;
  }

  .step-header {
    height: calc(var(--step-size) + var(--step-gap) + 1px);
    min-height: calc(var(--step-size) + var(--step-gap) + 1px);
    box-sizing: border-box;
    align-items: center;
    background: #121212;
    border-bottom: 1px solid #35383d;
    font-size: 10px;
    padding: 0 8px var(--step-gap);
  }

  .step-label {
    display: grid;
    place-items: center;
    width: var(--step-size);
    height: var(--step-size);
    align-self: center;
    box-sizing: border-box;
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
    border: 1px solid #27272a;
    border-radius: 2px;
    background: #18181b;
    color: #9ca3af;
    font-weight: 600;
    line-height: 1;
  }

  .step-label.alternate-bar {
    background: #242428;
  }

  .piano-roll {
    display: flex;
    flex-direction: column;
    gap: var(--step-gap);
    padding-top: var(--step-gap);
    width: max-content;
    background: #121212;
  }

  .pitch-row {
    height: var(--step-size);
    flex: 0 0 var(--step-size);
    min-height: 0;
    align-items: stretch;
    background: #121212;
    margin: 0 !important;
    padding: 0 8px !important;
  }

  .pitch-row > * {
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
  }

  .pitch-label {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d1d5db;
    font-size: 11px;
    font-weight: 600;
  }

  .note-cell {
    display: flex;
    align-items: center;
    height: 100%;
    min-width: 0;
    margin: 0 !important;
    border-radius: 2px;
    background: #18181b;
  }

  .note-cell.alternate-bar {
    background: #242428;
  }

  .note-block {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0 1px;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: 2px;
    background: color-mix(in srgb, var(--note-color), transparent 18%);
    color: #f8fafc;
    font-size: 9px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .bass-pattern {
      --pitch-label-width: 34px;
      --step-size: 32.5px;
    }

    .pattern-footer {
      gap: 8px;
      padding: 0 8px;
      font-size: 10px;
    }
  }

  .pattern-footer {
    min-height: 34px;
    border-top: 1px solid #33363a;
  }

  .pattern-footer strong {
    color: #d1d5db;
  }
</style>
