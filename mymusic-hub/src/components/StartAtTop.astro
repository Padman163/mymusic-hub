<script is:inline>
  const pagePaths = new Set([
    '/audio/theory/100/104-tabulatur-notensystem/',
    '/audio/theory/100/105-abschlussquiz/'
  ]);

  const updateScrollBehavior = () => {
    const isTargetPage = pagePaths.has(window.location.pathname);
    document.documentElement.classList.toggle('disable-musicxml-scroll-anchoring', isTargetPage);
    window.history.scrollRestoration = isTargetPage ? 'manual' : 'auto';

    if (isTargetPage) window.scrollTo(0, 0);
  };

  window.addEventListener('pageshow', updateScrollBehavior);
  document.addEventListener('astro:page-load', updateScrollBehavior);
  updateScrollBehavior();
</script>

<style is:global>
  html.disable-musicxml-scroll-anchoring {
    overflow-anchor: none !important;
  }
</style>
