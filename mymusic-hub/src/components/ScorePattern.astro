---
export interface ScoreEvent {
  label?: string;
  pitch?: string;
  pitches?: string[];
  kind?: "chord" | "note";
  startStep: number;
  lengthSteps: number;
  pitchOffset?: number;
  expandedNotes?: { label: string; color: string; pitchOffset: number }[];
}

interface ParsedScoreEvent extends ScoreEvent {
  displayColor?: string;
  displayLaneName?: string;
  displayLaneOffset?: number;
  displayNotehead?: ScoreLane["notehead"];
}

export interface ScoreBar {
  events: ParsedScoreEvent[];
}

export interface ScoreLane {
  name: string;
  color?: string;
  notehead?: "circle" | "x";
  bars: ScoreBar[];
  collapsedDisplay?: boolean;
  expandedDisplay?: boolean;
  showToggle?: boolean;
}

export interface ScoreTrack {
  name: string;
  color: string;
  compact?: boolean;
  expandable?: boolean;
  collapseLanes?: boolean;
  pitchExpandable?: boolean;
  pitchExpansionHeight?: "same" | "double";
  chordNotes?: Record<string, string[]>;
  bars?: ScoreBar[];
  lanes?: ScoreLane[];
}

export interface Props {
  chords: string[];
  tracks: ScoreTrack[];
  section?: string;
  stepsPerBar?: number;
  timeSignature?: string;
  resolution?: string;
  startBar?: number;
}

const {
  chords,
  tracks,
  section,
  stepsPerBar = 8,
  timeSignature = "4/4",
  resolution = "1/8",
  startBar = 1
} = Astro.props;

if (!Number.isInteger(stepsPerBar) || stepsPerBar < 1) {
  throw new Error(`Ungültige Step-Anzahl ${stepsPerBar}. Erwartet wird eine positive ganze Zahl.`);
}
if (chords.length === 0) {
  throw new Error("Eine Gesamtpartitur muss mindestens einen Takt enthalten.");
}
if (tracks.length === 0) {
  throw new Error("Eine Gesamtpartitur muss mindestens eine Instrumentenspur enthalten.");
}

const parsedTracks = tracks.map((track) => {
  if (!track.name.trim()) {
    throw new Error("Der Name einer Instrumentenspur darf nicht leer sein.");
  }
  if (!/^#[\da-f]{6}$/i.test(track.color)) {
    throw new Error(`Ungültige Spurfarbe "${track.color}" für "${track.name}". Erwartet wird z. B. #60a5fa.`);
  }
  if ((track.bars === undefined) === (track.lanes === undefined)) {
    throw new Error(`Die Spur "${track.name}" muss entweder Takte oder separate Instrument-Lanes enthalten.`);
  }
  if (track.pitchExpansionHeight && !["same", "double"].includes(track.pitchExpansionHeight)) {
    throw new Error(`Ungültige Aufklapphöhe "${track.pitchExpansionHeight}" für "${track.name}". Erwartet wird "same" oder "double".`);
  }
  if (track.collapseLanes && (!track.expandable || !track.lanes)) {
    throw new Error(`Die Spur "${track.name}" darf Lanes nur für eine aufklappbare Spur zusammenfassen.`);
  }

  const lanes = track.lanes ?? [{ name: "", bars: track.bars ?? [] }];
  if (lanes.length === 0) {
    throw new Error(`Die Spur "${track.name}" muss mindestens eine Instrument-Lane enthalten.`);
  }

  const parsedLanes = lanes.map((lane) => {
    const laneColor = lane.color ?? track.color;
    if (!/^#[\da-f]{6}$/i.test(laneColor)) {
      throw new Error(`Ungültige Drum-/Instrumentfarbe "${laneColor}" für "${track.name} · ${lane.name}".`);
    }
    if (lane.bars.length !== chords.length) {
      throw new Error(`Die Spur "${track.name}"${lane.name ? ` (${lane.name})` : ""} muss genau ${chords.length} Takte enthalten.`);
    }

    const bars = lane.bars.map(({ events }, barIndex) => {
      const parsedEvents = events.map((event) => {
        if (event.label !== undefined && !event.label.trim()) {
          throw new Error(`Ein Notenlabel in Spur "${track.name}", Takt ${startBar + barIndex} darf nicht leer sein.`);
        }
        if (
          !Number.isInteger(event.startStep)
          || !Number.isInteger(event.lengthSteps)
          || event.startStep < 0
          || event.lengthSteps < 1
          || event.startStep + event.lengthSteps > stepsPerBar
        ) {
          throw new Error(`Ungültige Position oder Länge für "${event.label ?? lane.name}" in Spur "${track.name}", Takt ${startBar + barIndex}.`);
        }
        return event;
      }).sort((a, b) => a.startStep - b.startStep);

      parsedEvents.forEach((event, index) => {
        const previousEvent = parsedEvents[index - 1];
        if (previousEvent && event.startStep < previousEvent.startStep + previousEvent.lengthSteps) {
          throw new Error(`Überlappende Noten in Spur "${track.name}"${lane.name ? ` (${lane.name})` : ""}, Takt ${startBar + barIndex}.`);
        }
      });

      return { events: parsedEvents };
    });

    return { ...lane, color: laneColor, bars };
  });
  const displayLanes = track.collapseLanes
    ? [
        {
          name: "",
          color: track.color,
          collapsedDisplay: true,
          showToggle: true,
          bars: chords.map((_, barIndex) => ({
            events: parsedLanes.flatMap((lane, laneIndex) => lane.bars[barIndex].events.map((event) => ({
              ...event,
              displayColor: lane.color,
              displayLaneName: lane.name,
              displayLaneOffset: laneIndex * 15.3 + 6.8,
              displayNotehead: lane.notehead
            }))).sort((a, b) => a.startStep - b.startStep)
          }))
        },
        ...parsedLanes.map((lane, laneIndex) => ({
          ...lane,
          expandedDisplay: true,
          showToggle: laneIndex === 0
        }))
      ]
    : parsedLanes.map((lane, laneIndex) => ({
        ...lane,
        showToggle: laneIndex === 0
      }));

  if (track.pitchExpandable) {
    const baseTrackHeight = 55.25;
    const expandedTrackHeight = track.pitchExpansionHeight === "same" ? baseTrackHeight : baseTrackHeight * 2;
    const noteHeight = baseTrackHeight / 5;
    const maxPitchOffset = expandedTrackHeight - noteHeight;
    const pitchClasses = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    const pitchColors: Record<string, string> = {
      C: "#ef4444",
      D: "#eab308",
      E: "#22c55e",
      G: "#3b82f6"
    };
    const parsePitch = (pitch: string, event: ScoreEvent) => {
      const pitchMatch = pitch.match(/^([A-G])(#?)(-?\d+)$/);
      if (!pitchMatch) {
        throw new Error(`Ungültige Tonhöhe "${pitch}" in aufklappbarer Spur "${track.name}". Erwartet wird z. B. E3 oder F#4.`);
      }

      const pitchClass = `${pitchMatch[1]}${pitchMatch[2]}`;
      return {
        event,
        label: pitch,
        color: pitchColors[pitchClass] ?? "#a78bfa",
        midi: (Number(pitchMatch[3]) + 1) * 12 + pitchClasses.indexOf(pitchClass)
      };
    };
    const pitchEvents = parsedLanes.flatMap((lane) => lane.bars.flatMap((bar) => bar.events.flatMap((event) => {
      const eventPitches = event.pitches
        ?? (event.kind === "chord" && track.chordNotes
          ? track.chordNotes[event.label ?? ""]
          : undefined)
        ?? [event.pitch ?? event.label ?? ""];

      if (event.kind === "chord" && eventPitches.length === 1 && eventPitches[0] === event.label) {
        throw new Error(`Für den Akkord "${event.label}" in aufklappbarer Spur "${track.name}" müssen die einzelnen Akkordnoten angegeben werden.`);
      }
      event.expandedNotes = eventPitches.map((pitch) => parsePitch(pitch, event));
      return event.expandedNotes;
    })));

    if (pitchEvents.length === 0) {
      throw new Error(`Die aufklappbare Spur "${track.name}" muss mindestens eine Note enthalten.`);
    }

    const lowest = Math.min(...pitchEvents.map(({ midi }) => midi));
    const highest = Math.max(...pitchEvents.map(({ midi }) => midi));

    for (const note of pitchEvents) {
      note.event.pitchOffset = highest === lowest
        ? 0
        : ((highest - note.midi) / (highest - lowest)) * maxPitchOffset;
      const expandedNote = note.event.expandedNotes?.find(({ label }) => label === note.label);
      if (expandedNote) {
        expandedNote.pitchOffset = note.event.pitchOffset;
      }
    }
  }

  return {
    name: track.name,
    color: track.color,
    compact: track.compact ?? false,
    expandable: track.expandable ?? track.pitchExpandable ?? false,
    collapseLanes: track.collapseLanes ?? false,
    pitchExpandable: track.pitchExpandable ?? false,
    pitchExpansionHeight: track.pitchExpansionHeight ?? "double",
    lanes: displayLanes
  };
});

const totalSteps = chords.length * stepsPerBar;
const hasExpandableTracks = parsedTracks.some((track) => track.expandable);
const stepLabels = Array.from({ length: stepsPerBar }, (_, step) => (
  step % 2 === 0 ? `${step / 2 + 1}` : "+"
));
---

<div
  class:list={["score-pattern", hasExpandableTracks && "all-tracks-collapsed"]}
  style={`--total-steps: ${totalSteps}; --steps-per-bar: ${stepsPerBar};`}
  aria-label={`Gesamtpartitur, ${chords.length} Takte, ${timeSignature}, ${resolution}`}
>
  <div class="score-content">
    {section && (
      <div class="section-row" aria-label={`Songabschnitt: ${section}`}>
        <div class="row-label" aria-hidden="true"></div>
        <div class="section-bar" style={`grid-column: 2 / span ${totalSteps};`}>
          {section}
        </div>
      </div>
    )}

    <div class="measure-row" aria-label="Akkorde">
      <div class="row-label">
        {hasExpandableTracks && (
          <>
            <span class="structure-label">Songstruktur</span>
            <button
              class="pitch-toggle global-pitch-toggle"
              type="button"
              data-expand-all
              aria-expanded="false"
              aria-label="Alle Spuren aufklappen"
              title="Alle Spuren auf- oder zuklappen"
            >
              <svg aria-hidden="true" viewBox="0 0 12 12">
                <path d="m4 2 4 4-4 4" />
              </svg>
            </button>
          </>
        )}
      </div>
      {chords.map((chord, barIndex) => (
        <div
          class={`measure-cell ${barIndex % 2 === 1 ? "alternate-measure" : ""}`}
          style={`grid-column: ${barIndex * stepsPerBar + 2} / span ${stepsPerBar};`}
          aria-label={`Takt ${startBar + barIndex}, Akkord ${chord}`}
        >
          <span class="measure-number">Takt {startBar + barIndex}</span>
          <strong>{chord}</strong>
        </div>
      ))}
    </div>

    <div class="step-row" aria-hidden="true">
      <div class="row-label"></div>
      {chords.flatMap((_, barIndex) => stepLabels.map((label) => (
        <div class={`step-cell ${barIndex % 2 === 1 ? "alternate-measure" : ""}`}>
          {label}
        </div>
      )))}
    </div>

    {parsedTracks.map((track) => (
      <div
        class={`track-group ${track.compact ? "compact-track-group" : ""} ${track.expandable ? "expandable-track-group" : ""} ${track.collapseLanes ? "drum-expandable-group" : ""} ${track.pitchExpandable ? "pitch-expandable-group" : ""} ${track.pitchExpansionHeight === "same" ? "same-height-pitch-group" : ""}`}
        style={`--track-color: ${track.color};`}
        aria-label={`Instrumentenspur ${track.name}`}
      >
        {track.lanes.map((lane) => (
          <div
            class={`track-row ${lane.collapsedDisplay ? "collapsed-track-row" : ""} ${lane.expandedDisplay ? "expanded-track-row" : ""}`}
            style={`--track-color: ${lane.color};`}
            aria-label={`${track.name}${lane.name ? `: ${lane.name}` : ""}`}
          >
            <div class="row-label track-label">
              {lane.collapsedDisplay ? track.name : lane.name ? `${track.name} · ${lane.name}` : track.name}
              {track.expandable && lane.showToggle && (
                <button
                  class="pitch-toggle"
                  type="button"
                  data-pitch-toggle
                  data-track-name={track.name}
                  aria-expanded="false"
                  aria-label={`${track.name} aufklappen`}
                >
                  <svg aria-hidden="true" viewBox="0 0 12 12">
                    <path d="m4 2 4 4-4 4" />
                  </svg>
                </button>
              )}
            </div>
            {lane.bars.flatMap((bar, barIndex) => [
              ...Array.from({ length: stepsPerBar }, (_, stepIndex) => (
                <div
                  class={`step-cell ${barIndex % 2 === 1 ? "alternate-measure" : ""}`}
                  style={`grid-column: ${barIndex * stepsPerBar + stepIndex + 2}; grid-row: 1;`}
                  aria-hidden="true"
                ></div>
              )),
              ...bar.events.map((event) => {
                const notehead = event.displayNotehead ?? lane.notehead;
                const eventLaneName = event.displayLaneName ?? lane.name;
                const eventText = event.pitch
                  ? `${event.label ?? ""} · gesungene Note ${event.pitch}`
                  : event.label;
                return (
                  <>
                    <div
                      class={`note-event ${event.kind === "chord" ? "chord-event" : ""} ${event.kind === "chord" && event.expandedNotes ? "has-expanded-notes" : ""} ${event.pitch ? "vocal-note" : ""} ${notehead ? `drum-note drum-note-${notehead}` : ""}`}
                      style={`grid-column: ${barIndex * stepsPerBar + event.startStep + 2} / span ${event.lengthSteps}; grid-row: 1;${event.pitchOffset === undefined ? "" : ` --pitch-offset: ${event.pitchOffset}px;`}${event.displayColor ? ` --event-color: ${event.displayColor};` : ""}${event.displayLaneOffset === undefined ? "" : ` --drum-lane-offset: ${event.displayLaneOffset}px;`}`}
                      aria-label={`Takt ${startBar + barIndex}, ${track.name}${eventLaneName ? `, ${eventLaneName}` : ""}${event.kind === "chord" ? `, Akkord ${event.label}` : eventText ? `: ${eventText}` : " Anschlag"}, Schritt ${event.startStep + 1}, Länge ${event.lengthSteps} Steps`}
                      title={event.kind === "chord" ? `Akkord ${event.label}` : eventText ?? eventLaneName}
                    >
                      {notehead ? (
                        <span class="drum-notehead" aria-hidden="true"></span>
                      ) : event.pitch ? (
                        <>
                          <span>{event.label}</span>
                          <span class="event-pitch">{event.pitch}</span>
                        </>
                      ) : event.label}
                    </div>
                    {event.kind === "chord" && event.expandedNotes?.map((note) => (
                      <div
                        class="expanded-chord-note"
                        style={`grid-column: ${barIndex * stepsPerBar + event.startStep + 2} / span ${event.lengthSteps}; grid-row: 1; --pitch-offset: ${note.pitchOffset}px;`}
                        aria-label={`Takt ${startBar + barIndex}, ${track.name}, Akkordnote ${note.label}, Schritt ${event.startStep + 1}, Länge ${event.lengthSteps} Steps`}
                        title={note.label}
                      >
                        {note.label}
                      </div>
                    ))}
                  </>
                );
              })
            ])}
          </div>
        ))}
      </div>
    ))}

    <div class="score-footer">
      <span>Taktart: <strong>{timeSignature}</strong></span>
      <span>Auflösung: <strong>{resolution}</strong></span>
      <span>Steps pro Takt: <strong>{stepsPerBar}</strong></span>
    </div>
  </div>
</div>

<style>
  .score-pattern {
    --label-width: 154px;
    --step-size: 30px;
    --measure-height: 34px;
    --track-height: 55.25px;
    --step-gap: 2px;
    width: 100%;
    max-width: 100%;
    margin: 1rem 0;
    overflow: auto hidden;
    border: 1px solid #27272a;
    border-radius: 6px;
    background: #121212;
    color: #d1d5db;
    font-family: system-ui, -apple-system, sans-serif;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
  }

  .score-content {
    display: flex;
    flex-direction: column;
    row-gap: var(--step-gap);
    width: max-content;
    margin-block: 0 !important;
    padding-block: 8px var(--step-gap);
    box-sizing: border-box;
  }

  .section-row {
    display: grid;
    grid-template-columns: var(--label-width) repeat(var(--total-steps), var(--step-size));
    column-gap: var(--step-gap);
    width: max-content;
    margin-block: 0 !important;
    padding: 0 8px;
    box-sizing: border-box;
  }

  .section-row > * {
    margin-block: 0 !important;
    box-sizing: border-box;
  }

  .section-bar {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 28px;
    padding: 0 8px;
    border: 1px solid #35383d;
    border-radius: 2px;
    background: #242428;
    color: #f3f4f6;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .measure-row,
  .step-row,
  .track-row {
    display: grid;
    grid-template-columns: var(--label-width) repeat(var(--total-steps), var(--step-size));
    column-gap: var(--step-gap);
    width: max-content;
    margin-block: 0 !important;
    padding: 0 8px;
    box-sizing: border-box;
  }

  .measure-row {
    grid-auto-rows: var(--measure-height);
    align-items: stretch;
  }

  .step-row {
    grid-auto-rows: 22px;
    align-items: stretch;
  }

  .all-tracks-collapsed .step-row {
    display: none;
  }

  .track-group {
    display: flex;
    flex-direction: column;
    row-gap: var(--step-gap);
    width: max-content;
    margin-block: 0 !important;
    box-sizing: border-box;
  }

  .track-group + .track-group {
    margin-block-start: 4px !important;
  }

  .compact-track-group {
    --track-height: 35.75px;
  }

  .drum-expandable-group:not(.is-expanded) {
    --track-height: 55.25px;
  }

  .drum-expandable-group.is-expanded {
    --track-height: 35.75px;
  }

  .drum-expandable-group:not(.is-expanded) .expanded-track-row,
  .drum-expandable-group.is-expanded .collapsed-track-row {
    display: none;
  }

  .track-row {
    grid-auto-rows: var(--track-height);
    align-items: stretch;
    padding: 0 8px;
  }

  .measure-row > *,
  .step-row > *,
  .track-row > * {
    margin-block: 0 !important;
    box-sizing: border-box;
  }

  .row-label {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    padding: 0 8px 0 0;
    color: #9ca3af;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .track-label {
    color: var(--track-color);
    gap: 6px;
  }

  .structure-label {
    color: #9ca3af;
  }

  .measure-row .row-label {
    gap: 6px;
  }

  .global-pitch-toggle {
    margin-left: 0 !important;
  }

  .pitch-toggle {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 20px;
    flex: 0 0 16px;
    margin: 0 0 0 auto !important;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: #71717a;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    box-sizing: border-box;
  }

  .pitch-toggle svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease, color 160ms ease;
  }

  .global-pitch-toggle[aria-expanded="true"] svg {
    transform: rotate(90deg);
  }

  .pitch-toggle:hover,
  .pitch-toggle:focus-visible {
    color: var(--track-color);
    outline: none;
  }

  .measure-cell,
  .step-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    border: 1px solid #27272a;
    border-radius: 2px;
    background: #18181b;
    color: #9ca3af;
    line-height: 1;
    box-sizing: border-box;
  }

  .measure-cell {
    justify-content: space-between;
    padding: 0 8px;
    color: #f3f4f6;
    font-size: 12px;
  }

  .measure-number {
    color: #9ca3af;
    font-size: 10px;
    font-weight: 500;
  }

  .alternate-measure {
    background: #242428;
  }

  .step-cell {
    font-size: 9px;
    font-weight: 600;
  }

  .note-event {
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    padding: 0 2px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--track-color);
    color: #111827;
    font-size: 11.7px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .pitch-expandable-group {
    --base-track-height: 55.25px;
    --track-height: var(--base-track-height);
  }

  .pitch-expandable-group.is-expanded:not(.same-height-pitch-group) {
    --track-height: calc(var(--base-track-height) * 2);
  }

  .expandable-track-group.is-expanded .pitch-toggle {
    color: var(--track-color);
  }

  .expandable-track-group.is-expanded .pitch-toggle svg {
    transform: rotate(90deg);
  }

  .drum-expandable-group:not(.is-expanded) .collapsed-track-row .step-cell {
    border-color: transparent;
    background: transparent;
  }

  .drum-expandable-group:not(.is-expanded) .collapsed-track-row .drum-note {
    position: relative;
    top: var(--drum-lane-offset, 0px);
    align-self: start;
    height: 6.5px;
    padding: 0;
    overflow: visible;
  }

  .drum-expandable-group:not(.is-expanded) .collapsed-track-row .drum-notehead {
    width: 6.5px;
    height: 6.5px;
    flex-basis: 6.5px;
  }

  .pitch-expandable-group.is-expanded .note-event:not(.chord-event) {
    position: relative;
    top: var(--pitch-offset, 0px);
    align-self: start;
    height: calc(var(--base-track-height) / 5);
    overflow: visible;
    font-size: 9.1px;
  }

  .pitch-expandable-group.is-expanded .chord-event.has-expanded-notes {
    display: none;
  }

  .expanded-chord-note {
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: calc(var(--base-track-height) / 5);
    padding: 0 1px;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, var(--track-color), transparent 18%);
    color: #f8fafc;
    font-size: 9.1px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .pitch-expandable-group.is-expanded .expanded-chord-note {
    position: relative;
    top: var(--pitch-offset, 0px);
    display: flex;
    align-self: start;
  }

  .event-pitch {
    display: none;
  }

  .pitch-expandable-group.is-expanded .vocal-note {
    justify-content: space-between;
    text-align: left;
  }

  .pitch-expandable-group.is-expanded .event-pitch {
    display: inline;
    flex: 0 0 auto;
    margin-left: auto;
    font-size: 7.8px;
    font-weight: 600;
    text-align: right;
  }

  .chord-event {
    position: relative;
    padding-left: 6px;
    border: 1px solid #27272a;
    background: #18181b;
    color: #d1d5db;
  }

  .chord-event::before {
    position: absolute;
    inset: 50% auto auto 2px;
    width: 3px;
    height: 9px;
    background: #9ca3af;
    content: "";
    transform: translateY(-50%);
  }

  .drum-note {
    overflow: visible;
    background: transparent;
  }

  .drum-notehead {
    display: block;
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    background: var(--event-color, var(--track-color));
    box-sizing: border-box;
  }

  .drum-note-circle .drum-notehead {
    border-radius: 50%;
  }

  .drum-note-x .drum-notehead {
    background:
      linear-gradient(45deg, transparent 42%, var(--event-color, var(--track-color)) 43% 57%, transparent 58%),
      linear-gradient(-45deg, transparent 42%, var(--event-color, var(--track-color)) 43% 57%, transparent 58%);
  }

  .score-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 30px;
    align-self: stretch;
    margin-block: 0 !important;
    padding: 0 8px;
    border-top: 1px solid #33363a;
    color: #9ca3af;
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .score-footer > * {
    margin-block: 0 !important;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .score-pattern {
      --label-width: 138px;
      --step-size: 28px;
    }

    .score-footer {
      gap: 8px;
      font-size: 10px;
    }
  }
</style>

<script>
  const syncPitchToggleState = (score: HTMLElement) => {
    const tracks = Array.from(score.querySelectorAll<HTMLElement>(".expandable-track-group"));
    const allExpanded = tracks.length > 0 && tracks.every((track) => track.classList.contains("is-expanded"));
    const anyExpanded = tracks.some((track) => track.classList.contains("is-expanded"));
    score.classList.toggle("all-tracks-collapsed", !anyExpanded);

    score.querySelectorAll<HTMLButtonElement>("[data-pitch-toggle]").forEach((toggle) => {
      const track = toggle.closest<HTMLElement>(".expandable-track-group");
      const expanded = track?.classList.contains("is-expanded") ?? false;
      toggle.setAttribute("aria-expanded", String(expanded));
      toggle.setAttribute(
        "aria-label",
        `${toggle.dataset.trackName} ${expanded ? "zuklappen" : "aufklappen"}`
      );
    });

    score.querySelectorAll<HTMLButtonElement>("[data-expand-all]").forEach((toggle) => {
      toggle.setAttribute("aria-expanded", String(allExpanded));
      toggle.setAttribute("aria-label", allExpanded ? "Alle Spuren zuklappen" : "Alle Spuren aufklappen");
    });
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const globalButton = event.target.closest<HTMLButtonElement>("[data-expand-all]");
    const score = globalButton?.closest<HTMLElement>(".score-pattern");
    if (globalButton && score) {
      const tracks = Array.from(score.querySelectorAll<HTMLElement>(".expandable-track-group"));
      const shouldExpand = !tracks.every((track) => track.classList.contains("is-expanded"));
      tracks.forEach((track) => track.classList.toggle("is-expanded", shouldExpand));
      syncPitchToggleState(score);
      return;
    }

    const button = event.target.closest<HTMLButtonElement>("[data-pitch-toggle]");
    const track = button?.closest<HTMLElement>(".expandable-track-group");
    const scoreRoot = button?.closest<HTMLElement>(".score-pattern");
    if (!button || !track || !scoreRoot) return;

    track.classList.toggle("is-expanded");
    syncPitchToggleState(scoreRoot);
  });
</script>
