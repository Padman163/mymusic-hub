---
export interface Props {
  initialMode?: 1 | 2 | 3;
  scale?: string;
  exerciseTitle?: string;
}

const {
  initialMode = 1,
  scale = 'C-Dur',
  exerciseTitle = 'Interaktiver Score-Trainer'
} = Astro.props;

const intervalColors: Record<string, string> = {
  "1": "#F38181",
  "♭2": "#FFAAA6",
  "2": "#F4C7AB",
  "♭3": "#EAA0E3",
  "3": "#D382DC",
  "4": "#B862D3",
  "♭5": "#7F8BE8",
  "5": "#64C4ED",
  "♭6": "#52DEE5",
  "6": "#6BE4C6",
  "♭7": "#83E8BA",
  "7": "#CBDD7B",
  "8": "#F38181"
};
---

<div class="score-trainer" data-initial-mode={initialMode} data-scale={scale}>
  <div class="trainer-header">
    <h3>{exerciseTitle}</h3>
    <p class="scale-label">Tonleiter: {scale}</p>
  </div>

  <div class="mode-tabs">
    <button class="mode-tab active" data-mode="1">
      🎸 Stufe 1: TAB
    </button>
    <button class="mode-tab" data-mode="2">
      🎵 Stufe 2: Standard-Notation
    </button>
    <button class="mode-tab" data-mode="3">
      🎼 Stufe 3: Bassschlüssel
    </button>
  </div>

  <!-- STUFE 1: TAB-RASTER -->
  <div class="mode-content" data-mode="1" style="display: block;">
    <div class="tab-container">
      <div class="tab-strings">
        {['e', 'B', 'G', 'D', 'A', 'E'].map((string) => (
          <div class="tab-row" key={string} data-string={string}>
            <span class="string-label">{string}</span>
            <div class="tab-frets">
              {Array.from({ length: 13 }, (_, i) => (
                <input
                  key={i}
                  type="text"
                  class="tab-fret-input"
                  data-fret={i}
                  maxlength="2"
                  placeholder={i.toString()}
                  inputmode="numeric"
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="trainer-toolbar">
      <button class="toolbar-btn" data-action="mark-triad">🔴 Dreiklang markieren</button>
      <button class="toolbar-btn" data-action="check-tab">✓ Eingabe prüfen</button>
    </div>
  </div>

  <!-- STUFE 2: STANDARD-NOTATION -->
  <div class="mode-content" data-mode="2" style="display: none;">
    <div class="staff-container">
      <svg viewBox="0 0 800 150" class="treble-staff">
        <!-- Notenlinien -->
        {Array.from({ length: 5 }, (_, i) => (
          <line
            key={i}
            x1="40"
            y1={30 + i * 15}
            x2="760"
            y2={30 + i * 15}
            stroke="#333"
            stroke-width="1"
          />
        ))}
        <!-- Violinschlüssel Platzhalter -->
        <text x="20" y="90" font-size="48" font-family="serif">𝄞</text>
        <!-- Interaktive Notenpositionen -->
        {Array.from({ length: 8 }, (_, i) => (
          <circle
            key={i}
            class="note-position"
            cx={80 + i * 75}
            cy="95"
            r="12"
            fill="#f0f0f0"
            stroke="#d1d5da"
            stroke-width="2"
            data-note-idx={i}
            style={{ cursor: 'pointer' }}
          />
        ))}
      </svg>
    </div>
    <div class="notation-controls">
      <fieldset>
        <legend>Vorzeichen:</legend>
        <label>
          <input type="radio" name="accidental" value="natural" checked /> ♮ Auflösungszeichen
        </label>
        <label>
          <input type="radio" name="accidental" value="sharp" /> ♯ Kreuz
        </label>
        <label>
          <input type="radio" name="accidental" value="flat" /> ♭ Be
        </label>
      </fieldset>
      <fieldset>
        <legend>Notenwert:</legend>
        <label>
          <input type="radio" name="notehead" value="whole" /> Ganze Note
        </label>
        <label>
          <input type="radio" name="notehead" value="half" checked /> Halbe Note
        </label>
        <label>
          <input type="radio" name="notehead" value="quarter" /> Viertelnote
        </label>
        <label>
          <input type="radio" name="notehead" value="eighth" /> Achtelnote
        </label>
      </fieldset>
    </div>
    <div class="trainer-toolbar">
      <button class="toolbar-btn" data-action="mark-triad-staff">🔴 Dreiklang markieren</button>
      <button class="toolbar-btn" data-action="articulation-mode">🎯 Artikulation setzen</button>
      <button class="toolbar-btn" data-action="check-staff">✓ Eingabe prüfen</button>
    </div>
  </div>

  <!-- STUFE 3: BASSSCHLÜSSEL -->
  <div class="mode-content" data-mode="3" style="display: none;">
    <div class="staff-container">
      <div class="key-selector">
        <label for="basskey">Tonart (bis 3 ♯/♭):</label>
        <select id="basskey" name="basskey">
          <option value="C">C-Dur / a-Moll</option>
          <option value="G">G-Dur / e-Moll</option>
          <option value="D">D-Dur / h-Moll</option>
          <option value="A">A-Dur / fis-Moll</option>
          <option value="F">F-Dur / d-Moll</option>
          <option value="B">B-Dur / g-Moll</option>
          <option value="Es">Es-Dur / c-Moll</option>
        </select>
      </div>
      <svg viewBox="0 0 800 150" class="bass-staff">
        <!-- Notenlinien -->
        {Array.from({ length: 5 }, (_, i) => (
          <line
            key={i}
            x1="40"
            y1={30 + i * 15}
            x2="760"
            y2={30 + i * 15}
            stroke="#333"
            stroke-width="1"
          />
        ))}
        <!-- Bassschlüssel Platzhalter -->
        <text x="20" y="90" font-size="48" font-family="serif">𝄢</text>
        <!-- Vorzeichen werden dynamisch eingeblendet -->
        <g class="key-signature-display"></g>
        <!-- Interaktive Notenpositionen -->
        {Array.from({ length: 8 }, (_, i) => (
          <circle
            key={i}
            class="note-position-bass"
            cx={80 + i * 75}
            cy="95"
            r="12"
            fill="#f0f0f0"
            stroke="#d1d5da"
            stroke-width="2"
            data-note-idx={i}
            style={{ cursor: 'pointer' }}
          />
        ))}
      </svg>
    </div>
    <div class="trainer-toolbar">
      <button class="toolbar-btn" data-action="mark-triad-bass">🔴 Dreiklang markieren</button>
      <button class="toolbar-btn" data-action="check-bass">✓ Eingabe prüfen</button>
    </div>
  </div>

  <!-- FEEDBACK-BEREICH -->
  <div class="feedback-section" style="display: none;">
    <div class="feedback-box" data-feedback-type="success">
      <h4>✓ Korrekt!</h4>
      <p class="feedback-text"></p>
      <p class="xp-awarded">+10 XP</p>
    </div>
    <div class="feedback-box" data-feedback-type="error">
      <h4>✗ Nicht ganz richtig</h4>
      <p class="feedback-text"></p>
      <button class="btn-retry">Erneut versuchen</button>
    </div>
  </div>
</div>

<script>
  const trainer = document.querySelector('.score-trainer') as HTMLElement;
  if (!trainer) {
    throw new Error('Score trainer element not found');
  }

  const initialMode = trainer.getAttribute('data-initial-mode') || '1';
  const modeTabs = document.querySelectorAll('.mode-tab');
  const modeContents = document.querySelectorAll('.mode-content');

  // Tab-Umschaltung
  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = tab.getAttribute('data-mode');
      
      modeTabs.forEach((t) => t.classList.remove('active'));
      modeContents.forEach((c) => (c as HTMLElement).style.display = 'none');
      
      tab.classList.add('active');
      const content = trainer.querySelector(`[data-mode="${mode}"]`) as HTMLElement;
      if (content) content.style.display = 'block';
    });
  });

  // Toolbar-Aktionen
  const toolbarBtns = document.querySelectorAll('.toolbar-btn');
  toolbarBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-action');
      console.log('Action:', action);
      
      if (action === 'mark-triad') {
        alert('Dreiklang-Markierung aktiviert: Grundton (1), Terz (3), Quinte (5)');
      } else if (action === 'check-tab') {
        showFeedback('success', 'TAB-Eingabe ist korrekt!');
      } else if (action === 'check-staff' || action === 'check-bass') {
        showFeedback('success', 'Notation ist korrekt!');
      }
    });
  });

  // Feedback anzeigen
  function showFeedback(type: 'success' | 'error', message: string) {
    const feedbackSection = trainer.querySelector('.feedback-section') as HTMLElement;
    if (!feedbackSection) return;
    
    feedbackSection.style.display = 'block';
    const feedbackBox = feedbackSection.querySelector(`[data-feedback-type="${type}"]`) as HTMLElement;
    if (feedbackBox) {
      feedbackBox.style.display = 'block';
      const textEl = feedbackBox.querySelector('.feedback-text');
      if (textEl) textEl.textContent = message;
    }
  }
</script>

<style>
  .score-trainer {
    background: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
  }

  .trainer-header {
    margin-bottom: 20px;
  }

  .trainer-header h3 {
    margin: 0 0 8px 0;
    font-size: 1.5rem;
    color: #24292e;
  }

  .scale-label {
    margin: 0;
    font-size: 0.875rem;
    color: #586069;
  }

  .mode-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 2px solid #e1e4e8;
  }

  .mode-tab {
    padding: 12px 16px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: #586069;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-tab:hover {
    color: #24292e;
    background-color: #f6f8fa;
  }

  .mode-tab.active {
    color: #0366d6;
    border-bottom-color: #0366d6;
  }

  .mode-content {
    margin: 20px 0;
  }

  /* TAB-RASTER */
  .tab-container {
    background: #f6f8fa;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
    padding: 16px;
    overflow-x: auto;
  }

  .tab-strings {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tab-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .string-label {
    font-weight: 600;
    font-family: monospace;
    color: #24292e;
    min-width: 30px;
  }

  .tab-frets {
    display: flex;
    gap: 4px;
  }

  .tab-fret-input {
    width: 40px;
    height: 32px;
    padding: 4px;
    border: 1px solid #d1d5da;
    border-radius: 4px;
    font-family: monospace;
    text-align: center;
    font-size: 0.875rem;
  }

  .tab-fret-input:focus {
    outline: none;
    border-color: #0366d6;
    box-shadow: 0 0 0 3px rgba(3, 102, 214, 0.1);
  }

  /* STAFF */
  .staff-container {
    margin: 20px 0;
  }

  .treble-staff,
  .bass-staff {
    width: 100%;
    height: auto;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
    background: #ffffff;
    padding: 20px 0;
  }

  .note-position,
  .note-position-bass {
    transition: all 0.2s ease;
  }

  .note-position:hover,
  .note-position-bass:hover {
    fill: #f0f0f0;
    stroke: #0366d6;
    stroke-width: 3;
  }

  .key-selector {
    margin-bottom: 16px;
  }

  .key-selector label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #24292e;
  }

  .key-selector select {
    padding: 8px 12px;
    border: 1px solid #d1d5da;
    border-radius: 4px;
    font-size: 0.875rem;
  }

  .notation-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 20px 0;
  }

  .notation-controls fieldset {
    border: 1px solid #d1d5da;
    border-radius: 6px;
    padding: 12px;
  }

  .notation-controls legend {
    font-weight: 600;
    color: #24292e;
  }

  .notation-controls label {
    display: block;
    margin: 8px 0;
    cursor: pointer;
  }

  .notation-controls input[type="radio"] {
    margin-right: 8px;
  }

  .trainer-toolbar {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .toolbar-btn {
    padding: 8px 16px;
    background-color: #0366d6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toolbar-btn:hover {
    background-color: #0256c7;
  }

  .toolbar-btn:active {
    transform: scale(0.98);
  }

  .feedback-section {
    margin-top: 20px;
  }

  .feedback-box {
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 12px;
  }

  .feedback-box[data-feedback-type="success"] {
    background-color: #f1f8e9;
    border-left: 4px solid #7cb342;
    color: #558b2f;
  }

  .feedback-box[data-feedback-type="error"] {
    background-color: #ffebee;
    border-left: 4px solid #f44336;
    color: #c62828;
  }

  .feedback-box h4 {
    margin: 0 0 8px 0;
    font-size: 1rem;
  }

  .feedback-text {
    margin: 0 0 8px 0;
  }

  .xp-awarded {
    margin: 0;
    font-weight: 600;
    font-size: 1.125rem;
  }

  .btn-retry {
    margin-top: 8px;
    padding: 6px 12px;
    background-color: #f44336;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .btn-retry:hover {
    background-color: #d32f2f;
  }
</style>
