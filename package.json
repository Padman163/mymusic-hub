{
  "name": "mymusic-hub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome check --write src/",
    "check": "astro check",
    "verify": "biome check --write src/ && astro check",
    "status": "git status --short && printf '\\n--- root ---\\n' && ls -la && printf '\\n--- package scripts ---\\n' && node -e \"console.log(JSON.stringify(require('./package.json').scripts,null,2))\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "@coderline/alphatab": "^1.9.0",
    "@netlify/functions": "^6.1.0",
    "astro": "^7.4.5",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.6",
    "typescript": "^6.0.3"
  }
