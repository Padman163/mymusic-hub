{
  "name": "mymusic-hub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "biome check . && astro check && tsc --noEmit",
    "fix": "biome check --write .",
    "check": "astro check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/music-notation.test.mjs",
    "test:component": "vitest run tests/components",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --update-snapshots",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "audit": "npm audit --audit-level=high",
    "audit:lhci": "node scripts/run-lhci.mjs autorun",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/netlify": "^8.2.13",
    "@astrojs/starlight": "^0.42.10",
    "@coderline/alphatab": "^1.9.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "acorn": "^8.19.0",
    "astro": "^7.4.8",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.6",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@vitest/ui": "^5.1.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "katex": "^0.18.2",
    "@vercel/nft@1.3.1": {
      "glob": "^14.0.6"
    },
    "@netlify/zip-it-and-ship-it@16.6.0": {
      "minimatch": "^11.0.9"
    },
    "readdir-glob@3.0.0": {
      "minimatch": "^11.0.9"
    }
  }
}
