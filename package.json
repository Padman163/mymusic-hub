{
  "name": "mymusic-hub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test:watch": "vitest --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --update-snapshots",
    "test:node": "node --test tests/**/*.test.mjs",
    "check": "astro check",
    "audit": "npm audit --audit-level=high",
    "preflight": "npm run lint && npm run check && npx tsc --noEmit && npm run audit && npm test && npm run build && git diff --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "@coderline/alphatab": "^1.9.0",
    "@netlify/functions": "^6.1.1",
    "astro": "^7.4.5",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.6",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
