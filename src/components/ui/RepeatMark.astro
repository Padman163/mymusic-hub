---
import { renderRepeatEndSymbol, renderRepeatStart } from "../../lib/barline.ts";
import { sp } from "../../lib/notation-renderer.ts";
import "../../styles/music.css";

interface Props {
  type: "start" | "end";
}

const { type } = Astro.props;
const height = sp(4);
const mark =
  type === "start"
    ? renderRepeatStart(2, 0, height, 5.5, 9, sp(0.5))
    : renderRepeatEndSymbol(height);
---

<svg class={`repeat-${type}`} width="13" height={height} viewBox={`0 0 13 ${height}`} stroke="currentColor" role="img" aria-label={type === 'start' ? 'Beginn der Wiederholung' : 'Ende der Wiederholung'} set:html={mark} />
