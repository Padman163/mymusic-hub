---
interface Props {
  type: 'crescendo' | 'decrescendo';
  initialDynamic?: 'piano' | 'forte';
  placement?: 'row' | 'clickable';
}

const { type, initialDynamic, placement = 'row' } = Astro.props;
const startDynamic = type === 'crescendo' ? 'piano' : 'forte';
const showStartDynamic = initialDynamic !== startDynamic;
const crescendo = type === 'crescendo';
---

<div
  class:list={['dynamics-marks', `placement-${placement}`]}
  role="img"
  aria-label={crescendo
    ? showStartDynamic ? 'Crescendo von piano zu forte' : 'Crescendo bis forte'
    : showStartDynamic ? 'Decrescendo von forte zu piano' : 'Decrescendo bis piano'}
>
  <span class="dynamic-word">{crescendo ? 'cresc.' : 'decresc.'}</span>
  {showStartDynamic && <span class="dynamic-mark dynamic-start">{crescendo ? '\uE520' : '\uE522'}</span>}
  <span class="dynamic-mark dynamic-end">{crescendo ? '\uE522' : '\uE520'}</span>
  <svg class="hairpin" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
    {crescendo ? (
      <>
        <line x1="0" y1="6" x2="100" y2="0" />
        <line x1="0" y1="6" x2="100" y2="12" />
      </>
    ) : (
      <>
        <line x1="0" y1="0" x2="100" y2="6" />
        <line x1="0" y1="12" x2="100" y2="6" />
      </>
    )}
  </svg>
</div>

<style>
  .dynamics-marks {
    position: absolute;
    inset: 0;
    color: #111827;
  }

  .dynamic-word,
  .dynamic-mark,
  .hairpin {
    position: absolute;
    color: #111827;
  }

  .dynamic-word {
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-label-gap));
    left: calc(20% - 6px);
    font: italic 12px/1 Georgia, serif;
  }

  .dynamic-mark {
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-mark-gap));
    font: 30px/1 'NotationBravura';
  }

  .dynamic-start {
    right: calc(80% + 16px);
  }

  .dynamic-end {
    left: calc(80% + 16px);
  }

  .hairpin {
    left: calc(20% - 6px);
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-hairpin-gap));
    width: calc(60% + 12px);
    height: 10px;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1;
  }

  .placement-clickable {
    top: var(--notation-dynamics-top);
    right: 0;
    bottom: auto;
    left: 0;
    height: 48px;
    --dynamics-staff-bottom: 0px;
  }

  .placement-clickable .dynamic-start {
    right: calc(80% + 10px);
  }

  .placement-clickable .dynamic-end {
    left: calc(80% + 10px);
  }

  .placement-clickable .dynamic-word {
    left: calc(20% - 6px);
  }
</style>
