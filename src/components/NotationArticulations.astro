---
import NotationClickable from './NotationClickable.astro';
import { assertNoClefChanges } from '../lib/notation-renderer';

const articulations = [
  { type: 'staccato', label: 'Staccato', position: 'above', step: 7 },
  { type: 'tenuto', label: 'Tenuto', position: 'above', step: 7 },
  { type: 'accent', label: 'Akzent', position: 'above', step: 7 },
  { type: 'marcato', label: 'Marcato', position: 'above', step: 7 },
  { type: 'staccato', label: 'Staccato', position: 'below', step: 2 },
  { type: 'tenuto', label: 'Tenuto', position: 'below', step: 2 },
  { type: 'accent', label: 'Akzent', position: 'below', step: 2 },
  { type: 'marcato', label: 'Marcato', position: 'below', step: 2 }
] as const;
const clefs = articulations.map((_, index) => index === 0 || index === 4 ? 'treble' as const : false);
assertNoClefChanges(clefs, 'NotationArticulations');
---

<div class="articulation-examples not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="articulation-row">
    {articulations.map(({ type, position, step }, index) => (
      <div class="articulation-measure">
        <NotationClickable
          embedded
          clef={clefs[index]}
          rightBarStyle={index === articulations.length - 1 ? 'final' : 'single'}
          notes={[{ duration: 'quarter', step, articulation: type, articulationPosition: position }]}
        />
      </div>
    ))}
  </div>
  <div class="articulation-labels">
    {articulations.map(({ label, position }) => <span>{label} ({position === 'above' ? 'oben' : 'unten'})</span>)}
  </div>
</div>
