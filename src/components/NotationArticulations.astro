---
import NotationClickable from './NotationClickable.astro';

const articulations = [
  { type: 'staccato', label: 'Staccato' },
  { type: 'tenuto', label: 'Tenuto' },
  { type: 'accent', label: 'Akzent' },
  { type: 'marcato', label: 'Marcato' }
] as const;
---

<div class="articulation-examples not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="articulation-row">
    {articulations.map(({ type }, index) => (
      <div class="articulation-measure">
        <NotationClickable
          embedded
          clef={index === 0 ? 'treble' : undefined}
          rightBarStyle={index === articulations.length - 1 ? 'final' : 'single'}
          notes={[{ duration: 'quarter', step: 7, articulation: type }]}
        />
      </div>
    ))}
  </div>
  <div class="articulation-labels">
    {articulations.map(({ label }) => <span>{label}</span>)}
  </div>
</div>

<style>
  .articulation-examples {
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
    overflow-x: auto;
  }

  .articulation-row,
  .articulation-labels {
    display: flex;
    min-width: 500px;
  }

  .articulation-measure,
  .articulation-labels span {
    flex: 1 0 100px;
    min-width: 100px;
  }

  .articulation-labels {
    color: #111827;
    font: 0.875rem/1.3 Georgia, serif;
    text-align: center;
  }
</style>
