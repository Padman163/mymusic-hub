---
export interface Props {
  chords: string[];
  keyRoot?: string;
  scale?: "major" | "naturalMinor";
}

const { chords, keyRoot = "E", scale = "naturalMinor" } = Astro.props;

if (chords.length === 0) {
  throw new Error("Eine Akkordfolge muss mindestens einen Akkord enthalten.");
}

const pitchClasses = [
  "C",
  "C#",
  "D",
  "D#",
  "E",
  "F",
  "F#",
  "G",
  "G#",
  "A",
  "A#",
  "B",
];
const rootMatch = keyRoot.match(/^([A-G])(#?)$/);
if (!rootMatch) {
  throw new Error(
    `Ungültiger Tonart-Grundton "${keyRoot}". Erwartet wird z. B. E oder F#.`,
  );
}

const rootPitchClass = pitchClasses.indexOf(`${rootMatch[1]}${rootMatch[2]}`);
const scaleIntervals =
  scale === "major" ? [0, 2, 4, 5, 7, 9, 11] : [0, 2, 3, 5, 7, 8, 10];
const romanDegrees =
  scale === "major"
    ? ["I", "ii", "iii", "IV", "V", "vi", "vii°"]
    : ["i", "ii°", "III", "iv", "v", "VI", "VII"];
const progression = chords.map((chord) => {
  if (!chord.trim()) {
    throw new Error(
      "Akkordsymbole in einer Akkordfolge dürfen nicht leer sein.",
    );
  }
  const match = chord.match(/^([A-G])(#?)/);
  if (!match) return { chord, degree: "" };

  const chordRoot = pitchClasses.indexOf(`${match[1]}${match[2]}`);
  const degree = scaleIntervals.findIndex(
    (interval) => (rootPitchClass + interval) % 12 === chordRoot,
  );
  return { chord, degree: degree < 0 ? "" : romanDegrees[degree] };
});
---

<div
  class="chord-progression"
  style={`--chord-count: ${progression.length};`}
  aria-label={`Akkordfolge: ${progression.map(({ chord }) => chord).join(" – ")}`}
>
  {progression.map(({ chord, degree }, index) => (
    <div class={`chord-cell ${index % 2 === 1 ? "alternate-chord" : ""}`}>
      <span class="chord-name">{chord}</span>
      {degree && <span class="roman-degree">{degree}</span>}
    </div>
  ))}
</div>

<style>
  .chord-progression {
    display: grid;
    grid-template-columns: repeat(var(--chord-count), minmax(100px, 1fr));
    grid-template-rows: 44px;
    width: 100%;
    margin: 1rem 0;
    overflow: auto hidden;
    border: 1px solid #27272a;
    border-radius: 6px;
    background: #121212;
    color: #d1d5db;
    font-family: system-ui, -apple-system, sans-serif;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.25);
  }

  .chord-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    min-height: 44px;
    margin: 0 !important;
    padding: 0 12px;
    border-right: 1px solid #35383d;
    background: #18181b;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .chord-cell:last-child {
    border-right: 0;
  }

  .alternate-chord {
    background: #242428;
  }

  .chord-name {
    color: #f3f4f6;
    font-size: 15px;
    font-weight: 700;
  }

  .roman-degree {
    color: #9ca3af;
    font-size: 12px;
    font-weight: 600;
  }
</style>
