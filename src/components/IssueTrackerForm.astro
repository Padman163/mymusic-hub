<form id="issue-tracker-form" class="issue-tracker-form">
	<div id="contribution-type-field"></div>

	<div class="field">
		<label for="contribution-area">Bereich</label>
		<select id="contribution-area" name="area" required>
			<option value="">Bitte auswählen</option>
			<option value="Theorie">Theorie</option>
			<option value="Praxis">Praxis</option>
		</select>
	</div>

	<div class="field">
		<label for="contribution-title">Titel</label>
		<input
			id="contribution-title"
			name="title"
			type="text"
			maxlength="120"
			placeholder="Kurzer, aussagekräftiger Titel"
			required
		/>
	</div>

	<div class="field">
		<label for="contribution-description">Beschreibung</label>
		<textarea
			id="contribution-description"
			name="description"
			rows="7"
			maxlength="10000"
			placeholder="Worum geht es? Ergänze bei Bugs gern die Schritte zum Nachstellen."
			required
		></textarea>
	</div>

	<button type="submit">Beitrag speichern</button>
	<p class="form-status" role="status" aria-live="polite"></p>
</form>

<style>
	.issue-tracker-form {
		display: grid;
		gap: 1rem;
		max-width: 42rem;
	}

	.field {
		display: grid;
		gap: 0.4rem;
	}

	label {
		font-weight: 600;
	}

	input,
	select,
	textarea {
		box-sizing: border-box;
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0.65rem 0.75rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
	}

	textarea {
		resize: vertical;
	}

	button {
		justify-self: start;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0.65rem 0.9rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	button:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}

	.form-status {
		margin: 0;
	}

	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>

<script>
	import { createTypePicker, isContributionType } from '../lib/contribution-types';
	import { isContributionArea } from '../lib/contribution-area';

	const form = document.querySelector<HTMLFormElement>('#issue-tracker-form');

	if (!(form instanceof HTMLFormElement)) {
		throw new Error('Das Projektierungsformular wurde nicht gefunden.');
	}

	const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
	const status = form.querySelector<HTMLParagraphElement>('.form-status');
	const typeContainer = form.querySelector<HTMLDivElement>('#contribution-type-field');

	if (!(submitButton instanceof HTMLButtonElement) || !(status instanceof HTMLParagraphElement) || !(typeContainer instanceof HTMLDivElement)) {
		throw new Error('Die Rückmeldung des Projektierungsformulars wurde nicht gefunden.');
	}

	const typePicker = createTypePicker('Bug');
	typeContainer.append(typePicker);

	form.addEventListener('submit', async (event) => {
		event.preventDefault();

		const typeField = form.elements.namedItem('type');
		const areaField = form.elements.namedItem('area');
		const titleField = form.elements.namedItem('title');
		const descriptionField = form.elements.namedItem('description');

		if (
			!(typeField instanceof RadioNodeList) ||
			!(areaField instanceof HTMLSelectElement) ||
			!(titleField instanceof HTMLInputElement) ||
			!(descriptionField instanceof HTMLTextAreaElement)
		) {
			throw new Error('Die Felder des Projektierungsformulars sind unvollständig.');
		}

		const type = typeField.value;
		if (!isContributionType(type)) {
			status.textContent = 'Bitte wähle einen gültigen Eintragstyp.';
			return;
		}

		const area = areaField.value;
		if (!isContributionArea(area)) {
			status.textContent = 'Bitte wähle einen gültigen Bereich.';
			return;
		}

		const title = titleField.value.trim();
		if (!title) {
			titleField.setCustomValidity('Bitte gib einen Titel ein.');
			titleField.reportValidity();
			titleField.setCustomValidity('');
			return;
		}

		const description = descriptionField.value.trim();
		if (!description) {
			descriptionField.setCustomValidity('Bitte gib eine Beschreibung ein.');
			descriptionField.reportValidity();
			descriptionField.setCustomValidity('');
			return;
		}

		status.textContent = 'Beitrag wird gespeichert …';
		submitButton.disabled = true;
		typePicker.disabled = true;
		areaField.disabled = true;
		titleField.disabled = true;
		descriptionField.disabled = true;
		form.dispatchEvent(new CustomEvent('contribution:busy', { bubbles: true, detail: true }));

		try {
			const response = await fetch('/api/contributions', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ type, area, title, description }),
			});

			const result: unknown = await response.json();
			if (!response.ok) {
				const message =
					typeof result === 'object' &&
					result !== null &&
					'error' in result &&
					typeof result.error === 'string'
						? result.error
						: 'Der Beitrag konnte nicht gespeichert werden.';
				throw new Error(message);
			}

			status.textContent = 'Beitrag wurde gespeichert.';
			form.reset();
			form.dispatchEvent(new CustomEvent('contribution:created', { bubbles: true, detail: result }));
		} catch (error) {
			status.textContent =
				error instanceof Error
					? error.message
					: 'Der Beitrag konnte wegen eines unerwarteten Fehlers nicht gespeichert werden.';
		} finally {
			submitButton.disabled = false;
			typePicker.disabled = false;
			areaField.disabled = false;
			titleField.disabled = false;
			descriptionField.disabled = false;
			form.dispatchEvent(new CustomEvent('contribution:busy', { bubbles: true, detail: false }));
		}
	});
</script>
