---
const strings = ["e", "B", "G", "D", "A", "E"];
// Vergrößerte Saitenabstände analog zum FretboardClickable
const stringY = [37.5, 82.5, 127.5, 172.5, 217.5, 262.5];
const fretWidth = 75;
const startX = 60; // Start-X für das Griffbrettholz (Platz für Saiten-Labels)

// Wir zeigen nun 6 Bünde: 11 bis 16
const fretX = (fret: number) => startX + (fret - 11 + 0.5) * fretWidth;
const fretWireX = (fretIndex: number) => startX + fretIndex * fretWidth;

// Farbpalette
const intervalColors: Record<string, string> = {
  "1": "#F38181", // Grundton
  "♭2": "#FFAAA6",
  "2": "#F4C7AB",
  "♭3": "#EAA0E3", // kleine Terz
  "3": "#D382DC",
  "4": "#B862D3", // reine Quarte
  "♭5": "#7F8BE8", // Tritonus
  "5": "#64C4ED", // reine Quinte
  "♭6": "#52DEE5",
  "6": "#6BE4C6",
  "♭7": "#83E8BA", // kleine Septime
  "7": "#CBDD7B",
  "8": "#F38181", // Oktave
};

const intervalNames: Record<string, string> = {
  "1": "Grundton",
  "♭2": "kleine Sekunde",
  "2": "große Sekunde",
  "♭3": "kleine Terz",
  "3": "große Terz",
  "4": "reine Quarte",
  "♭5": "Tritonus",
  "5": "reine Quinte",
  "♭6": "kleine Sexte",
  "6": "große Sexte",
  "♭7": "kleine Septime",
  "7": "große Septime",
  "8": "Oktave",
};

// Definition der vier Galerie-Ansichten
const views = [
  {
    id: "roots",
    title: "Root-Noten",
    subtitle: "1",
    scaleNotes: ["E"],
    notes: [
      { stringIndex: 0, fret: 12, note: "E", degree: "1" },
      { stringIndex: 3, fret: 14, note: "E", degree: "1" },
      { stringIndex: 5, fret: 12, note: "E", degree: "1" },
    ],
  },
  {
    id: "triad",
    title: "Dreiklang",
    subtitle: "1 · ♭3 · 5",
    scaleNotes: ["E", "G", "B"],
    notes: [
      { stringIndex: 0, fret: 12, note: "E", degree: "1" },
      { stringIndex: 0, fret: 15, note: "G", degree: "♭3" },
      { stringIndex: 1, fret: 12, note: "B", degree: "5" },
      { stringIndex: 2, fret: 12, note: "G", degree: "♭3" },
      { stringIndex: 3, fret: 14, note: "E", degree: "1" },
      { stringIndex: 4, fret: 14, note: "B", degree: "5" },
      { stringIndex: 5, fret: 12, note: "E", degree: "1" },
      { stringIndex: 5, fret: 15, note: "G", degree: "♭3" },
    ],
  },
  {
    id: "pentatonic",
    title: "Pentatonik",
    subtitle: "1 · ♭3 · 4 · 5 · ♭7",
    scaleNotes: ["E", "G", "A", "B", "D"],
    notes: [
      { stringIndex: 0, fret: 12, note: "E", degree: "1" },
      { stringIndex: 0, fret: 15, note: "G", degree: "♭3" },
      { stringIndex: 1, fret: 12, note: "B", degree: "5" },
      { stringIndex: 1, fret: 15, note: "D", degree: "♭7" },
      { stringIndex: 2, fret: 12, note: "G", degree: "♭3" },
      { stringIndex: 2, fret: 14, note: "A", degree: "4" },
      { stringIndex: 3, fret: 12, note: "D", degree: "♭7" },
      { stringIndex: 3, fret: 14, note: "E", degree: "1" },
      { stringIndex: 4, fret: 12, note: "A", degree: "4" },
      { stringIndex: 4, fret: 14, note: "B", degree: "5" },
      { stringIndex: 5, fret: 12, note: "E", degree: "1" },
      { stringIndex: 5, fret: 15, note: "G", degree: "♭3" },
    ],
  },
  {
    id: "minor",
    title: "Natürliches Moll",
    subtitle: "1 · 2 · ♭3 · 4 · 5 · ♭6 · ♭7",
    scaleNotes: ["E", "F#", "G", "A", "B", "C", "D"],
    notes: [
      { stringIndex: 0, fret: 12, note: "E", degree: "1" },
      { stringIndex: 0, fret: 14, note: "F#", degree: "2" },
      { stringIndex: 0, fret: 15, note: "G", degree: "♭3" },
      { stringIndex: 1, fret: 12, note: "B", degree: "5" },
      { stringIndex: 1, fret: 13, note: "C", degree: "♭6" },
      { stringIndex: 1, fret: 15, note: "D", degree: "♭7" },
      { stringIndex: 2, fret: 11, note: "F#", degree: "2" },
      { stringIndex: 2, fret: 12, note: "G", degree: "♭3" },
      { stringIndex: 2, fret: 14, note: "A", degree: "4" },
      { stringIndex: 3, fret: 12, note: "D", degree: "♭7" },
      { stringIndex: 3, fret: 14, note: "E", degree: "1" },
      { stringIndex: 4, fret: 12, note: "A", degree: "4" },
      { stringIndex: 4, fret: 14, note: "B", degree: "5" },
      { stringIndex: 4, fret: 15, note: "C", degree: "♭6" },
      { stringIndex: 5, fret: 12, note: "E", degree: "1" },
      { stringIndex: 5, fret: 14, note: "F#", degree: "2" },
      { stringIndex: 5, fret: 15, note: "G", degree: "♭3" },
    ],
  },
];

// Dynamische Legende
const degreeOrder = [
  "1",
  "♭2",
  "2",
  "♭3",
  "3",
  "4",
  "♭5",
  "5",
  "♭6",
  "6",
  "♭7",
  "7",
  "8",
];
const usedDegrees = Array.from(
  new Set(views.flatMap((v) => v.notes.map((n) => n.degree))),
).sort((a, b) => degreeOrder.indexOf(a) - degreeOrder.indexOf(b));
---

<!-- Startklasse: show-intervals -->
<div class="scale-gallery is-gallery show-intervals">
  <div class="toolbar">
    <nav class="scale-gallery-nav" aria-label="Skalen-Ansichten">
      {views.map((view, index) => (
        <button
          class="gallery-button"
          type="button"
          data-view-index={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {view.title}
        </button>
      ))}
    </nav>
    <div class="display-toggle" aria-label="Anzeige umschalten">
      <button class="toggle-btn" type="button" data-display="intervals" aria-pressed="true">Intervalle</button>
      <button class="toggle-btn" type="button" data-display="notes" aria-pressed="false">Noten</button>
    </div>
  </div>

  <div class="scale-diagrams" aria-label="E-Moll Lagen-Übersicht">
    {views.map((view, index) => (
      <article
        class="scale-card"
        data-view-index={index}
        hidden={index !== 0}
      >
        <header class="scale-heading">
          <span class="degree-label">Intervalle: {view.subtitle}</span>
          <h4>E-Moll {view.title}</h4>
        </header>

        <p class="scale-notes" aria-label={`Tonfolge: ${view.scaleNotes.join(", ")}`}>
          {view.scaleNotes.map((note) => <span>{note}</span>)}
        </p>

        <svg
          viewBox="0 0 550 330"
          role="img"
          aria-label={`${view.title} in der Gitarrenlage am 11. bis 16. Bund.`}
          class="fretboard-svg"
        >
          <!-- 1. Griffbrett-Holz -->
          <rect x={startX} y="15" width={6 * fretWidth} height="270" rx="4" fill="#18181b" stroke="#27272a" stroke-width="2" />

          <!-- 2. Bund-Marker -->
          <circle cx={fretX(12)} cy="60" r="9" fill="#76767c" />
          <circle cx={fretX(12)} cy="240" r="9" fill="#76767c" />
          <circle cx={fretX(15)} cy="150" r="9" fill="#76767c" />

          <!-- 3. Bundstäbchen -->
          {[0, 1, 2, 3, 4, 5, 6].map((i) => (
            <line x1={fretWireX(i)} y1="15" x2={fretWireX(i)} y2="285" stroke="#3f3f46" stroke-width="3" />
          ))}

          <!-- 4. Bund-Zahlen -->
          {[11, 12, 13, 14, 15, 16].map((fret) => (
            <text x={fretX(fret)} y="318" text-anchor="middle" fill="#71717a" font-size="18">
              {fret}
            </text>
          ))}

          <!-- 5. Saiten -->
          {strings.map((stringName, i) => (
            <>
              <text x={startX - 15} y={stringY[i]} text-anchor="end" dominant-baseline="central" fill="#a1a1aa" font-size="18" font-weight="bold">
                {stringName}
              </text>
              <line x1={startX} y1={stringY[i]} x2={startX + 6 * fretWidth} y2={stringY[i]} stroke="#a1a1aa" stroke-width={1.8 + (i * 0.6)} />
            </>
          ))}

          <!-- 6. Die Noten (beide Text-Ebenen) -->
          {view.notes.map(({ stringIndex, fret, note, degree }) => {
            const displayInterval = degree === "1" ? "R" : degree;
            return (
              <g aria-label={`${note}, Stufe ${degree}${degree === '1' ? ", Grundton" : ""}`}>
                <circle 
                  cx={fretX(fret)} 
                  cy={stringY[stringIndex]} 
                  r="19.5" 
                  fill={intervalColors[degree]} 
                  style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.6));"
                />
                <!-- Label: Intervall -->
                <text 
                  class="label-interval"
                  x={fretX(fret)} 
                  y={stringY[stringIndex]} 
                  text-anchor="middle" 
                  dominant-baseline="central" 
                  fill="#000" 
                  font-size={displayInterval.length > 1 ? "14" : "16"} 
                  font-weight="800"
                >
                  {displayInterval}
                </text>
                <!-- Label: Notenname -->
                <text 
                  class="label-note"
                  x={fretX(fret)} 
                  y={stringY[stringIndex]} 
                  text-anchor="middle" 
                  dominant-baseline="central" 
                  fill="#000" 
                  font-size={note.length > 1 ? "14" : "16"} 
                  font-weight="800"
                >
                  {note}
                </text>
              </g>
            );
          })}
        </svg>
      </article>
    ))}
  </div>

  <p class="legend">
    {usedDegrees.map((degree) => (
      <span><i class="dot" style={`background-color: ${intervalColors[degree]};`}></i> {degree === '1' ? 'R' : degree} ({intervalNames[degree]})</span>
    ))}
  </p>
</div>

<script>
  function setupScaleGallery() {
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      
      // 1. Logik für die Skalen-Reiter
      const viewButton = target.closest<HTMLButtonElement>(".gallery-button");
      if (viewButton) {
        const gallery = viewButton.closest(".scale-gallery");
        if (!gallery) return;

        const selectedIndex = Number(viewButton.dataset.viewIndex);
        
        gallery.querySelectorAll<HTMLButtonElement>(".gallery-button").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(Number(btn.dataset.viewIndex) === selectedIndex));
        });
        
        gallery.querySelectorAll<HTMLElement>(".scale-card").forEach((card) => {
          card.hidden = Number(card.dataset.viewIndex) !== selectedIndex;
        });
        return;
      }

      // 2. Logik für den Kippschalter (Intervalle vs. Noten)
      const displayButton = target.closest<HTMLButtonElement>(".toggle-btn");
      if (displayButton) {
        const gallery = displayButton.closest(".scale-gallery");
        if (!gallery) return;

        const mode = displayButton.dataset.display; // "intervals" oder "notes"
        
        gallery.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((btn) => {
          btn.setAttribute("aria-pressed", String(btn.dataset.display === mode));
        });

        if (mode === "notes") {
          gallery.classList.remove("show-intervals");
          gallery.classList.add("show-notes");
        } else {
          gallery.classList.remove("show-notes");
          gallery.classList.add("show-intervals");
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupScaleGallery);
  document.addEventListener('astro:page-load', setupScaleGallery);
</script>

<style>
  .scale-gallery {
    margin: 1rem 0 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* Toolbar erzwingt einzeiliges Flex-Layout */
  .toolbar {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important; /* Wrapper erlaubt sauberen Umbruch nur auf sehr kleinen Mobile-Screens */
    justify-content: space-between !important;
    align-items: center !important;
    gap: 1rem !important;
    margin: 1.25rem 0 0.75rem !important;
  }

  /* Blockiert externe CSS-Eingriffe von Starlight/Tailwind (margin-top: 1em) auf direkte Kinder */
  .toolbar > * {
    margin: 0 !important;
  }

  .scale-gallery-nav {
    display: flex !important;
    width: max-content;
    height: 2.5rem;
    flex-flow: row nowrap !important;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-button {
    display: flex;
    min-width: 6rem;
    height: 2.5rem;
    flex: 0 0 auto;
    margin: 0 !important;
    align-self: center;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 1.2rem;
    border: 1px solid #3f3f46;
    border-radius: 999px;
    background: #18181b;
    color: #d4d4d8;
    cursor: pointer;
    font: 600 0.9rem system-ui, -apple-system, sans-serif;
    line-height: 1;
    transition: all 0.2s ease;
  }

  .gallery-button[aria-pressed="true"] {
    border-color: #F38181;
    background: #3b2727;
    color: #faf5ff;
  }

  .gallery-button:focus-visible {
    outline: 2px solid #F38181;
    outline-offset: 3px;
  }

  .display-toggle {
    display: flex !important;
    flex: 0 0 auto;
    background: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 999px;
    overflow: hidden;
    height: 2.5rem;
    align-items: stretch;
  }

  .toggle-btn {
    margin: 0 !important; /* Hebelt ungewolltes Margin hart aus */
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #a1a1aa;
    border: none;
    padding: 0 1.25rem;
    font: 600 0.85rem system-ui, -apple-system, sans-serif;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn[aria-pressed="true"] {
    background: #3f3f46;
    color: #f4f4f5;
  }

  .toggle-btn:focus-visible {
    outline: 2px solid #F38181;
    outline-offset: -2px;
  }

  /* CSS-Logik für das Ein-/Ausblenden der Label-Ebenen */
  .scale-gallery.show-intervals .label-note {
    display: none;
  }
  .scale-gallery.show-notes .label-interval {
    display: none;
  }

  .scale-diagrams {
    display: block;
    width: 100%;
  }

  .scale-card {
    padding: 1.75rem;
    border: 1px solid #303036;
    border-radius: 10px;
    background: linear-gradient(145deg, #1b1b20, #121214);
    box-shadow: 0 5px 16px rgb(0 0 0 / 18%);
    color: #e4e4e7;
  }

  .scale-card[hidden] {
    display: none;
  }

  .scale-heading {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .scale-heading h4 {
    margin: 0;
    color: #fafafa;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .degree-label {
    color: #FFAAA6;
    font-size: 0.85rem;
    font-weight: 650;
  }

  .scale-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }

  .scale-notes span {
    min-width: 2rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #27272a;
    color: #f4f4f5;
    text-align: center;
    font-weight: 700;
  }

  .fretboard-svg {
    width: 100%;
    max-width: 550px;
    height: auto;
    display: block;
    user-select: none;
  }

  .fretboard-svg text {
    font-family: system-ui, -apple-system, sans-serif;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.25rem 0 0;
    color: #a1a1aa;
    font-size: 0.9rem;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend .dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
  }
</style>