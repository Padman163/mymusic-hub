---
import NotationClickable from './NotationClickable.astro';

const sharpSteps = [8, 5, 9, 6, 3] as const;
const flatSteps = [4, 7, 3, 6, 2] as const;
---

<div class="accidental-examples not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="accidental-row">
    <div class="accidental-measure">
      <NotationClickable embedded clef="treble" accidentals={sharpSteps.map((step) => ({ type: 'sharp', step }))} />
    </div>
    <div class="accidental-measure">
      <NotationClickable embedded accidentals={sharpSteps.map((step) => ({ type: 'natural', step }))} />
    </div>
    <div class="accidental-measure">
      <NotationClickable embedded accidentals={flatSteps.map((step) => ({ type: 'flat', step }))} />
    </div>
  </div>
</div>

<style>
  .accidental-examples {
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .accidental-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  }

  .accidental-measure {
    min-width: 0;
  }

  .accidental-measure:first-child {
    grid-column: span 2;
  }
</style>
