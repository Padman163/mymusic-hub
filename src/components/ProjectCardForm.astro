---
// Form to create new feature cards
// Saves to src/data/todo-cards.json
---

<form id="project-card-form" class="card-form">
	<div class="form-section">
		<h3>Neue Feature Card erstellen</h3>
	</div>

	<div class="field">
		<label for="card-id">Card ID *</label>
		<input
			id="card-id"
			name="cardId"
			type="text"
			placeholder="z.B. FEAT-101-A"
			pattern="FEAT-\d{3}-[A-Z]"
			maxlength="20"
			required
		/>
		<small>Format: FEAT-XXX-A (z.B. FEAT-101-A)</small>
	</div>

	<div class="field">
		<label for="card-title">Titel *</label>
		<input
			id="card-title"
			name="title"
			type="text"
			maxlength="120"
			placeholder="z.B. Interaktives Gitarren-Tuning & Frequenz-Check"
			required
		/>
	</div>

	<div class="field">
		<label for="card-category">Kategorie *</label>
		<input
			id="card-category"
			name="category"
			type="text"
			placeholder="z.B. Praxis 101"
			maxlength="50"
			required
		/>
	</div>

	<div class="field-row">
		<div class="field">
			<label for="card-status">Status *</label>
			<select id="card-status" name="status" required>
				<option value="">-- Wählen --</option>
				<option value="Geplant">Geplant</option>
				<option value="In Arbeit">In Arbeit</option>
				<option value="Bereit">Bereit</option>
				<option value="Konzept">Konzept</option>
			</select>
		</div>

		<div class="field">
			<label for="card-difficulty">Schwierigkeit *</label>
			<select id="card-difficulty" name="difficulty" required>
				<option value="">-- Wählen --</option>
				<option value="Basis">Basis</option>
				<option value="Mittel">Mittel</option>
				<option value="Fortgeschritten">Fortgeschritten</option>
				<option value="Master">Master</option>
			</select>
		</div>
	</div>

	<div class="field">
		<label for="card-tags">Tags (kommagetrennt) *</label>
		<input
			id="card-tags"
			name="tags"
			type="text"
			placeholder="z.B. Gitarre, Audio, D1-relevant"
			required
		/>
		<small>Kommagetrennte Tags für Filterung</small>
	</div>

	<div class="field">
		<label for="card-description">Beschreibung</label>
		<textarea
			id="card-description"
			name="description"
			rows="5"
			placeholder="Detaillierte Beschreibung der Feature..."
		></textarea>
	</div>

	<div class="field">
		<label for="card-tasks">Teilaufgaben (zeilenweise)</label>
		<textarea
			id="card-tasks"
			name="tasks"
			rows="4"
			placeholder="Jeweils eine Aufgabe pro Zeile&#10;z.B.&#10;Frequenzmessung per Mikrofon aktivieren&#10;Live-Needle-Anzeige implementieren"
		></textarea>
		<small>Jeweils eine Aufgabe pro Zeile</small>
	</div>

	<div class="field">
		<label for="card-comment">Kommentar hinzufügen (optional)</label>
		<div class="comment-input-group">
			<select id="card-comment-role" name="commentRole">
				<option value="Dev">Dev</option>
				<option value="Didaktik">Didaktik</option>
				<option value="Audio">Audio</option>
			</select>
			<textarea
				id="card-comment"
				name="comment"
				rows="2"
				placeholder="Optionaler Kommentar..."
			></textarea>
		</div>
	</div>

	<button type="submit" class="submit-btn">Feature Card erstellen</button>
</form>

<style>
	.card-form {
		display: grid;
		gap: 1.5rem;
		max-width: 50rem;
		padding: 1.5rem;
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	.form-section {
		margin-top: 0;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--sl-color-accent);
	}

	.form-section h3 {
		margin: 0;
		color: var(--sl-color-accent);
	}

	.field {
		display: grid;
		gap: 0.4rem;
	}

	.field-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	label {
		font-weight: 600;
		font-size: 0.95rem;
	}

	input[type="text"],
	input[type="email"],
	select,
	textarea {
		box-sizing: border-box;
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		padding: 0.65rem 0.75rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font: inherit;
		font-size: 0.95rem;
	}

	textarea {
		resize: vertical;
		font-family: 'Monaco', 'Menlo', monospace;
		font-size: 0.9rem;
	}

	select {
		cursor: pointer;
	}

	small {
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}

	.comment-input-group {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.5rem;
		align-items: start;
	}

	.comment-input-group select {
		min-height: calc(2rem + 1.3em);
	}

	.submit-btn {
		justify-self: start;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.4rem;
		padding: 0.75rem 1.5rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-gray-0);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.submit-btn:hover {
		opacity: 0.9;
		transform: translateY(-1px);
		box-shadow: 0 2px 8px var(--sl-color-accent);
	}

	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	input:invalid {
		border-color: #d32f2f;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#project-card-form');

	if (!form) {
		throw new Error('Card-Formular nicht gefunden');
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();

		// Form-Felder validieren
		const cardId = (form.elements.namedItem('cardId') as HTMLInputElement)?.value.trim();
		const title = (form.elements.namedItem('title') as HTMLInputElement)?.value.trim();
		const category = (form.elements.namedItem('category') as HTMLInputElement)?.value.trim();
		const status = (form.elements.namedItem('status') as HTMLSelectElement)?.value;
		const difficulty = (form.elements.namedItem('difficulty') as HTMLSelectElement)?.value;
		const tagsInput = (form.elements.namedItem('tags') as HTMLInputElement)?.value.trim();
		const description = (form.elements.namedItem('description') as HTMLTextAreaElement)?.value.trim();
		const tasksInput = (form.elements.namedItem('tasks') as HTMLTextAreaElement)?.value.trim();
		const comment = (form.elements.namedItem('comment') as HTMLTextAreaElement)?.value.trim();
		const commentRole = (form.elements.namedItem('commentRole') as HTMLSelectElement)?.value;

		// Validierung
		if (!cardId || !title || !category || !status || !difficulty || !tagsInput) {
			alert('Bitte fülle alle erforderlichen Felder aus');
			return;
		}

		// Card-Daten zusammensetzen
		const tags = tagsInput.split(',').map((t) => t.trim());
		const tasks = tasksInput
			? tasksInput.split('\n').filter((t) => t.trim()).map((t) => ({
					text: t.trim(),
					completed: false
				}))
			: [];
		const comments = comment
			? [
					{
						author: commentRole,
						role: commentRole,
						text: comment
					}
				]
			: [];

		const newCard = {
			id: cardId,
			title,
			status,
			category,
			difficulty,
			tags,
			description: description || '',
			tasks,
			comments,
			createdAt: new Date().toISOString(),
			createdBy: 'web-form'
		};

		try {
			// Karte an Backend senden
			const response = await fetch('/api/create-card', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(newCard)
			});

			if (!response.ok) {
				throw new Error(`Server error: ${response.status}`);
			}

			alert('✅ Feature Card erfolgreich erstellt!');
			form.reset();

			// Seite neu laden um die neue Card zu zeigen
			setTimeout(() => {
				window.location.reload();
			}, 500);
		} catch (error) {
			console.error('Fehler beim Erstellen der Card:', error);
			alert('❌ Fehler beim Erstellen der Card. Siehe Console für Details.');
		}
	});
</script>
