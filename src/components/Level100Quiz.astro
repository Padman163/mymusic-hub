          prompt: 'Trage eine Viertelnote ein.'
        },
        {
          id: 'eighth',
          duration: 'eighth',
          name: 'Achtelnote',
          prompt: 'Trage eine Achtelnote ein.'
        },
        {
          id: 'sixteenth',
          duration: 'sixteenth',
          name: 'Sechzehntelnote',
          prompt: 'Trage eine Sechzehntelnote ein.'
        }
      ];
      let previousNoteValueId: string | undefined;
      let activeDurationTarget: NoteValueTarget = noteValueTargets[1];
      const durationNamesGerman: Record<string, string> = {
        whole: 'Ganze Note',
        half: 'Halbe Note',
        quarter: 'Viertelnote',
        eighth: 'Achtelnote',
        sixteenth: 'Sechzehntelnote'
      };

      const advancedNotationQuestion = (item: NotationQuestion): NotationQuestion => {
        const withSameScore = (prompt: string, answer: string, wrong: string[]): NotationQuestion => ({
          id: item.id,
          prompt,
          answer,
          options: [answer, ...wrong],
          musicXmlUrl: item.musicXmlUrl,
          group: item.group
        });

        if (item.group === 1) {
          const notes = ['C4', 'D4', 'E4', 'F4', 'G4', 'A4', 'B4', 'C5', 'D5', 'E5', 'F5', 'G5', 'A5'];
          const noteIndex = notes.indexOf(item.answer);
          if (noteIndex < 0 || noteIndex + 3 >= notes.length) {
            throw new Error(`Keine Terz über der notierten Note ${item.answer} verfügbar.`);
          }
          return withSameScore(
            'Welcher Ton liegt eine Terz über dem abgebildeten Ton?',
            notes[noteIndex + 2],
            [notes[noteIndex + 1], notes[noteIndex + 3]]
          );
        }

        if (item.group === 2) {
          const noteValue = item.id.replace('note-value-', '');
          const countByValue: Record<string, number> = {
            whole: 1,
            half: 2,
            quarter: 4,
            eighth: 8,
            sixteenth: 16
          };
          const count = countByValue[noteValue];
          if (!count) throw new Error(`Unbekannter Notenwert in Frage ${item.id}.`);
          const alternatives = [1, 2, 4, 8, 16].filter((value) => value !== count);
          const wrong = alternatives
            .sort((left, right) => Math.abs(left - count) - Math.abs(right - count))
            .slice(0, 2)
            .map(String);
          return withSameScore(
            'Wie viele dieser Noten passen in einen vollständigen 4/4-Takt?',
            String(count),
            wrong
          );
        }

        if (item.group === 3) {
          const noteByString: Record<string, string> = {
            'tab-string-high-e': 'F♯4',
            'tab-string-b': 'C♯4',
            'tab-string-g': 'A3',
            'tab-string-d': 'E3',
            'tab-string-a': 'B2',
            'tab-string-low-e': 'F♯2'
          };
          const answer = noteByString[item.id];
          if (!answer) throw new Error(`Keine Tonhöhe für TAB-Frage ${item.id} hinterlegt.`);
          const noteNames = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B'];
          const match = answer.match(/^([A-G]♯?)(\d)$/);
          if (!match) throw new Error(`Ungültiger Tonname ${answer} in TAB-Frage ${item.id}.`);
          const noteIndex = noteNames.indexOf(match[1]);
          const midi = (Number(match[2]) + 1) * 12 + noteIndex;
          const pitchAt = (value: number) => `${noteNames[((value % 12) + 12) % 12]}${Math.floor(value / 12) - 1}`;
          return withSameScore(
            'Welcher Ton erklingt auf der notierten Saite im zweiten Bund?',
            answer,
            [pitchAt(midi - 1), pitchAt(midi + 1)]
          );
        }

        if (item.group === 4) {
          const noteCountByExample: Record<string, number> = {
            'mixed-values-half-two-quarters': 3,
            'mixed-values-four-quarters': 4,
            'mixed-values-quarters-and-eighths': 6,
            'mixed-values-dotted-half-quarter': 2
          };
          const count = noteCountByExample[item.id];
          if (!count) throw new Error(`Keine Notenzahl für MusicXML-Frage ${item.id} hinterlegt.`);
          const alternatives = [2, 3, 4, 6].filter((value) => value !== count);
          return withSameScore(
            'Wie viele einzelne Noten sind in diesem Beispiel notiert?',
            String(count),
            alternatives.slice(0, 2).map(String)
          );
        }

        if (item.group === 5) {
          const answerByMeter: Record<string, [string, string, string]> = {
            'time-signature-three-four': ['3 Viertelwerte pro Takt', '4 Viertelwerte pro Takt', '2 Halbe pro Takt'],
            'time-signature-two-two': ['2 Halbe pro Takt', '3 Viertelwerte pro Takt', '4 Viertelwerte pro Takt'],
            'time-signature-four-four': ['4 Viertelwerte pro Takt', '3 Viertelwerte pro Takt', '6 Achtelwerte pro Takt'],
            'time-signature-six-eight': ['6 Achtelwerte pro Takt, meist in zwei Dreiergruppen', '3 Viertelwerte pro Takt', '2 Halbe pro Takt']
          };
          const [answer, ...wrong] = answerByMeter[item.id] ?? [];
          if (!answer) throw new Error(`Keine Taktstruktur für MusicXML-Frage ${item.id} hinterlegt.`);
          return withSameScore(
            'Welche Zählstruktur gehört zur Taktart, die sich aus dem Notenbeispiel ergibt?',
            answer,
            wrong
          );
        }

        throw new Error(`MusicXML-Frage ${item.id} hat keine gültige Kategorie.`);
      };

      const updateFretboardTokens = () => {
        fretboardTray.querySelectorAll<HTMLButtonElement>('.fretboard-note-token').forEach((token) => {
          const note = token.dataset.note;
          if (!note) return;
          const placed = placedFretboardNotes.has(note);
          token.hidden = placed;
          token.textContent = note;
          token.dataset.placed = String(placed);
          token.setAttribute('aria-pressed', String(note === selectedFretboardNote));
          token.setAttribute('aria-label', `Note ${note} zum Platzieren auswählen`);
        });
      };

      const clearFretboardNode = (node: SVGGElement) => {
        const placedNote = node.dataset.placedNote;
        if (placedNote) placedFretboardNotes.delete(placedNote);
        delete node.dataset.placedNote;
        node.removeAttribute('data-correct');
        node.classList.remove('active');
        const label = node.querySelector<SVGTextElement>('.note-text-active');
        if (label) label.textContent = node.dataset.note ?? '';
        node.setAttribute('aria-label', node.dataset.originalAriaLabel ?? 'Griffbrettposition');
      };

      const placeFretboardNote = (note: string, node: SVGGElement) => {
        if (!activeFretboardNotes.includes(note) || !fretboardNodes.includes(node)) return;
        const displacedNote = node.dataset.placedNote;
        if (displacedNote && displacedNote !== note) clearFretboardNode(node);
        const previousNode = placedFretboardNotes.get(note);
        if (previousNode && previousNode !== node) clearFretboardNode(previousNode);

        node.dataset.placedNote = note;
        node.classList.add('active');
        const label = node.querySelector<SVGTextElement>('.note-text-active');
        if (label) label.textContent = note;
        node.setAttribute('aria-label', `Abgelegte Note ${note}, Saite ${node.dataset.string}, Bund ${node.dataset.fret}`);
        placedFretboardNotes.set(note, node);
        selectedFretboardNote = undefined;
        updateFretboardTokens();
        clearFeedback();
      };

      fretboardNodes.forEach((node) => {
        node.dataset.originalAriaLabel = node.getAttribute('aria-label') ?? 'Griffbrettposition';
        node.addEventListener('dragover', (event) => {
          event.preventDefault();
          node.classList.add('drag-over');
        });
        node.addEventListener('dragleave', (event) => {
          if (event.relatedTarget instanceof Node && node.contains(event.relatedTarget)) return;
          node.classList.remove('drag-over');
        });
        node.addEventListener('drop', (event) => {
          event.preventDefault();
          node.classList.remove('drag-over');
          const note = event.dataTransfer?.getData('text/plain') || selectedFretboardNote;
          if (note) placeFretboardNote(note, node);
        });
        node.addEventListener('click', () => {
          if (node.dataset.placedNote) {
            clearFretboardNode(node);
            selectedFretboardNote = undefined;
            updateFretboardTokens();
            clearFeedback();
            return;
          }
          if (selectedFretboardNote) placeFretboardNote(selectedFretboardNote, node);
        });
        node.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            if (node.dataset.placedNote) {
              clearFretboardNode(node);
              selectedFretboardNote = undefined;
              updateFretboardTokens();
              clearFeedback();
            } else if (selectedFretboardNote) {
              placeFretboardNote(selectedFretboardNote, node);
            }
          }
        });
      });

      const selectQuestions = <T extends QuizQuestion>(category: string, pool: T[]): T[] => {
        const key = `${difficulty}:${category}`;
        const previous = previousQuestionIds.get(key) ?? new Set<string>();
        let candidates = pool.filter((item) => !previous.has(item.id));
        if (candidates.length < 5) candidates = pool;
        const selected = shuffle([...candidates]).slice(0, 5);
        previousQuestionIds.set(key, new Set(selected.map((item) => item.id)));
        return selected;
      };

      const selectGroupedNotation = (pool: NotationQuestion[]): NotationQuestion[] =>
        ([] as number[]).map((group) => {
          const groupPool = pool.filter((item) => item.group === group);
          if (!groupPool.length) throw new Error(`MusicXML-Fragenpool ${group} ist leer.`);
          const key = `${difficulty}:notation-group-${group}`;
          const previous = previousQuestionIds.get(key) ?? new Set<string>();
          let candidates = groupPool.filter((item) => !previous.has(item.id));
          if (!candidates.length) {
            previous.clear();
            candidates = groupPool;
          }
          const selected = shuffle(candidates)[0];
          previous.add(selected.id);
          previousQuestionIds.set(key, previous);
          return selected;
        });

      const createQuestion = (item: QuizQuestion, category: string, index: number, diagram?: Diagram) => {
        const fieldset = document.createElement('fieldset');
        fieldset.className = `quiz-question${diagram ? ' notation-question' : ''}`;
        fieldset.dataset.answer = item.answer;
        fieldset.dataset.active = 'true';

        const legend = document.createElement('legend');
        legend.textContent = `${index + 1}. ${item.prompt}`;
        fieldset.append(legend);

        if (diagram) fieldset.append(renderNotationDiagram(diagram, index));

        const options = document.createElement('div');
        options.className = 'answer-options';
        shuffle([...item.options]).forEach((option) => {
          const label = document.createElement('label');
          label.className = 'answer-option';
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `${difficulty}-${category}-${index}`;
          input.value = option;
          const text = document.createElement('span');
          text.textContent = option;
          label.append(input, text);
          options.append(label);
        });
        fieldset.append(options);

        const feedback = document.createElement('p');
        feedback.className = 'question-feedback';
        feedback.setAttribute('aria-live', 'polite');
        fieldset.append(feedback);
        return fieldset;
      };

      const clearFeedback = () => {
        result.textContent = '';
        result.removeAttribute('data-passed');
        quiz.querySelectorAll<HTMLElement>('.quiz-question').forEach((question) => {
          question.removeAttribute('data-correct');
          const feedback = question.querySelector<HTMLElement>('.question-feedback');
          if (feedback) feedback.textContent = '';
        });
        quiz.querySelectorAll<HTMLElement>('.pattern-candidate .step-cell').forEach((cell) => {
          cell.removeAttribute('data-correct');
        });
        fretboardNodes.forEach((node) => node.removeAttribute('data-correct'));
        fretboardTray.querySelectorAll<HTMLElement>('.fretboard-note-token').forEach((token) => {
          token.removeAttribute('data-correct');
        });
        fretboardFeedback.textContent = '';
        builderTask.removeAttribute('data-correct');
        if (builderQuestion) builderQuestion.removeAttribute('data-correct');
        builderFeedback.textContent = '';
        if (builderRetryBtn) builderRetryBtn.hidden = true;
        durationBuilderTask.removeAttribute('data-correct');
        if (durationBuilderQuestion) durationBuilderQuestion.removeAttribute('data-correct');
        durationBuilderFeedback.textContent = '';
        if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = true;
      };

      const renderQuiz = (reshuffleNotation = true) => {
        const bank = banks[difficulty];
        const basics = selectQuestions('basics', bank.basics);
        const rhythm = selectQuestions('rhythm', bank.rhythm);
        if (reshuffleNotation || activeNotationExamples.length === 0) {
          activeNotationExamples = selectGroupedNotation(banks["1"].notation);
        }
        const notation = difficulty === '1'
          ? activeNotationExamples
          : activeNotationExamples.map(advancedNotationQuestion);
        basicsList.replaceChildren(...basics.map((item, index) => createQuestion(item, 'basics', index)));
        rhythmList.replaceChildren(...rhythm.map((item, index) => createQuestion(item, 'rhythm', index)));
        activeFretboardNotes = shuffle([
          ...new Set(bank.fretboard.map((item) => item.answer.replace(/\d+$/, '')))
        ]).slice(0, 5);
        if (activeFretboardNotes.length !== 5) {
          throw new Error('Für das Griffbrettquiz werden fünf unterschiedliche Töne benötigt.');
        }
        placedFretboardNotes.clear();
        selectedFretboardNote = undefined;
        fretboardNodes.forEach(clearFretboardNode);
        fretboardTray.replaceChildren(...activeFretboardNotes.map((note) => {
          const token = document.createElement('button');
          token.type = 'button';
          token.className = 'fretboard-note-token';
          token.draggable = true;
          token.dataset.note = note;
          token.textContent = note;
          const matchingNode = fretboardNodes.find(
            (node) => node.dataset.note?.replaceAll('#', '♯') === note
          );
          if (!matchingNode?.dataset.color) {
            throw new Error(`Keine Griffbrettfarbe für den Ton ${note} gefunden.`);
          }
          token.style.setProperty('--note-color', matchingNode.dataset.color);
          token.setAttribute('aria-pressed', 'false');
          token.setAttribute('aria-label', `Note ${note} zum Platzieren auswählen`);
          token.addEventListener('click', () => {
            selectedFretboardNote = selectedFretboardNote === note ? undefined : note;
            clearFeedback();
            updateFretboardTokens();
          });
          token.addEventListener('dragstart', (event) => {
            if (!event.dataTransfer) return;
            selectedFretboardNote = note;
            event.dataTransfer.setData('text/plain', note);
            event.dataTransfer.effectAllowed = 'move';
            updateFretboardTokens();
          });
          token.addEventListener('dragend', () => {
            fretboardNodes.forEach((node) => node.classList.remove('drag-over'));
          });
          return token;
        }));
        const cardsById = new Map(
          [...musicXmlQuestionBank.querySelectorAll<HTMLElement>('.musicxml-question')]
            .map((card) => [card.dataset.questionId, card] as const)
        );
        cardsById.forEach((card) => {
          card.hidden = true;
          card.dataset.active = 'false';
        });
        notation.forEach((item, index) => {
          const card = cardsById.get(item.id);
          if (!card || !item.musicXmlUrl) {
            throw new Error(`MusicXML-Frage ${item.id} ist nicht vollständig eingebunden.`);
          }
          card.hidden = false;
          card.dataset.active = 'true';
          card.dataset.answer = item.answer;
          const legend = card.querySelector('legend');
          if (legend) legend.textContent = `${index + 5}. ${item.prompt}`;
          const player = card.querySelector<HTMLElement>('[data-sheet-music-player]');
          if (player?.dataset.xml !== item.musicXmlUrl) {
            throw new Error(`MusicXML-Datei für Frage ${item.id} stimmt nicht mit der Einbindung überein.`);
          }
          const options = card.querySelector<HTMLElement>('.answer-options');
          if (!options) throw new Error(`Antwortmöglichkeiten für MusicXML-Frage ${item.id} fehlen.`);
          options.replaceChildren(...shuffle([...item.options]).map((option) => {
            const label = document.createElement('label');
            label.className = 'answer-option';
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `${difficulty}-notation-${index + 5}`;
            input.value = option;
            const text = document.createElement('span');
            text.textContent = option;
            label.append(input, text);
            return label;
          }));
          card.removeAttribute('data-correct');
          const feedback = card.querySelector<HTMLElement>('.question-feedback');
          if (feedback) feedback.textContent = '';
        });

        const renderStaticNotationQuestion = (
          targets: StaticNotationTarget[],
          previousId: string | undefined,
          currentTarget: StaticNotationTarget,
          candidates: NodeListOf<HTMLElement>,
          idAttr: 'dynamicsId' | 'articulationId',
          questionEl: HTMLElement,
          promptEl: HTMLElement,
          optionsEl: HTMLElement,
          inputName: string,
        ): { target: StaticNotationTarget; nextPreviousId: string } => {
          let chosen = currentTarget;
          let nextPrevId = previousId ?? currentTarget.id;
          if (reshuffleNotation || previousId === undefined) {
            const candidatePool = targets.filter((item) => item.id !== previousId);
            chosen = shuffle(candidatePool.length ? candidatePool : targets)[0];
            nextPrevId = chosen.id;
          }
          candidates.forEach((candidate) => {
            candidate.hidden = candidate.dataset[idAttr] !== chosen.id;
          });
          const qPrompt = difficulty === '1' ? chosen.prompt : chosen.advancedPrompt;
          const qAnswer = difficulty === '1' ? chosen.answer : chosen.advancedAnswer;
          const qOpts = difficulty === '1' ? chosen.options : chosen.advancedOptions;
          promptEl.textContent = qPrompt;
          questionEl.dataset.answer = qAnswer;
          questionEl.removeAttribute('data-correct');
          const qFeedback = questionEl.querySelector<HTMLElement>('.question-feedback');
          if (qFeedback) qFeedback.textContent = '';
          optionsEl.replaceChildren(...shuffle([...qOpts]).map((option) => {
            const label = document.createElement('label');
            label.className = 'answer-option';
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = inputName;
            input.value = option;
            const text = document.createElement('span');
            text.textContent = option;
            label.append(input, text);
            return label;
          }));
          return { target: chosen, nextPreviousId: nextPrevId };
        };

        const dynState = renderStaticNotationQuestion(
          dynamicsTargets,
          previousDynamicsId,
          activeDynamicsTarget,
          dynamicsCandidates,
          'dynamicsId',
          dynamicsQuestion,
          dynamicsPrompt,
          dynamicsOptions,
          `${difficulty}-notation-4`,
        );
        activeDynamicsTarget = dynState.target;
        previousDynamicsId = dynState.nextPreviousId;

        const artState = renderStaticNotationQuestion(
          articulationTargets,
          previousArticulationId,
          activeArticulationTarget,
          articulationCandidates,
          'articulationId',
          articulationQuestion,
          articulationPrompt,
          articulationOptions,
          `${difficulty}-notation-5`,
        );
        activeArticulationTarget = artState.target;
        previousArticulationId = artState.nextPreviousId;

        document.dispatchEvent(new Event('level100:notation-update'));
        const previousPatternId = previousPatternIds.get(difficulty);
        const patternCandidatesForDifficulty = bank.patterns.filter((pattern) => pattern.id !== previousPatternId);
        const pattern = shuffle(patternCandidatesForDifficulty.length ? patternCandidatesForDifficulty : bank.patterns)[0];
        previousPatternIds.set(difficulty, pattern.id);
        const layoutId = `${pattern.timeSignature.replace('/', '-')}-${pattern.resolution.replace('/', '-')}`;
        const activeCandidate = [...patternCandidates].find((candidate) => candidate.dataset.layout === layoutId);
        if (!activeCandidate) throw new Error(`Kein DrumPattern-Raster für ${layoutId} vorhanden.`);

        patternCandidates.forEach((candidate) => {
          candidate.hidden = candidate !== activeCandidate;
          candidate.querySelectorAll<HTMLElement>('.step-cell').forEach((cell) => {
            cell.classList.remove('active');
            cell.removeAttribute('data-correct');
            cell.style.backgroundColor = '';
          });
        });
        const patternRow = activeCandidate.querySelector<HTMLElement>('.track-row:not(.velocity-row)');
        const patternColor = patternRow?.dataset.color;
        if (!patternRow || !patternColor) throw new Error('Die Rhythmusspur konnte nicht geladen werden.');
        pattern.activeSteps.forEach((step) => {
          const cell = patternRow.querySelector<HTMLElement>(`.step-cell[data-step="${step}"]`);
          if (!cell) throw new Error(`Rhythmus-Step ${step} fehlt im Pattern.`);
          cell.classList.add('active');
          cell.style.backgroundColor = patternColor;
        });
        patternQuestion.replaceChildren(createQuestion({
          id: pattern.id,
          prompt: 'Welche Aussage trifft auf dieses Rhythmusmuster zu?',
          answer: pattern.answer,
          options: pattern.options
        }, 'rhythm-pattern', 0));
        activeCandidate.setAttribute(
          'aria-label',
          `DrumPattern ${pattern.timeSignature}, Auflösung ${pattern.resolution}`
        );
        builderAttempts = 0;
        durationBuilderAttempts = 0;
        if (builderLockBtn) builderLockBtn.disabled = false;
        if (durationBuilderLockBtn) durationBuilderLockBtn.disabled = false;
        if (builderRetryTimer) builderRetryTimer.textContent = String(MAX_BUILDER_ATTEMPTS);
        if (durationBuilderRetryTimer) durationBuilderRetryTimer.textContent = String(MAX_BUILDER_ATTEMPTS);

        const candidateFourNotes = fourNotesTargets.filter((item) => item.id !== previousFourNotesId);
        const chosenFourNotes = shuffle(candidateFourNotes.length ? candidateFourNotes : fourNotesTargets)[0];
        previousFourNotesId = chosenFourNotes.id;
        activeBuilderTarget = chosenFourNotes;
        builderPrompt.textContent = activeBuilderTarget.prompt;
        builderTask.removeAttribute('data-correct');
        if (builderQuestion) builderQuestion.removeAttribute('data-correct');
        builderFeedback.textContent = '';
        if (builderRetryBtn) builderRetryBtn.hidden = true;
        delete builderEl.dataset.locked;
        builderEl.dispatchEvent(new CustomEvent('notationbuilder:reset', { detail: { step: 4 } }));

        const candidateNoteValues = noteValueTargets.filter((item) => item.id !== previousNoteValueId);
        const chosenNoteValue = shuffle(candidateNoteValues.length ? candidateNoteValues : noteValueTargets)[0];
        previousNoteValueId = chosenNoteValue.id;
        activeDurationTarget = chosenNoteValue;
        durationBuilderPrompt.textContent = activeDurationTarget.prompt;
        durationBuilderTask.removeAttribute('data-correct');
        if (durationBuilderQuestion) durationBuilderQuestion.removeAttribute('data-correct');
        durationBuilderFeedback.textContent = '';
        if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = true;
        delete durationBuilderEl.dataset.locked;
        const initialDurationReset = activeDurationTarget.duration === 'quarter' ? 'half' : 'quarter';
        durationBuilderEl.dispatchEvent(new CustomEvent('notationbuilder:reset', { detail: { step: 4, duration: initialDurationReset } }));

        const total = 20;
        const passing = Math.ceil(total * 0.8);
        quiz.dataset.totalPoints = String(total);
        quiz.dataset.passingPoints = String(passing);
        totalPointsLabel.textContent = String(total);
        passingPointsLabel.textContent = String(passing);
        result.textContent = '';
        result.removeAttribute('data-passed');
        difficultyButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.difficulty === difficulty));
        });
        difficultyStatus.textContent = `Schwierigkeit ${difficulty}: ${difficulty === '1' ? 'Grundlagen' : 'Vertiefung'}`;
      };

      difficultyButtons.forEach((button) => {
        if (button.dataset.difficulty === '2') {
          button.disabled = !unlocked;
          if (unlocked) button.textContent = 'Schwierigkeit 2';
        }
        button.addEventListener('click', () => {
          if (button.disabled || (button.dataset.difficulty !== '1' && button.dataset.difficulty !== '2')) return;
          difficulty = button.dataset.difficulty;
          renderQuiz(false);
          window.scrollTo(0, 0);
        });
      });

      form.addEventListener('change', () => {
        clearFeedback();
      });

      const evaluateBuilderAnswer = (_isSubmit = false): boolean => {
        const placedStepsRaw = builderEl.dataset.placedSteps;
        let placedSteps: (number | null)[] = [];
        try {
          if (placedStepsRaw) placedSteps = JSON.parse(placedStepsRaw);
        } catch {
          placedSteps = [];
        }
        const placedNotesRaw = builderEl.dataset.placedNotes;
        let placedNotes: (string | null)[] = [];
        try {
          if (placedNotesRaw) placedNotes = JSON.parse(placedNotesRaw);
        } catch {
          placedNotes = [];
        }

        if (builderTask.dataset.correct === 'true') {
          return true;
        }
        if (builderAttempts >= MAX_BUILDER_ATTEMPTS) {
          builderTask.dataset.correct = 'false';
          if (builderQuestion) builderQuestion.dataset.correct = 'false';
          return false;
        }

        const filledCount = placedSteps.filter((s) => s !== null && s !== undefined).length;
        const targetSteps = activeBuilderTarget.steps;
        const targetNotesStr = activeBuilderTarget.notes.join(' – ');

        const isBuilderCorrect =
          filledCount === targetSteps.length &&
          placedSteps.length === targetSteps.length &&
          placedSteps.every((step, index) => {
            if (step === null || step === undefined) return false;
            const targetNote = activeBuilderTarget.notes[index];
            const hasExplicitOctave = /\d/.test(targetNote);
            if (hasExplicitOctave) {
              const placedNoteName = placedNotes[index];
              return (
                placedNoteName?.toUpperCase() === targetNote.toUpperCase() ||
                step === targetSteps[index]
              );
            }
            const placedNoteName = placedNotes[index];
            const placedLetter = placedNoteName
              ? placedNoteName.replace(/\d+$/, '').toUpperCase()
              : undefined;
            const targetLetter = targetNote.replace(/\d+$/, '').toUpperCase();
            const moduloMatch =
              ((step % 7) + 7) % 7 === ((targetSteps[index] % 7) + 7) % 7;
            return placedLetter ? placedLetter === targetLetter : moduloMatch;
          });

        if (isBuilderCorrect) {
          builderTask.dataset.correct = 'true';
          if (builderQuestion) builderQuestion.dataset.correct = 'true';
          if (builderRetryBtn) builderRetryBtn.hidden = true;
          if (builderLockBtn) builderLockBtn.disabled = true;
          builderEl.dataset.locked = 'true';
          builderEl.blur();
          builderFeedback.textContent = `Richtig! Noten ${targetNotesStr} als Viertelnoten platziert.`;
          return true;
        }

        builderAttempts += 1;
        const remainingAttempts = Math.max(0, MAX_BUILDER_ATTEMPTS - builderAttempts);
        if (builderRetryTimer) builderRetryTimer.textContent = String(remainingAttempts);

        builderTask.dataset.correct = 'false';
        if (builderQuestion) builderQuestion.dataset.correct = 'false';

        const placedNotesFormatted = placedNotes.map((n) => n ? n.replace(/\d+$/, '') : '?').join(' – ');

        if (remainingAttempts <= 0) {
          if (builderRetryBtn) builderRetryBtn.hidden = true;
          if (builderLockBtn) builderLockBtn.disabled = true;
          builderEl.dataset.locked = 'true';
          builderEl.blur();
          builderFeedback.textContent = `Aufgabe nicht bestanden (${MAX_BUILDER_ATTEMPTS} von ${MAX_BUILDER_ATTEMPTS} Versuche verbraucht). Gesucht: 4 Viertelnoten (${targetNotesStr}).`;
        } else {
          if (builderRetryBtn) builderRetryBtn.hidden = false;
          const attemptsWord = remainingAttempts === 1 ? 'Versuch' : 'Versuche';
          if (filledCount === 0) {
            builderFeedback.textContent = `Keine Noten platziert. Gesucht: 4 Viertelnoten (${targetNotesStr}). (Noch ${remainingAttempts} ${attemptsWord})`;
          } else if (filledCount < targetSteps.length) {
            builderFeedback.textContent = `Erst ${filledCount} von ${targetSteps.length} Noten platziert. Gesucht: ${targetNotesStr}. (Noch ${remainingAttempts} ${attemptsWord})`;
          } else {
            builderFeedback.textContent = `Noch nicht ganz richtig. Platziert: ${placedNotesFormatted}. Gesucht: ${targetNotesStr}. (Noch ${remainingAttempts} ${attemptsWord})`;
          }
        }

        return false;
      };

      builderLockBtn?.addEventListener('click', () => {
        evaluateBuilderAnswer(false);
      });

      builderEl.addEventListener('notationbuilder:submit', () => {
        if (!builderLockBtn?.disabled) {
          evaluateBuilderAnswer(false);
        }
      });

      builderQuestion?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          if ((event.target as HTMLElement)?.closest('.notation-builder-retry-button')) {
            return;
          }
          event.preventDefault();
          if (!builderLockBtn?.disabled) {
            evaluateBuilderAnswer(false);
          }
        }
      });

      builderRetryBtn?.addEventListener('click', () => {
        if (builderAttempts >= MAX_BUILDER_ATTEMPTS) return;
        const candidateFourNotes = fourNotesTargets.filter(
          (item) => item.id !== activeBuilderTarget.id,
        );
        const chosenFourNotes = shuffle(
          candidateFourNotes.length ? candidateFourNotes : fourNotesTargets,
        )[0];
        previousFourNotesId = chosenFourNotes.id;
        activeBuilderTarget = chosenFourNotes;
        builderPrompt.textContent = activeBuilderTarget.prompt;
        builderTask.removeAttribute('data-correct');
        if (builderQuestion) builderQuestion.removeAttribute('data-correct');
        builderFeedback.textContent = '';
        if (builderRetryBtn) builderRetryBtn.hidden = true;
        builderEl.dispatchEvent(
          new CustomEvent('notationbuilder:reset', { detail: { step: 4 } }),
        );
      });

      builderEl.addEventListener('notationbuilder:change', () => {
        if (builderEl.dataset.locked === 'true' || builderAttempts >= MAX_BUILDER_ATTEMPTS) return;
        builderTask.removeAttribute('data-correct');
        builderQuestion?.removeAttribute('data-correct');
        builderFeedback.textContent = '';
      });

      const evaluateDurationBuilderAnswer = (_isSubmit = false): boolean => {
        if (durationBuilderTask.dataset.correct === 'true') {
          return true;
        }
        if (durationBuilderAttempts >= MAX_BUILDER_ATTEMPTS) {
          durationBuilderTask.dataset.correct = 'false';
          if (durationBuilderQuestion) durationBuilderQuestion.dataset.correct = 'false';
          return false;
        }

        const placedStepRaw = durationBuilderEl.dataset.placedStep;
        const placedDuration = durationBuilderEl.dataset.placedDuration;

        const isDurationCorrect =
          placedStepRaw !== undefined &&
          Boolean(placedDuration) &&
          placedDuration === activeDurationTarget.duration;

        if (isDurationCorrect) {
          durationBuilderTask.dataset.correct = 'true';
          if (durationBuilderQuestion) durationBuilderQuestion.dataset.correct = 'true';
          if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = true;
          if (durationBuilderLockBtn) durationBuilderLockBtn.disabled = true;
          durationBuilderEl.dataset.locked = 'true';
          durationBuilderEl.blur();
          durationBuilderFeedback.textContent = `Richtig! ${activeDurationTarget.name} platziert.`;
          return true;
        }

        durationBuilderAttempts += 1;
        const remainingAttempts = Math.max(0, MAX_BUILDER_ATTEMPTS - durationBuilderAttempts);
        if (durationBuilderRetryTimer) durationBuilderRetryTimer.textContent = String(remainingAttempts);

        durationBuilderTask.dataset.correct = 'false';
        if (durationBuilderQuestion) durationBuilderQuestion.dataset.correct = 'false';

        const placedDurationName = placedDuration ? (durationNamesGerman[placedDuration] ?? placedDuration) : undefined;

        if (remainingAttempts <= 0) {
          if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = true;
          if (durationBuilderLockBtn) durationBuilderLockBtn.disabled = true;
          durationBuilderEl.dataset.locked = 'true';
          durationBuilderEl.blur();
          durationBuilderFeedback.textContent = `Aufgabe nicht bestanden (${MAX_BUILDER_ATTEMPTS} von ${MAX_BUILDER_ATTEMPTS} Versuche verbraucht). Gesucht: ${activeDurationTarget.name}.`;
        } else {
          if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = false;
          const attemptsWord = remainingAttempts === 1 ? 'Versuch' : 'Versuche';
          if (!placedDuration) {
            durationBuilderFeedback.textContent = `Noch keine Note platziert. Wähle den Notenwert "${activeDurationTarget.name}" (Toolbar oder Num 1) und platziere die Note mit der Leertaste. (Noch ${remainingAttempts} ${attemptsWord})`;
          } else {
            durationBuilderFeedback.textContent = `Noch nicht richtig. Platziert: ${placedDurationName}. Gesucht: ${activeDurationTarget.name}. (Noch ${remainingAttempts} ${attemptsWord})`;
          }
        }

        return false;
      };

      durationBuilderLockBtn?.addEventListener('click', () => {
        evaluateDurationBuilderAnswer(false);
      });

      durationBuilderEl.addEventListener('notationbuilder:submit', () => {
        if (!durationBuilderLockBtn?.disabled) {
          evaluateDurationBuilderAnswer(false);
        }
      });

      durationBuilderQuestion?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          if ((event.target as HTMLElement)?.closest('.notation-duration-builder-retry-button')) {
            return;
          }
          event.preventDefault();
          if (!durationBuilderLockBtn?.disabled) {
            evaluateDurationBuilderAnswer(false);
          }
        }
      });

      durationBuilderRetryBtn?.addEventListener('click', () => {
        if (durationBuilderAttempts >= MAX_BUILDER_ATTEMPTS) return;
        const candidateNoteValues = noteValueTargets.filter(
          (item) => item.id !== activeDurationTarget.id,
        );
        const chosenNoteValue = shuffle(
          candidateNoteValues.length ? candidateNoteValues : noteValueTargets,
        )[0];
        previousNoteValueId = chosenNoteValue.id;
        activeDurationTarget = chosenNoteValue;
        durationBuilderPrompt.textContent = activeDurationTarget.prompt;
        durationBuilderTask.removeAttribute('data-correct');
        if (durationBuilderQuestion)
          durationBuilderQuestion.removeAttribute('data-correct');
        durationBuilderFeedback.textContent = '';
        if (durationBuilderRetryBtn) durationBuilderRetryBtn.hidden = true;
        const initialDurationReset =
          activeDurationTarget.duration === 'quarter' ? 'half' : 'quarter';
        durationBuilderEl.dispatchEvent(
          new CustomEvent('notationbuilder:reset', {
            detail: { step: 4, duration: initialDurationReset },
          }),
        );
      });

      durationBuilderEl.addEventListener('notationbuilder:change', () => {
        if (durationBuilderEl.dataset.locked === 'true' || durationBuilderAttempts >= MAX_BUILDER_ATTEMPTS) return;
        durationBuilderTask.removeAttribute('data-correct');
        durationBuilderQuestion?.removeAttribute('data-correct');
        durationBuilderFeedback.textContent = '';
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        let score = 0;

        quiz.querySelectorAll<HTMLElement>('.quiz-question[data-active="true"]:not(.notation-builder-question):not(.notation-duration-builder-question)').forEach((question) => {
          const answer = question.dataset.answer;
          const selected = question.querySelector<HTMLInputElement>('input:checked');
          const isCorrect = selected?.value === answer;
          if (isCorrect) score += 1;
          question.dataset.correct = String(isCorrect);
          const feedback = question.querySelector<HTMLElement>('.question-feedback');
          if (feedback) {
            feedback.textContent = selected
              ? isCorrect
                ? 'Richtig.'
                : `Noch nicht richtig. Lösung: ${answer}`
              : `Nicht beantwortet. Lösung: ${answer}`;
          }
        });

        let correctFretboardNotes = 0;
        activeFretboardNotes.forEach((note) => {
          const node = placedFretboardNotes.get(note);
          const token = fretboardTray.querySelector<HTMLButtonElement>(`.fretboard-note-token[data-note="${note}"]`);
          const isCorrect = node?.dataset.note?.replaceAll('#', '♯') === note;
          if (isCorrect) {
            score += 1;
            correctFretboardNotes += 1;
          }
          if (node) node.dataset.correct = String(isCorrect);
          if (token) token.dataset.correct = String(isCorrect);
        });
        fretboardFeedback.textContent = `Griffbrett: ${correctFretboardNotes} von 5 Tönen richtig platziert.`;

        const isBuilderCorrect = evaluateBuilderAnswer(true);
        if (isBuilderCorrect) score += 1;

        const isDurationCorrect = evaluateDurationBuilderAnswer(true);
        if (isDurationCorrect) score += 1;

        const total = Number(quiz.dataset.totalPoints);
        const passing = Number(quiz.dataset.passingPoints);
        const percentage = Math.round((score / total) * 100);
        const passed = score >= passing;
        result.dataset.passed = String(passed);
        result.textContent = passed
          ? `Bestanden! ${score} von ${total} Punkten (${percentage} %). Du hast die erforderlichen ${passing} Punkte erreicht.`
          : `Noch nicht bestanden: ${score} von ${total} Punkten (${percentage} %). Zum Bestehen brauchst du ${passing} Punkte.`;
        if (passed && difficulty === '1' && !unlocked) {
          unlocked = true;
          localStorage.setItem(unlockKey, 'true');
          quiz.querySelectorAll<HTMLButtonElement>('[data-difficulty="2"]').forEach((advancedButton) => {
            advancedButton.disabled = false;
            advancedButton.textContent = 'Schwierigkeit 2 freigeschaltet';
          });
          difficultyStatus.textContent = 'Schwierigkeit 2 ist jetzt dauerhaft freigeschaltet.';
        }
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      resetButton.addEventListener('click', () => {
        renderQuiz();
        window.scrollTo(0, 0);
      });

      renderQuiz();
    });
  }

  setupLevel100Quiz();
  document.addEventListener('astro:page-load', setupLevel100Quiz);
</script>
