<script>
  import { renderNotationSvg } from '../lib/notation-renderer';
  import type { Duration } from '../lib/rhythm';

  type QuizQuestion = { id: string; prompt: string; options: string[]; answer: string };
  type FretboardQuestion = QuizQuestion & { stringIndex: number; fret: number };
  type Diagram =
    | { type: 'staff-note'; step: number }
    | { type: 'note-value'; value: 'whole' | 'half' | 'quarter' | 'eighth' | 'sixteenth'; dotted?: boolean }
    | { type: 'time-signature'; numerator: number; denominator: number }
    | { type: 'repeat' };
  type NotationQuestion = QuizQuestion & {
    diagram?: Diagram;
    musicXmlUrl: string;
    group: number;
  };
  type Pattern = {
    id: string;
    answer: string;
    options: string[];
    timeSignature: string;
    resolution: '1/8' | '1/16';
    steps: number;
    activeSteps: number[];
  };
  type QuestionBank = {
    basics: QuizQuestion[];
    fretboard: FretboardQuestion[];
    rhythm: QuizQuestion[];
    notation: NotationQuestion[];
    patterns: Pattern[];
  };
  type Difficulty = '1' | '2';

  function shuffle<T>(items: T[]): T[] {
    for (let index = items.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1));
      [items[index], items[swapIndex]] = [items[swapIndex], items[index]];
    }
    return items;
  }

  function renderNotationDiagram(diagram: Diagram, index: number): HTMLElement {
    const figure = document.createElement('figure');
    figure.className = 'notation-diagram';
    const options = { label: `Schaubild ${index + 1} zur Notationsfrage` };
    if (diagram.type === 'staff-note') {
      figure.innerHTML = renderNotationSvg({
        ...options,
        clef: 'treble',
        notes: [{ type: 'filled', step: diagram.step, stem: true }]
      });
    } else if (diagram.type === 'note-value') {
      figure.innerHTML = renderNotationSvg({
        ...options,
        clef: 'treble',
        notes: [{
          duration: diagram.value,
          step: 4,
          dotted: diagram.dotted
        }]
      });
    } else if (diagram.type === 'time-signature') {
      figure.innerHTML = renderNotationSvg({
        ...options,
        clef: 'treble',
        timeSignature: { numerator: diagram.numerator, denominator: diagram.denominator }
      });
    } else if (diagram.type === 'repeat') {
      figure.innerHTML = renderNotationSvg({
        ...options,
        clef: 'treble',
        repeatStart: true,
        repeatEnd: true
      });
    }
    return figure;
  }

