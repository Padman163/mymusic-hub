        "C5",
        ["B4", "D5"],
        { type: "staff-note", step: 5 },
      ),
      notationQuestion(
        "dotted-quarter",
        "Welcher Notenwert ist dargestellt?",
        "Punktierte Viertelnote",
        ["Viertelnote", "Punktierte halbe Note"],
        { type: "note-value", value: "quarter", dotted: true },
      ),
      notationQuestion(
        "dotted-half",
        "Welcher Notenwert ist dargestellt?",
        "Punktierte halbe Note",
        ["Halbe Note", "Ganze Note"],
        { type: "note-value", value: "half", dotted: true },
      ),
      notationQuestion(
        "sixteenth-note",
        "Welcher Notenwert ist mit zwei Balken dargestellt?",
        "Sechzehntelnote",
        ["Achtelnote", "Zweiunddreißigstelnote"],
        { type: "note-value", value: "sixteenth" },
      ),
      notationQuestion(
        "eighth-note",
