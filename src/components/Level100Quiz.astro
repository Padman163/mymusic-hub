import "../styles/notation.css";

interface Question {
  id: string;
  prompt: string;
  options: string[];
  answer: string;
}

interface FretboardQuestion extends Question {
  stringIndex: number;
  fret: number;
}

type NotationDiagram =
  | { type: "staff-note"; step: number }
  | {
      type: "note-value";
      value: "whole" | "half" | "quarter" | "eighth" | "sixteenth";
      dotted?: boolean;
    }
  | { type: "time-signature"; numerator: number; denominator: number }
  | { type: "repeat" };

interface NotationQuestion extends Question {
  diagram?: NotationDiagram;
  musicXmlUrl?: string;
  group?: number;
}

interface RhythmPattern {
  id: string;
  answer: string;
  options: string[];
  timeSignature: string;
  resolution: "1/8" | "1/16";
  steps: number;
  activeSteps: number[];
}

interface DifficultyBank {
  basics: Question[];
  fretboard: FretboardQuestion[];
  rhythm: Question[];
  notation: NotationQuestion[];
  patterns: RhythmPattern[];
}

const pitchNames = [
  "C",
  "C♯",
  "D",
  "D♯",
  "E",
  "F",
  "F♯",
  "G",
  "G♯",
  "A",
  "A♯",
  "B",
];
const openStringMidi = [64, 59, 55, 50, 45, 40];
const stringNames = ["hohen e", "B", "G", "D", "A", "tiefen E"];

function pitchLabel(midi: number): string {
  return `${pitchNames[midi % 12]}${Math.floor(midi / 12) - 1}`;
}

function createFretboardQuestion(
  stringIndex: number,
  fret: number,
): FretboardQuestion {
  const midi = openStringMidi[stringIndex] + fret;
  const answer = pitchLabel(midi);
  return {
    id: `${stringIndex}-${fret}`,
    stringIndex,
    fret,
    prompt: `Welche Note liegt auf der ${stringNames[stringIndex]}-Saite ${fret === 0 ? "leer" : `am ${fret}. Bund`}?`,
    options: [pitchLabel(midi - 1), pitchLabel(midi + 1), answer],
    answer,
  };
}

function question(
  id: string,
  prompt: string,
  answer: string,
  wrong: string[],
): Question {
  return { id, prompt, answer, options: [answer, ...wrong] };
}

function notationQuestion(
  id: string,
  prompt: string,
  answer: string,
  wrong: string[],
  diagram: NotationDiagram,
): NotationQuestion {
  return { ...question(id, prompt, answer, wrong), diagram };
}

function scoreQuestion(
  id: string,
  prompt: string,
  answer: string,
  wrong: string[],
  musicXmlUrl: string,
  group: number,
): NotationQuestion {
  return { ...question(id, prompt, answer, wrong), musicXmlUrl, group };
}

