---
import "../../styles/music.css";
import { type Dynamic, dynamicsForHairpin, type Hairpin } from "./dynamics.ts";

interface Props {
	type: Hairpin;
	initialDynamic?: Dynamic;
	placement?: "row" | "overlay";
}

const { type, initialDynamic, placement = "row" } = Astro.props;
const { showStart: showStartDynamic } = dynamicsForHairpin(
	type,
	initialDynamic,
);
const crescendo = type === "crescendo";
---

<div
  class:list={['dynamics-marks', `placement-${placement}`]}
  role="img"
  aria-label={crescendo
    ? showStartDynamic ? 'Crescendo von piano zu forte' : 'Crescendo bis forte'
    : showStartDynamic ? 'Decrescendo von forte zu piano' : 'Decrescendo bis piano'}
>
  <span class="dynamic-word">{crescendo ? 'cresc.' : 'decresc.'}</span>
  {showStartDynamic && <span class="dynamic-mark dynamic-start">{crescendo ? '\uE520' : '\uE522'}</span>}
  <span class="dynamic-mark dynamic-end">{crescendo ? '\uE522' : '\uE520'}</span>
  <svg class="hairpin" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
    {crescendo ? (
      <>
        <line x1="0" y1="6" x2="100" y2="0" />
        <line x1="0" y1="6" x2="100" y2="12" />
      </>
    ) : (
      <>
        <line x1="0" y1="0" x2="100" y2="6" />
        <line x1="0" y1="12" x2="100" y2="6" />
      </>
    )}
  </svg>
</div>
