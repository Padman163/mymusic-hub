---
import '../../styles/music.css';

interface Props {
  height: number;
}

const { height } = Astro.props;
---

<svg class="final-bar" width="8" height={height} viewBox={`0 0 8 ${height}`} aria-hidden="true">
  <rect x="0" y="0" width="1" height={height} />
  <rect x="4" y="0" width="4" height={height} />
</svg>
