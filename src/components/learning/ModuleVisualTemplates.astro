---
import DrumPattern from "../DrumPattern.astro";
import FretboardClickable from "../FretboardClickable.astro";
import NotationKeyboard from "../notation/NotationKeyboard.astro";
import ScalePattern from "../ScalePattern.astro";
---

{([true, false] as const).flatMap((showBrace) =>
  (["final", "single"] as const).map((rightBarStyle) => (
    <template data-visual-template="NotationKeyboard" data-show-brace={String(showBrace)} data-right-bar-style={rightBarStyle}>
      <NotationKeyboard showBrace={showBrace} rightBarStyle={rightBarStyle} />
    </template>
  )),
)}
<template data-visual-template="ScalePattern">
  <ScalePattern />
</template>
<template data-visual-template="FretboardClickable">
  <FretboardClickable readOnly showNoteNames />
</template>
<div hidden inert aria-hidden="true" data-visual-template="DrumPattern">
  <DrumPattern interactive={false} patternData={[]} />
</div>
