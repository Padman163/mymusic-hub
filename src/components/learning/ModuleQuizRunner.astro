---
import type { TargetLane } from "../../lib/module-schema";
import "../../styles/contribution-tags.css";
import "../../styles/module-player.css";
import "../../styles/notation.css";

interface Props {
  id?: string;
  moduleId?: string;
  mode?: TargetLane;
}

const {
  id = "module-quiz-runner",
  moduleId = "",
  mode = "mittel",
} = Astro.props;
---

<div
  id={id}
  class="learning-quiz-runner not-content"
  data-standalone-quiz-runner
  data-module-id={moduleId}
  data-mode={mode}
>
  <p class="learning-muted">Aufgaben-Runner wird vorbereitet …</p>
</div>

<script>
  import { attachStandaloneModuleQuizRunner } from "../../lib/module-player-ui";

  function initStandaloneQuizRunners() {
    document
      .querySelectorAll<HTMLElement>("[data-standalone-quiz-runner]")
      .forEach((root) => {
        void attachStandaloneModuleQuizRunner(root);
      });
  }

  initStandaloneQuizRunners();
  document.addEventListener("astro:page-load", initStandaloneQuizRunners);
</script>
