---
interface Props {
  show?: boolean;
}

const { show = true } = Astro.props;
---
<aside
  class="learning-account"
  data-learning-account
  aria-label="Lernkonto"
  hidden={!show}
>
  <div class="learning-account-heading">
    <strong>Lernkonto</strong>
    <p data-account-status role="status">
      Melde dich mit einem eingeladenen Konto an, damit dein Lernstand online
      gespeichert wird.
    </p>
  </div>
  <form data-login-form class="learning-account-form">
    <label>
      E-Mail-Adresse
      <input data-login-email type="email" autocomplete="username" required />
    </label>
    <label>
      Passwort
      <input
        data-login-password
        type="password"
        autocomplete="current-password"
        required
      />
    </label>
    <div class="learning-account-actions">
      <button data-login-submit type="submit">Anmelden</button>
      <button data-show-recovery type="button" class="learning-account-link">
        Passwort vergessen?
      </button>
    </div>
  </form>
  <form data-invite-form class="learning-account-form" hidden>
    <label>
      Neues Passwort
      <input
        data-invite-password
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      />
    </label>
    <button data-invite-submit type="submit">Einladung annehmen</button>
  </form>
  <form data-recovery-request-form class="learning-account-form" hidden>
    <label>
      E-Mail-Adresse
      <input data-recovery-email type="email" autocomplete="email" required />
    </label>
    <button data-recovery-submit type="submit">
      Wiederherstellungslink anfordern
    </button>
  </form>
  <form data-recovery-complete-form class="learning-account-form" hidden>
    <label>
      Neues Passwort
      <input
        data-recovery-password
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      />
    </label>
    <button data-recovery-complete-submit type="submit">
      Passwort speichern
    </button>
  </form>
  <div data-signed-in hidden>
    <p>Angemeldet als <strong data-user-email></strong></p>
    <div class="learning-account-actions">
      <button data-logout type="button">Abmelden</button>
      <button data-sync-retry type="button" hidden>Erneut synchronisieren</button>
    </div>
  </div>
</aside>

<script>
  import { attachLearningAccount } from "../../lib/learning-account-ui";

  function initLearningAccounts() {
    document
      .querySelectorAll<HTMLElement>("[data-learning-account]")
      .forEach((root) => attachLearningAccount(root));
  }

  initLearningAccounts();
  document.addEventListener("astro:page-load", initLearningAccounts);
</script>

<style>
  .learning-account[hidden],
  .learning-account [hidden] {
    display: none !important;
  }

  .learning-account {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
  }

  .learning-account-heading p,
  .learning-account p {
    margin: 0.25rem 0 0;
  }

  .learning-account-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
  }

  .learning-account-form label {
    display: grid;
    flex: 1 1 14rem;
    gap: 0.25rem;
  }

  .learning-account input {
    min-width: 0;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
  }

  .learning-account button {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    cursor: pointer;
  }

  .learning-account button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .learning-account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learning-account-link {
    border-color: transparent !important;
    text-decoration: underline;
  }

  .learning-account [data-account-status][data-state="error"] {
    color: var(--sl-color-red);
  }
</style>
