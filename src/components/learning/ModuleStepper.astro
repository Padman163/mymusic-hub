---
import "../../styles/contribution-tags.css";
import "../../styles/module-player.css";
import "../../styles/notation.css";
import FretboardClickable from "../FretboardClickable.astro";
import NotationKeyboard from "../notation/NotationKeyboard.astro";
import ScalePattern from "../ScalePattern.astro";

interface Props {
  id?: string;
  moduleId?: string;
  mode?: "normal" | "fastlane";
  lessonBaseUrl?: string;
}

const {
  id = "learning-module-stepper",
  moduleId = "",
  mode = "normal",
  lessonBaseUrl = "/audio/theory/modul/",
} = Astro.props;
---

<section
  id={id}
  class="learning-stepper not-content"
  aria-label="Geführte Lektion"
  data-learning-stepper
  data-module-id={moduleId}
  data-mode={mode}
  data-lesson-base-url={lessonBaseUrl}
>
  {([true, false] as const).flatMap((showBrace) =>
    (["final", "single"] as const).map((rightBarStyle) => (
      <template data-visual-template="NotationKeyboard" data-show-brace={String(showBrace)} data-right-bar-style={rightBarStyle}>
        <NotationKeyboard showBrace={showBrace} rightBarStyle={rightBarStyle} />
      </template>
    )),
  )}
  <template data-visual-template="ScalePattern">
    <ScalePattern />
  </template>
  <template data-visual-template="FretboardClickable">
    <FretboardClickable readOnly showNoteNames />
  </template>

  <div data-stepper-content>
    <p class="learning-muted">Lektion wird geladen …</p>
  </div>
</section>

<script>
  import { attachModuleStepper } from "../../lib/module-player-ui";

  function initModuleSteppers() {
    document
      .querySelectorAll<HTMLElement>("[data-learning-stepper]")
      .forEach((root) => {
        if (root.dataset.moduleStepperAttached !== "true") {
          attachModuleStepper(root, {
            lessonBaseUrl: root.dataset.lessonBaseUrl || undefined,
          });
        }
      });
  }

  initModuleSteppers();
  document.addEventListener("astro:page-load", initModuleSteppers);
</script>
