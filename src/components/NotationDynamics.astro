---
import NotationClickable from './NotationClickable.astro';
import '../styles/notation.css';

interface Props {
  type?: 'both' | 'crescendo' | 'decrescendo';
  embedded?: boolean;
  showStaff?: boolean;
  initialDynamic?: 'piano' | 'forte';
}

const { type = 'both', embedded = false, showStaff = true, initialDynamic } = Astro.props;
const examples = type === 'both' ? ['crescendo', 'decrescendo'] as const : [type] as const;
let currentDynamic = initialDynamic;
const dynamics = examples.map((example) => {
  const startDynamic = example === 'crescendo' ? 'piano' : 'forte';
  const endDynamic = example === 'crescendo' ? 'forte' : 'piano';
  const showStartDynamic = currentDynamic !== startDynamic;
  currentDynamic = endDynamic;
  return { example, showStartDynamic };
});
---

<div class:list={['dynamics-example', 'not-content', { embedded }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {dynamics.map(({ example, showStartDynamic }) => (
    <div
      class="dynamics-row"
      role="img"
      aria-label={example === 'crescendo'
        ? showStartDynamic ? 'Crescendo von piano zu forte' : 'Crescendo bis forte'
        : showStartDynamic ? 'Decrescendo von forte zu piano' : 'Decrescendo bis piano'}
    >
      {showStaff && (
        <NotationClickable
          embedded
          notes={[
            { duration: 'quarter', step: 5 },
            { duration: 'quarter', step: 4 },
            { duration: 'quarter', step: 3 },
            { duration: 'quarter', step: 4 }
          ]}
        />
      )}
      <span class="dynamic-word">{example === 'crescendo' ? 'cresc.' : 'decresc.'}</span>
      {showStartDynamic && <span class="dynamic-mark dynamic-start">{example === 'crescendo' ? '\uE520' : '\uE522'}</span>}
      <span class="dynamic-mark dynamic-end">{example === 'crescendo' ? '\uE522' : '\uE520'}</span>
      <svg class="hairpin" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
        {example === 'crescendo' ? (
          <>
            <line x1="0" y1="6" x2="100" y2="0" />
            <line x1="0" y1="6" x2="100" y2="12" />
          </>
        ) : (
          <>
            <line x1="0" y1="0" x2="100" y2="6" />
            <line x1="0" y1="12" x2="100" y2="6" />
          </>
        )}
      </svg>
    </div>
  ))}
</div>

<style>
  .dynamics-example {
    display: grid;
    gap: var(--notation-system-gap);
    padding: var(--notation-panel-padding);
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .dynamics-row {
    position: relative;
    min-width: 0;
    height: 108px;
    margin-bottom: calc(-1 * var(--notation-system-gap));
    --dynamics-staff-bottom: 64px;
  }

  .dynamic-word,
  .dynamic-mark,
  .hairpin {
    position: absolute;
    color: #111827;
  }

  .dynamic-word {
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-label-gap));
    left: calc(20% - 6px);
    font: italic 12px/1 Georgia, serif;
  }

  .dynamic-mark {
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-mark-gap));
    font: 30px/1 'NotationBravura';
  }

  .dynamic-start {
    right: calc(80% + 16px);
  }

  .dynamic-end {
    left: calc(80% + 16px);
  }

  .hairpin {
    left: calc(20% - 6px);
    top: calc(var(--dynamics-staff-bottom) + var(--notation-dynamics-hairpin-gap));
    width: calc(60% + 12px);
    height: 10px;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1;
  }

  .dynamics-example.embedded {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .dynamics-example.embedded .dynamics-row {
    height: 48px;
    margin-bottom: 0;
    --dynamics-staff-bottom: 0px;
  }

  .dynamics-example.embedded .dynamic-start {
    right: calc(80% + 10px);
  }

  .dynamics-example.embedded .dynamic-end {
    left: calc(80% + 10px);
  }

  .dynamics-example.embedded .dynamic-word {
    left: calc(20% - 6px);
  }
</style>