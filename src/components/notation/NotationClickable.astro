---
import {
  renderNotationSvg,
  type NotationAccidental,
  type NotationCurve,
  type NotationNote
} from '../../lib/notation-renderer';
import '../../styles/notation.css';
import NotationFinalBar from './NotationFinalBar.astro';
import NotationMeasureNumber from './NotationMeasureNumber.astro';
import NotationDynamicsMarks from './NotationDynamicsMarks.astro';

interface Props {
  showLeftBar?: boolean;
  showRightBar?: boolean;
  rightBarStyle?: 'single' | 'final';
  repeatStart?: boolean;
  repeatEnd?: boolean;
  clef?: 'treble' | 'bass' | false;
  notes?: NotationNote[];
  accidentals?: NotationAccidental[];
  timeSignature?: { numerator: number; denominator: number };
  curves?: NotationCurve[];
  measureNumber?: string | number;
  tempo?: string;
  ritAt?: number;
  aTempoAt?: number;
  hairpin?: 'crescendo' | 'decrescendo';
  initialDynamic?: 'piano' | 'forte';
  noteStart?: number;
  embedded?: boolean;
}

const {
  showLeftBar = false,
  showRightBar = true,
  rightBarStyle = 'single',
  repeatStart = false,
  repeatEnd = false,
  clef = 'treble',
  notes = [],
  accidentals = [],
  timeSignature,
  curves = [],
  measureNumber,
  tempo,
  ritAt,
  aTempoAt,
  hairpin,
  initialDynamic,
  noteStart = 0,
  embedded = false
} = Astro.props;

const notation = renderNotationSvg({
  clef: clef || undefined,
  notes,
  accidentals,
  timeSignature,
  noteStart,
  showLeftBar,
  showRightBar,
  rightBarStyle,
  repeatStart,
  repeatEnd,
  curves,
  ritAt,
  aTempoAt
});
---

<div class:list={['notation-clickable', 'not-content', { embedded, 'has-header': Boolean(tempo), 'has-measure-number': measureNumber !== undefined, 'has-hairpin': Boolean(hairpin) }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {measureNumber !== undefined && <NotationMeasureNumber value={measureNumber} embedded />}
  {tempo && (
    <div class="notation-header">
      <span class="tempo-label">{tempo}</span>
    </div>
  )}
  <Fragment set:html={notation} />
  {hairpin && <NotationDynamicsMarks type={hairpin} initialDynamic={initialDynamic} placement="clickable" />}
  {showRightBar && rightBarStyle === 'final' && (
    <div class="notation-final-bar"><NotationFinalBar height={36} /></div>
  )}
</div>
