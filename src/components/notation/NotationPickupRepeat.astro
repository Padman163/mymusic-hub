---
import { assertNoClefChanges } from "../../lib/notation-renderer";
import RepeatMark from "../ui/RepeatMark.astro";
import NotationVisual from "./NotationVisual.astro";

interface Props {
  showMeasureNumbers?: boolean;
}

const { showMeasureNumbers = false } = Astro.props;
const rows = [
  [
    {
      number: undefined,
      steps: [2],
      showClef: true,
      showTime: true,
      startRepeat: false,
      endRepeat: false,
      showRightBar: true,
      final: false,
    },
    {
      number: 1,
      steps: [3, 4, 5, 2],
      showClef: false,
      showTime: false,
      startRepeat: false,
      endRepeat: false,
      showRightBar: false,
      final: false,
    },
    {
      number: 2,
      steps: [5, 6, 5, 4],
      showClef: false,
      showTime: false,
      startRepeat: true,
      endRepeat: false,
      showRightBar: true,
      final: false,
    },
  ],
  [
    {
      number: 3,
      steps: [3, 2, 1, 2],
      showClef: true,
      showTime: false,
      startRepeat: false,
      endRepeat: true,
      showRightBar: false,
      final: false,
    },
    {
      number: 4,
      steps: [3, 2, 0],
      showClef: false,
      showTime: false,
      startRepeat: false,
      endRepeat: false,
      showRightBar: true,
      final: true,
    },
  ],
] as const;
assertNoClefChanges(
  rows.flatMap((row) =>
    row.map((measure) => (measure.showClef ? "treble" : false)),
  ),
  "NotationPickupRepeat",
);
---

<div class="pickup-example not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {rows.map((row) => (
    <div class="pickup-row">
    {row.map((measure) => (
      <div class="pickup-measure">
        <NotationVisual
          embedded
          measureNumber={showMeasureNumbers ? measure.number : undefined}
          clef={measure.showClef ? 'treble' : false}
          timeSignature={measure.showTime ? { numerator: 4, denominator: 4 } : undefined}
          layoutTimeSignature={{ numerator: 4, denominator: 4 }}
          noteStart={measure.showClef && !measure.showTime ? 36 : 0}
          showRightBar={measure.showRightBar}
          rightBarStyle={measure.final ? 'final' : 'single'}
          notes={measure.steps.map((step) => ({ duration: 'quarter' as const, step }))}
        />
        {measure.startRepeat && (
          <RepeatMark type="start" />
        )}
        {measure.endRepeat && (
          <RepeatMark type="end" />
        )}
      </div>
    ))}
    </div>
  ))}
</div>
