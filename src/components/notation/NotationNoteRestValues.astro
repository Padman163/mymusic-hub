---
import type { Duration } from "../../lib/rhythm.ts";
import NotationVisual from "./NotationVisual.astro";

const values: Duration[] = ["whole", "half", "quarter", "eighth", "sixteenth"];
---

<div class="notation-value-comparison not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div>
    <strong>Notenwerte</strong>
    <NotationVisual embedded spacing="equal" notes={values.map((duration) => ({ duration, step: 2 }))} />
  </div>
  <div>
    <strong>Pausenwerte</strong>
    <NotationVisual embedded spacing="equal" notes={values.map((duration) => ({ type: 'rest' as const, duration }))} />
  </div>
</div>
