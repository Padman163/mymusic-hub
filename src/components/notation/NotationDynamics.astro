---
import NotationVisual from './NotationVisual.astro';
import DynamicsMarks from '../music/DynamicsMarks.astro';
import { dynamicsForHairpin } from '../music/dynamics.ts';

interface Props {
  type?: 'both' | 'crescendo' | 'decrescendo';
  embedded?: boolean;
  showStaff?: boolean;
  initialDynamic?: 'piano' | 'forte';
}

const { type = 'both', embedded = false, showStaff = true, initialDynamic } = Astro.props;
const examples = type === 'both' ? ['crescendo', 'decrescendo'] as const : [type] as const;
let currentDynamic = initialDynamic;
const dynamics = examples.map((example) => {
  const exampleInitialDynamic = currentDynamic;
  currentDynamic = dynamicsForHairpin(example, currentDynamic).end;
  return { example, exampleInitialDynamic };
});
---

<div class:list={['dynamics-example', 'not-content', { embedded }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {dynamics.map(({ example, exampleInitialDynamic }) => (
    <div class="dynamics-row">
      {showStaff && (
        <NotationVisual
          embedded
          notes={[
            { duration: 'quarter', step: 5 },
            { duration: 'quarter', step: 4 },
            { duration: 'quarter', step: 3 },
            { duration: 'quarter', step: 4 }
          ]}
        />
      )}
      <DynamicsMarks type={example} initialDynamic={exampleInitialDynamic} />
    </div>
  ))}
</div>