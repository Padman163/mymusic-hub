---
import { sp } from "../../lib/notation-renderer.ts";
import FinalBar from "../ui/FinalBar.astro";
import NotationVisual from "./NotationVisual.astro";

interface Props {
  showBrace?: boolean;
  rightBarStyle?: "single" | "final";
}

const { showBrace = true, rightBarStyle = "final" } = Astro.props;
---

<div class="keyboard-notation not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {showBrace && (
    <svg class="keyboard-brace" viewBox="0 0 84 997" preserveAspectRatio="none" aria-hidden="true">
      <text x="0" y="997">{'\uE000'}</text>
    </svg>
  )}
  <div class="keyboard-staves">
    <NotationVisual embedded clef="treble" showRightBar={rightBarStyle === 'single'} notes={[{ type: 'filled', step: -2 }]} />
    <NotationVisual embedded clef="bass" showRightBar={rightBarStyle === 'single'} notes={[{ type: 'filled', step: 10 }]} />
    <svg class="keyboard-left-bar" width="1" height={sp(4) + 54} aria-hidden="true">
      <line x1="0.5" y1="0" x2="0.5" y2={sp(4) + 54} />
    </svg>
    {rightBarStyle === 'final' && <div class="keyboard-final-bar"><FinalBar height={sp(4) + 54} /></div>}
  </div>
</div>
