---
import {
  renderNotationSvg,
  type NotationAccidental,
  type NotationCurve,
  type NotationNote
} from '../../lib/notation-renderer';
import '../../styles/notation.css';
import FinalBar from '../music/FinalBar.astro';
import MeasureNumber from '../music/MeasureNumber.astro';
import DynamicsMarks from '../music/DynamicsMarks.astro';
import TempoLabel from '../music/TempoLabel.astro';
import type { TimeSignature } from '../music/time-signature.ts';

interface Props {
  showLeftBar?: boolean;
  showRightBar?: boolean;
  rightBarStyle?: 'single' | 'final';
  repeatStart?: boolean;
  repeatEnd?: boolean;
  clef?: 'treble' | 'bass' | false;
  notes?: NotationNote[];
  accidentals?: NotationAccidental[];
  timeSignature?: TimeSignature;
  curves?: NotationCurve[];
  measureNumber?: string | number;
  tempo?: string;
  ritAt?: number;
  aTempoAt?: number;
  hairpin?: 'crescendo' | 'decrescendo';
  initialDynamic?: 'piano' | 'forte';
  noteStart?: number;
  firstNoteX?: number;
  embedded?: boolean;
}

const {
  showLeftBar = false,
  showRightBar = true,
  rightBarStyle = 'single',
  repeatStart = false,
  repeatEnd = false,
  clef = 'treble',
  notes = [],
  accidentals = [],
  timeSignature,
  curves = [],
  measureNumber,
  tempo,
  ritAt,
  aTempoAt,
  hairpin,
  initialDynamic,
  noteStart = 0,
  firstNoteX,
  embedded = false
} = Astro.props;

const notation = renderNotationSvg({
  clef: clef || undefined,
  notes,
  accidentals,
  timeSignature,
  noteStart,
  firstNoteX,
  showLeftBar,
  showRightBar,
  rightBarStyle,
  repeatStart,
  repeatEnd,
  curves,
  ritAt,
  aTempoAt
});
---

<div class:list={['notation-visual', 'not-content', { embedded, 'has-header': Boolean(tempo), 'has-measure-number': measureNumber !== undefined, 'has-hairpin': Boolean(hairpin) }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {measureNumber !== undefined && <MeasureNumber value={measureNumber} embedded />}
  {tempo && (
    <div class="notation-header">
      <TempoLabel text={tempo} />
    </div>
  )}
  <Fragment set:html={notation} />
  {hairpin && <DynamicsMarks type={hairpin} initialDynamic={initialDynamic} placement="overlay" />}
  {showRightBar && rightBarStyle === 'final' && (
    <div class="notation-final-bar"><FinalBar height={36} /></div>
  )}
</div>
