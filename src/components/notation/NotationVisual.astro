---
import {
  type MeasureHairpin,
  measureNumberOffset,
  type NotationAccidental,
  type NotationCurve,
  type NotationEvent,
  renderNotationSvg,
  sp,
} from "../../lib/notation-renderer";
import "../../styles/notation.css";
import type { TimeSignature } from "../../lib/time-signature.ts";
import FinalBar from "../ui/FinalBar.astro";
import MeasureNumber from "../ui/MeasureNumber.astro";
import TempoLabel from "../ui/TempoLabel.astro";

interface Props {
  showLeftBar?: boolean;
  showRightBar?: boolean;
  rightBarStyle?: "single" | "final";
  repeatStart?: boolean;
  repeatEnd?: boolean;
  clef?: "treble" | "bass" | false;
  notes?: NotationEvent[];
  accidentals?: NotationAccidental[];
  timeSignature?: TimeSignature;
  layoutTimeSignature?: TimeSignature;
  curves?: NotationCurve[];
  measureNumber?: string | number;
  tempo?: string;
  tempoDetail?: string;
  ritAt?: number;
  aTempoAt?: number;
  hairpin?: MeasureHairpin;
  hairpins?: MeasureHairpin[];
  initialDynamic?: "piano" | "forte";
  noteStart?: number;
  firstNoteX?: number;
  embedded?: boolean;
}

const {
  showLeftBar = false,
  showRightBar = true,
  rightBarStyle = "single",
  repeatStart = false,
  repeatEnd = false,
  clef = "treble",
  notes = [],
  accidentals = [],
  timeSignature,
  layoutTimeSignature,
  curves = [],
  measureNumber,
  tempo,
  tempoDetail,
  ritAt,
  aTempoAt,
  hairpin,
  hairpins,
  noteStart = 0,
  firstNoteX,
  embedded = false,
} = Astro.props;

const hasDynamicsBelow =
  Boolean(hairpin) ||
  Boolean(hairpins && hairpins.length > 0) ||
  notes.some(
    (note) =>
      note.type !== "rest" &&
      Boolean(
        note.dynamic ||
          note.dynamicText ||
          note.hairpinStart ||
          note.hairpinEnd,
      ),
  );

const measureOffset = measureNumberOffset({
  clef: clef || undefined,
  timeSignature,
  accidentals,
  repeatStart,
});

const notation = renderNotationSvg({
  clef: clef || undefined,
  notes,
  accidentals,
  timeSignature,
  layoutTimeSignature,
  noteStart,
  firstNoteX,
  showLeftBar,
  showRightBar,
  rightBarStyle,
  repeatStart,
  repeatEnd,
  curves,
  hairpin,
  hairpins,
  ritAt,
  aTempoAt,
});
---

<div class:list={['notation-visual', 'not-content', { embedded, 'has-clef': Boolean(clef), 'has-header': Boolean(tempo), 'has-measure-number': measureNumber !== undefined, 'has-hairpin': hasDynamicsBelow }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {measureNumber !== undefined && <MeasureNumber value={measureNumber} embedded offsetPx={measureOffset} />}
  {tempo && (
    <div class="notation-header">
      <TempoLabel text={tempo} detail={tempoDetail} />
    </div>
  )}
  <div class="notation-staff-content">
    <Fragment set:html={notation} />
    {showRightBar && rightBarStyle === 'final' && !repeatEnd && (
      <div class="notation-final-bar"><FinalBar height={sp(4)} /></div>
    )}
  </div>
</div>
