---
import {
  type NotationAccidental,
  type NotationCurve,
  type NotationEvent,
  renderNotationSvg,
  sp,
} from "../../lib/notation-renderer";
import "../../styles/notation.css";
import type { TimeSignature } from "../../lib/time-signature.ts";
import DynamicsMarks from "../ui/DynamicsMarks.astro";
import FinalBar from "../ui/FinalBar.astro";
import MeasureNumber from "../ui/MeasureNumber.astro";
import TempoLabel from "../ui/TempoLabel.astro";

interface Props {
  showLeftBar?: boolean;
  showRightBar?: boolean;
  rightBarStyle?: "single" | "final";
  repeatStart?: boolean;
  repeatEnd?: boolean;
  clef?: "treble" | "bass" | false;
  notes?: NotationEvent[];
  accidentals?: NotationAccidental[];
  timeSignature?: TimeSignature;
  curves?: NotationCurve[];
  measureNumber?: string | number;
  tempo?: string;
  tempoDetail?: string;
  ritAt?: number;
  aTempoAt?: number;
  hairpin?: "crescendo" | "decrescendo";
  initialDynamic?: "piano" | "forte";
  noteStart?: number;
  firstNoteX?: number;
  embedded?: boolean;
}

const {
  showLeftBar = false,
  showRightBar = true,
  rightBarStyle = "single",
  repeatStart = false,
  repeatEnd = false,
  clef = "treble",
  notes = [],
  accidentals = [],
  timeSignature,
  curves = [],
  measureNumber,
  tempo,
  tempoDetail,
  ritAt,
  aTempoAt,
  hairpin,
  initialDynamic,
  noteStart = 0,
  firstNoteX,
  embedded = false,
} = Astro.props;

const notation = renderNotationSvg({
  clef: clef || undefined,
  notes,
  accidentals,
  timeSignature,
  noteStart,
  firstNoteX,
  showLeftBar,
  showRightBar,
  rightBarStyle,
  repeatStart,
  repeatEnd,
  curves,
  ritAt,
  aTempoAt,
});
---

<div class:list={['notation-visual', 'not-content', { embedded, 'has-header': Boolean(tempo), 'has-measure-number': measureNumber !== undefined, 'has-hairpin': Boolean(hairpin) }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {measureNumber !== undefined && <MeasureNumber value={measureNumber} embedded />}
  {tempo && (
    <div class="notation-header">
      <TempoLabel text={tempo} detail={tempoDetail} />
    </div>
  )}
  <div class="notation-staff-content">
    <Fragment set:html={notation} />
    {hairpin && <DynamicsMarks type={hairpin} initialDynamic={initialDynamic} placement="overlay" />}
    {showRightBar && rightBarStyle === 'final' && !repeatEnd && (
      <div class="notation-final-bar"><FinalBar height={sp(4)} /></div>
    )}
  </div>
</div>
