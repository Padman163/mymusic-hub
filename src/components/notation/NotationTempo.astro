---
import { assertNoClefChanges } from "../../lib/notation-renderer";
import TempoHeading from "../music/TempoHeading.astro";
import NotationVisual from "./NotationVisual.astro";

const clefs = ["treble", false] as const;
assertNoClefChanges(clefs, "NotationTempo");
---

<div class="tempo-example not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="tempo-row">
    <div class="tempo-measure">
      <TempoHeading text="Allegro" beatsPerMinute={90} />
      <NotationVisual
        embedded
        clef={clefs[0]}
        timeSignature={{ numerator: 4, denominator: 4 }}
        notes={[
          { duration: 'quarter', step: 0 },
          { duration: 'quarter', step: 1 },
          { duration: 'quarter', step: 2 },
          { duration: 'quarter', step: 3 }
        ]}
      />
    </div>
    <div class="tempo-measure">
      <NotationVisual
        embedded
        clef={clefs[1]}
        rightBarStyle="final"
        ritAt={0}
        aTempoAt={2}
        notes={[
          { duration: 'quarter', step: 2 },
          { duration: 'quarter', step: 3 },
          { duration: 'quarter', step: 4 },
          { duration: 'quarter', step: 5 }
        ]}
      />
    </div>
  </div>
</div>
