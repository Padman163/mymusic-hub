---
import NotationVisual from './NotationVisual.astro';
import { assertNoClefChanges } from '../../lib/notation-renderer';

const examples = [
  { duration: 'half', label: 'Punktierte halbe Note', value: '3 Viertelschläge' },
  { duration: 'quarter', label: 'Punktierte Viertelnote', value: '3 Achtelschläge' },
  { duration: 'eighth', label: 'Punktierte Achtelnote', value: '3 Sechzehntelschläge' }
] as const;
const clefs = examples.map((_, index) => index === 0 ? 'treble' as const : false);
assertNoClefChanges(clefs, 'NotationDottedNotes');
---

<div class="dotted-notes not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {examples.map(({ duration, label, value }, index) => (
    <div class="dotted-note-example">
      <NotationVisual
        embedded
        clef={clefs[index]}
        notes={[{ duration, step: 4, dotted: true }]}
      />
      <div class="dotted-note-label">
        <strong>{label}</strong>
        <span>{value}</span>
      </div>
    </div>
  ))}
</div>
