---
import type { ComponentProps } from "astro/types";
import { arrangeNotationSystems } from "../../lib/system-layout.ts";
import "../../styles/notation.css";
import NotationVisual from "./NotationVisual.astro";

interface Props {
  measures: Omit<
    ComponentProps<typeof NotationVisual>,
    "embedded" | "firstNoteX"
  >[];
  measuresPerRow?: number;
  fitToWidth?: boolean;
}

const { measures, measuresPerRow = 3, fitToWidth = false } = Astro.props;
const preparedMeasures = measures.map((measure, index) =>
  index === 0 && measure.clef === undefined
    ? { ...measure, clef: "treble" as const }
    : measure,
);
const systems = arrangeNotationSystems(preparedMeasures, measuresPerRow);
---

<div class="notation-system-box" data-fit-to-width={fitToWidth ? "" : undefined} style={`--notation-columns: ${measuresPerRow}`}>
  <div class="notation-system-grid">
    {systems.map((system) => (
      <div class="notation-system-row" style={`--notation-row-columns: ${system.length}`}>
        {system.map((measure) => <NotationVisual {...measure} embedded />)}
      </div>
    ))}
  </div>
</div>

<script>
  import { observeNotationFit } from "../../lib/notation-fit";
  observeNotationFit();
</script>
