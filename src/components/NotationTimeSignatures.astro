---
import NotationClickable from './NotationClickable.astro';

interface Props {
  timeSignatures: { numerator: number; denominator: number }[];
}

const { timeSignatures } = Astro.props;
---

<div class="time-signatures not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="time-signatures-row">
    {timeSignatures.map((timeSignature, index) => (
      <div class="time-signatures-measure">
        <NotationClickable embedded clef={index === 0 ? 'treble' : undefined} timeSignature={timeSignature} />
      </div>
    ))}
  </div>
</div>

<style>
  .time-signatures {
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .time-signatures-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(72px, 1fr));
  }

  .time-signatures-measure {
    min-width: 0;
  }

  .time-signatures-measure:first-child {
    grid-column: span 2;
  }
</style>
