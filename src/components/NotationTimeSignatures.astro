---
import NotationClickable from './NotationClickable.astro';
import { assertNoClefChanges } from '../lib/notation-renderer';

interface Props {
  timeSignatures: { numerator: number; denominator: number }[];
}

const { timeSignatures } = Astro.props;
const clefs = timeSignatures.map((_, index) => index === 0 ? 'treble' as const : false);
assertNoClefChanges(clefs, 'NotationTimeSignatures');
---

<div class="time-signatures not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="time-signatures-row">
    {timeSignatures.map((timeSignature, index) => (
      <div class="time-signatures-measure">
        <NotationClickable embedded clef={clefs[index]} timeSignature={timeSignature} />
      </div>
    ))}
  </div>
</div>

<style>
  .time-signatures {
    padding: var(--notation-panel-padding);
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .time-signatures-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(72px, 1fr));
    row-gap: var(--notation-system-gap);
  }

  .time-signatures-measure {
    min-width: 0;
  }

  .time-signatures-measure:first-child {
    grid-column: span 2;
  }
</style>
