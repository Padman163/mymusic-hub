---
interface Props {
  value: string;
  placement: 'rit' | 'return' | 'annotation';
}

const { value, placement } = Astro.props;
---

<span class:list={['notation-tempo-text', `placement-${placement}`]}>{value}</span>

<style>
  .notation-tempo-text {
    position: absolute;
    color: #111827;
    font: italic 14px/1.2 Georgia, serif;
  }

  .placement-rit,
  .placement-return {
    top: 43px;
    transform: translateX(-50%);
  }

  .placement-rit {
    left: 20%;
  }

  .placement-return {
    left: 60%;
  }

  .placement-annotation {
    top: -12px;
    right: 0;
    left: 0;
    text-align: center;
  }
</style>
