---
import {
  renderNotationSvg,
  type NotationAccidental,
  type NotationCurve,
  type NotationNote
} from '../lib/notation-renderer';
import '../styles/notation.css';
import NotationFinalBar from './NotationFinalBar.astro';
import NotationMeasureNumber from './NotationMeasureNumber.astro';
import NotationDynamicsMarks from './NotationDynamicsMarks.astro';

interface Props {
  showLeftBar?: boolean;
  showRightBar?: boolean;
  rightBarStyle?: 'single' | 'final';
  repeatStart?: boolean;
  repeatEnd?: boolean;
  clef?: 'treble' | 'bass' | false;
  notes?: NotationNote[];
  accidentals?: NotationAccidental[];
  timeSignature?: { numerator: number; denominator: number };
  curves?: NotationCurve[];
  measureNumber?: string | number;
  tempo?: string;
  ritAt?: number;
  aTempoAt?: number;
  hairpin?: 'crescendo' | 'decrescendo';
  initialDynamic?: 'piano' | 'forte';
  noteStart?: number;
  embedded?: boolean;
}

const {
  showLeftBar = false,
  showRightBar = true,
  rightBarStyle = 'single',
  repeatStart = false,
  repeatEnd = false,
  clef = 'treble',
  notes = [],
  accidentals = [],
  timeSignature,
  curves = [],
  measureNumber,
  tempo,
  ritAt,
  aTempoAt,
  hairpin,
  initialDynamic,
  noteStart = 0,
  embedded = false
} = Astro.props;

const notation = renderNotationSvg({
  clef: clef || undefined,
  notes,
  accidentals,
  timeSignature,
  noteStart,
  showLeftBar,
  showRightBar,
  rightBarStyle,
  repeatStart,
  repeatEnd,
  curves,
  ritAt,
  aTempoAt
});
---

<div class:list={['notation-clickable', 'not-content', { embedded, 'has-header': Boolean(tempo), 'has-measure-number': measureNumber !== undefined, 'has-hairpin': Boolean(hairpin) }]} data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  {measureNumber !== undefined && <NotationMeasureNumber value={measureNumber} embedded />}
  {tempo && (
    <div class="notation-header">
      <span class="tempo-label">{tempo}</span>
    </div>
  )}
  <Fragment set:html={notation} />
  {hairpin && <NotationDynamicsMarks type={hairpin} initialDynamic={initialDynamic} placement="clickable" />}
  {showRightBar && rightBarStyle === 'final' && (
    <div class="notation-final-bar"><NotationFinalBar height={36} /></div>
  )}
</div>

<style>
  .notation-clickable {
    position: relative;
    padding: var(--notation-panel-padding);
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .notation-clickable.has-hairpin {
    --notation-dynamics-top: calc(var(--notation-panel-padding) + 64px);
    padding-bottom: 32px;
  }

  .notation-clickable.has-hairpin.has-header {
    --notation-dynamics-top: calc(var(--notation-panel-padding) + 24px + 64px);
  }

  .notation-clickable.has-header .notation-header {
    height: 24px;
  }

  .notation-header {
    position: relative;
    height: 24px;
    color: #111827;
    font: 10px/1.2 Georgia, serif;
  }

  .tempo-label {
    display: block;
    text-align: center;
  }

  .notation-clickable.has-measure-number .tempo-label {
    position: absolute;
    top: 12px;
    right: 0;
    left: 0;
    font-size: 9px;
  }

  .notation-final-bar {
    position: absolute;
    right: var(--notation-panel-padding);
    top: calc(var(--notation-panel-padding) + 28px);
  }

  .notation-clickable.has-header:not(.embedded) .notation-final-bar {
    top: calc(var(--notation-panel-padding) + 52px);
  }

  :global(.notation-staff) {
    display: block;
    width: 100%;
    height: 92px;
    overflow: visible;
    stroke: #111827;
    stroke-width: 1;
    color: #111827;
  }

  :global(.notation-clef),
  :global(.notation-note),
  :global(.notation-accidental),
  :global(.notation-time),
  :global(.notation-articulation) {
    font-family: 'NotationBravura';
    font-size: 36px;
    fill: #111827;
    stroke: none;
  }

  :global(.notation-tempo) {
    font: italic 14px Georgia, serif;
    fill: #111827;
    stroke: none;
  }

  :global(.notation-curve) {
    fill: #111827;
    stroke: none;
  }

  .notation-clickable.embedded {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .notation-clickable.embedded.has-hairpin {
    --notation-dynamics-top: 64px;
    padding-bottom: 32px;
  }

  .notation-clickable.embedded .notation-final-bar {
    right: 0;
    top: 28px;
  }

  .notation-clickable.embedded.has-header .notation-final-bar {
    top: 52px;
  }

</style>
