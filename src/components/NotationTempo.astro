---
import NotationClickable from './NotationClickable.astro';
---

<div class="tempo-example not-content" data-tags={JSON.stringify(['Allgemein', 'Notensystem'])}>
  <div class="tempo-row">
    <div class="tempo-measure">
      <div class="tempo-heading"><strong>Allegro</strong><br /><span aria-label="Viertelnote gleich 90"><span class="metronome-note" aria-hidden="true">{'\uECA5'}</span> = 90</span></div>
      <NotationClickable
        embedded
        clef="treble"
        timeSignature={{ numerator: 4, denominator: 4 }}
        notes={[
          { duration: 'quarter', step: 0 },
          { duration: 'quarter', step: 1 },
          { duration: 'quarter', step: 2 },
          { duration: 'quarter', step: 3 }
        ]}
      />
    </div>
    <div class="tempo-measure">
      <NotationClickable
        embedded
        clef={false}
        rightBarStyle="final"
        ritAt={0}
        aTempoAt={2}
        notes={[
          { duration: 'quarter', step: 2 },
          { duration: 'quarter', step: 3 },
          { duration: 'quarter', step: 4 },
          { duration: 'quarter', step: 5 }
        ]}
      />
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: 'NotationTempoBravura';
    src: url('/alphatab/font/Bravura.woff2') format('woff2');
  }

  .tempo-example {
    padding: var(--notation-panel-padding);
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
    box-sizing: border-box;
  }

  .tempo-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .tempo-measure {
    position: relative;
    min-width: 0;
    padding-top: 40px;
    color: #111827;
  }

  .tempo-heading {
    position: absolute;
    font: 14px/1.2 Georgia, serif;
  }

  .tempo-heading {
    top: 0;
    left: 6px;
  }

  .metronome-note {
    font: 24px/1 'NotationTempoBravura';
    vertical-align: -0.2em;
  }

</style>
