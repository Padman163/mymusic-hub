---
// Display and manage feature cards from todo-cards.json
import FeatureCard from './FeatureCard.astro';
import todoCardsData from '../data/todo-cards.json';

interface Props {
  showForm?: boolean;
}

const { showForm = true } = Astro.props;
const cards = todoCardsData.cards;
---

<div class="feature-cards-container">
  {showForm && <div id="card-form-container" class="form-container">
    <!-- Form wird hier eingefügt -->
  </div>}

  <div class="cards-list">
    <h2>Feature Cards ({cards.length})</h2>
    
    {cards.length === 0 ? (
      <p class="empty-state">Keine Cards vorhanden. Erstelle die erste mit dem Formular oben!</p>
    ) : (
      <div class="cards-grid">
        {cards.map((card) => (
          <FeatureCard
            id={card.id}
            title={card.title}
            status={card.status}
            category={card.category}
            difficulty={card.difficulty}
            tags={card.tags}
            comments={card.comments}
          >
            {card.description && (
              <div class="description">
                <strong>Beschreibung:</strong>
                <p set:html={card.description.replace(/\n/g, '<br />')} />
              </div>
            )}
            
            {card.tasks && card.tasks.length > 0 && (
              <div class="tasks">
                <strong>Teilaufgaben:</strong>
                <ul>
                  {card.tasks.map((task) => (
                    <li>
                      <input type="checkbox" checked={task.completed} disabled />
                      {task.text}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="meta">
              <small>erstellt: {new Date(card.createdAt).toLocaleDateString('de-DE')}</small>
            </div>
          </FeatureCard>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .feature-cards-container {
    display: grid;
    gap: 2rem;
  }

  .form-container {
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-alt);
  }

  .cards-list h2 {
    margin-bottom: 1rem;
  }

  .empty-state {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .cards-grid {
    display: grid;
    gap: 1.5rem;
  }

  .description {
    margin: 1rem 0;
    padding: 0.75rem;
    background: var(--sl-color-bg);
    border-left: 3px solid var(--sl-color-accent);
    border-radius: 0.3rem;
  }

  .description p {
    margin: 0;
  }

  .tasks {
    margin: 1rem 0;
  }

  .tasks ul {
    margin: 0.5rem 0 0 1.5rem;
    list-style: none;
    padding-left: 0;
  }

  .tasks li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0;
  }

  .tasks input[type="checkbox"] {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .meta {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
</style>
