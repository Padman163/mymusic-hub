---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import archive from "../../../../module-archives/index.json";
import ModuleArchiveLesson from "../../../components/learning/ModuleArchiveLesson.astro";
import type { ArchivedModule, ArchiveLesson } from "../../../lib/module-archive";

export function getStaticPaths() {
  return archive.modules.flatMap((module) => module.lessons.map((lesson, position) => ({
    params: { moduleId: module.directory, lesson: lesson.slug },
    props: { module, lesson, position },
  })));
}

interface Props {
  module: ArchivedModule;
  lesson: ArchiveLesson;
  position: number;
}
const { module, lesson, position } = Astro.props;
const sources = import.meta.glob<string>("../../../../module-archives/**/*.mdx", {
  query: "?raw", import: "default", eager: true,
});
const source = sources[`../../../../module-archives/${lesson.source}`];
if (source === undefined) throw new Error(`Archivdatei fehlt: ${lesson.source}`);
const previous = module.lessons[position - 1];
const next = module.lessons[position + 1];
const link = (slug: string) => `/module-archives/${encodeURIComponent(module.directory)}/${slug}/`;
---

<StarlightPage frontmatter={{ title: lesson.title, description: module.title, tableOfContents: false, editUrl: false }}>
  <p><a href="/module-archives/">← Alle Module</a> · {module.title}</p>
  {!module.present && <p><strong>Letzter Archivstand; dieses Modul ist nicht mehr im Builder vorhanden.</strong></p>}
  <ModuleArchiveLesson source={source} visuals={lesson.visuals} />
  <nav aria-label="Archivseiten">
    {previous && <a href={link(previous.slug)}>← {previous.title}</a>}
    {next && <a href={link(next.slug)}>{next.title} →</a>}
  </nav>
</StarlightPage>

<style>
  nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
</style>
