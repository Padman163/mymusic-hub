import AdminIdentityPanel from "../../components/admin/AdminIdentityPanel.astro";
import LearningAccount from "../../components/learning/LearningAccount.astro";
---

<StarlightPage
  frontmatter={{
    title: "Konten & Einladungen",
    description: "Registrierungsstatus anzeigen und Konten einladen.",
    tableOfContents: false,
    editUrl: false,
  }}
>
  <LearningAccount show={true} />
