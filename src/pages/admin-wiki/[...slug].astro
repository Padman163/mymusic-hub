---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { adminWikiDocuments, renderAdminWikiDocument } from "../../lib/admin-wiki";

export async function getStaticPaths() {
  return Promise.all(adminWikiDocuments.map(async (document) => ({
    params: { slug: document.slug },
    props: { document, rendered: await renderAdminWikiDocument(document) },
  })));
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];
const { document, rendered } = Astro.props;
---

<StarlightPage frontmatter={{ title: document.title, description: `Entwicklerdokumentation aus ${document.sourcePath}`, tableOfContents: false, editUrl: false }}>
  <p><a href="/admin-wiki/">← Admin-Wiki</a> · Quelle: <code>{document.sourcePath}</code></p>
  <Fragment set:html={rendered.code} />
</StarlightPage>
